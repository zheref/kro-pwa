# Copy to .env.local (Next.js reads it automatically) and fill in real values.
#   cp .env.example apps/web/.env.local
#
# Nothing here is a secret — these are placeholders. Never commit a filled-in copy.

# --- NextAuth (Google sign-in) -------------------------------------------------
# Google OAuth client from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The redirect URI registered on that OAuth client.
NEXT_PUBLIC_GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback/google
# Public origin of this deployment, and the secret NextAuth signs sessions with
# (generate with: openssl rand -base64 32).
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# --- Web Push (PWA notifications) ----------------------------------------------
# VAPID key pair (generate with: npx web-push generate-vapid-keys).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
