# Copy to .env.local (Next.js reads it automatically) and fill in real values.
#   cp .env.example apps/web/.env.local
#
# Nothing here is a secret — these are placeholders. Never commit a filled-in copy.

# --- Kro Cloud (Supabase) — sign-in and sync -----------------------------------
# Both are public by design: the URL is a hostname and the publishable key's
# authority is whatever Row Level Security grants an anonymous caller. The
# service-role key is a secret and must never appear in any NEXT_PUBLIC_ variable.
#
# Find both under Project Settings → API in the Supabase dashboard. Newer
# projects hand out an `sb_publishable_…` key; older ones a JWT-shaped "anon"
# key, which may be set under the legacy name NEXT_PUBLIC_SUPABASE_ANON_KEY
# instead. With either missing, sign-in reports itself unavailable and the app
# runs local-only — a supported state, not a failure.
#
# "Continue with Google" / "Continue with Apple" are Supabase Auth providers,
# configured in the Supabase dashboard (Authentication → Providers), with this
# app's origin(s) added under Authentication → URL Configuration → Redirect
# URLs. Next.js reads .env.local at startup: restart `make dev` after editing.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<publishable-key-from-project-settings-api>

# --- Google Calendar integration (KC-IS-#33) -----------------------------------
# Kro runs TWO Google OAuth clients, and only one of them is configured here:
#
#   * Sign-in ("Continue with Google") is Supabase's — configured in the
#     Supabase dashboard, not in this file. NextAuth is gone (KC-IS-#31).
#   * The CALENDAR client below is this repo's: an authorization-code flow with
#     a refresh token held server-side, carrying the `calendar` scope.
#
# Create it at https://console.cloud.google.com/apis/credentials as an OAuth
# client of type "Web application", enable the Google Calendar API, and register
# the callback below as an authorised redirect URI.
#
# With any of the three required values missing the integration reports itself
# `unconfigured` and the rest of the app runs normally — that is a supported
# state, not a failure.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Encrypts the refresh-token cookie (AES-GCM). Generate with:
#   openssl rand -base64 32
# Rotating it logs every user out of Google Calendar — they simply reconnect.
GOOGLE_CALENDAR_TOKEN_KEY=
# OPTIONAL. Leave blank to derive `<request origin>/api/google/callback`, which
# is what a preview deployment wants. Set it when the public origin differs from
# the origin the browser reaches (a proxy, a custom domain) — Google matches the
# registered value byte for byte.
GOOGLE_CALENDAR_REDIRECT_URI=

# --- Web Push (PWA notifications) ----------------------------------------------
# VAPID key pair (generate with: npx web-push generate-vapid-keys).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --- Hosts: the apex landing and the hub app ------------------------------------
# One deployment answers on two hosts. The apex serves the marketing landing at
# `/`; the hub is the app's canonical host. The middleware sends kroapp.com/hub/*
# and any app path hit on the apex (/my-day, /plan, /settings, /integrations …)
# to the same path on the hub (307, query kept), rewrites the hub's `/` to
# `/my-day`, and marks the hub `X-Robots-Tag: noindex, nofollow`.
#
# These are NEXT_PUBLIC_ values: Next inlines them at BUILD time, so set them in
# the build environment of the production deployment and rebuild to change one.
# Leave BOTH blank for local dev and previews: with either missing no host
# redirects happen at all — `/` is the landing, app paths work directly, and
# `/hub/<path>` redirects to `/<path>` on the same host.
NEXT_PUBLIC_SITE_HOST=
NEXT_PUBLIC_HUB_HOST=
# The public origin, e.g. https://<apex-host>. Used for `metadataBase`, the
# sitemap and robots.txt. Blank → http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# --- Landing analytics (Umami) ---------------------------------------------------
# OPTIONAL. With the website id blank no analytics script loads at all. The
# script runs with auto-tracking OFF; the landing reports counts and timings
# through its own Analytics Service — never the words anyone writes.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
# OPTIONAL. A self-hosted Umami script; blank → Umami Cloud's script. Must be an
# https URL: anything else turns analytics off rather than loading a script from
# an unchecked origin. The tag never sends query strings and honours Do Not Track.
# Events go to the tracker's collect origin — gateway.umami.is for Umami Cloud, the
# script's own origin for a self-hosted instance — which the tag names in
# data-host-url and the landing's Content-Security-Policy admits, and nothing else.
NEXT_PUBLIC_UMAMI_SCRIPT_URL=

# --- Landing early access --------------------------------------------------------
# OPTIONAL, server-only. A POST endpoint (Zapier, Make, or your own) that
# receives one JSON object per sign-up:
#   {"email": "...", "platform": "...", "source": "...", "locale": "...", "joined_at": "<ISO8601>"}
# A 409 response means "already joined"; the visitor then sees the same success
# answer as a new sign-up, so the route never reveals membership; the webhook's
# own id and queue position never reach the visitor either — every join answers
# a generated receipt, so a repeat and a first sign-up look the same. Any other 4xx
# is read as a misconfigured webhook and the visitor sees a generic error. The
# URL must be https — anything else, or blank, makes the form report itself
# unavailable; the call times out after 5 s and follows no redirect.
EARLY_ACCESS_WEBHOOK_URL=
# OPTIONAL. Sent as `Authorization: Bearer <token>` when set.
EARLY_ACCESS_WEBHOOK_TOKEN=
# REQUIRED for sign-ups to open: a private address a visitor can write to for
# removal — never the repository. The notice under the field shows it, and the
# route binds the webhook only when it is set: no collection without a removal
# channel. Inlined at
# build time (a NEXT_PUBLIC_ value), so adding it needs a rebuild; the webhook
# values above are read per request. The site host, hub host and site URL above
# also name the public origins allowed to post to /api/early-access, which is
# what keeps a TLS-terminating proxy from refusing real sign-ups.
NEXT_PUBLIC_CONTACT_EMAIL=
