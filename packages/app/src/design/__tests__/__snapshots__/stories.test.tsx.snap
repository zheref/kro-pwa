exports[`story snapshots > KroGlass > Gallery 1`] = `"<div><div data-slot="story-gallery" style="display: flex; flex-direction: column; gap: var(--kro-space-large);"><div data-theme="light" style="position: relative; min-height: 420px; padding: var(--kro-space-large); background: linear-gradient(120deg, var(--kro-color-header-gradient-indigo) 0%, var(--kro-color-header-gradient-grape) 40%, var(--kro-color-badge-red) 70%, var(--kro-color-badge-orange) 100%); font-family: system-ui, sans-serif; overflow: hidden;"><p style="position: absolute; inset: 24px; margin: 0px; font-size: 34px; font-weight: 700; line-height: 1.2; color: rgba(255, 255, 255, 0.55);">Plan · Do · Earn · Find. Plan · Do · Earn · Find. Plan · Do · Earn · Find. Plan · Do · Earn · Find.</p><div style="position: relative;"><div class="kro-glass" style="max-width: 380px;"><div style="padding: var(--kro-space-large);"><h3 style="margin: 0px; font-size: 17px; color: var(--kro-color-fore);">Write the KroTokens port</h3><p style="margin: 6px 0px 0px; font-size: 14px; color: var(--kro-color-fore-secondary);">Due today · 25 minutes</p></div></div></div></div><div data-theme="light" style="position: relative; min-height: 240px; padding: var(--kro-space-large); background: linear-gradient(120deg, var(--kro-color-header-gradient-indigo) 0%, var(--kro-color-header-gradient-grape) 40%, var(--kro-color-badge-red) 70%, var(--kro-color-badge-orange) 100%); font-family: system-ui, sans-serif; overflow: hidden;"><p style="position: absolute; inset: 24px; margin: 0px; font-size: 34px; font-weight: 700; line-height: 1.2; color: rgba(255, 255, 255, 0.55);">Plan · Do · Earn · Find. Plan · Do · Earn · Find. Plan · Do · Earn · Find. Plan · Do · Earn · Find.</p><div style="position: relative;"><div style="display: flex; gap: var(--kro-space-small); flex-wrap: wrap;"><button class="kro-glass kro-glass--control kro-glass--accent kro-glass--interactive" style="padding: 0px 16px; height: 24px; font-size: 12px; font-weight: 600;">S