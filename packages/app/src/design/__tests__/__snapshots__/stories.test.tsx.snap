exports[`story snapshots > Tokens > AccentTheming 1`] = `"<div><div style="display: flex; min-height: 100vh;"><div data-theme="light" style="background: var(--kro-color-back); color: var(--kro-color-fore); padding: var(--kro-space-large); min-height: 100%; flex: 1 1 0%; font-family: system-ui, sans-serif;"><h2 style="margin-bottom: var(--kro-space-medium); font-size: 13px; text-transform: uppercase; letter-spacing: 0.08em; color: var(--kro-color-fore-secondary);">light</h2><div style="display: grid; gap: var(--kro-space-medium);"><p style="font-size: 13px; margin: 0px; max-width: 46ch;">A user accent is written together with the label colour that reads on it. Choosing the better of black and white can never do worse than 4.58:1 on an opaque fill, so a re-tint cannot make a primary button unreadable.</p><div style="--kro-color-accent: #5e6472; --kro-color-on-accent: #ffffff;"><span style="display: inline-flex; align-items: center; height: 44px; padding: 0px 20px; border-radius: var(--kro-radius-pill); background: var(--kro-color-accent); color: var(--kro-color-on-accent); font-weight: 600; font-size: 14px;">Start session · #5e6472 · 5.93:1</span></div><div style="--kro-color-accent: #663399; --kro-color-on-accent: #ffffff;"><span style="display: inline-flex; align-items: center; height: 44px; padding: 0px 20px; border-radius: var(--kro-radius-pill); background: var(--kro-color-accent); color: var(--kro-color-on-accent); font-weight: 600; font-size: 14px;">Start session · #663399 · 8.41:1</span></div><div style="--kro-color-accent: #b0b9d4; --kro-color-on-accent: #000000;"><span style="display: inline-flex; align-items: center; height: 44px; padding: 0px 20px; border-radius: var(--kro-radius-pill); background: var(--kro-color-accent); color: var(--kro-color-on-accent); font-weight: 600; font-size: 14px;">Start session · #b0b9d4 · 10.74:1</span></div><div style="--kro-color-accent: #c78c00; --kro-color-on-accent: #000000;"><span style="display: inline-flex; align-items: center; height: 44px; padding: 0px 20px; border-radius: var(--kro-radius-pill); background: var(--kro-color-accent); color: var(--kro-color-on-accent); font-weight: 600; font-size: 14px;">Start session · #c78c00 · 7.18:1</span></div></div></div><div data-theme="dark" style="background: var(--kro-color-back); color: var(--kro-color-fore); padding: var(--kro-space-large); min-height: 100%; flex: 1 1 0%; font-family: system-ui, sans-serif;"><h2 style="margin-bottom: var(--kro-space-medium); font-size: 13px; text-transform: uppercase; letter-spacing: 0.08em; color: var(--kro-color-fore-secondary);">dark</h2><div style="display: grid; gap: var(--kro-space-medium);"><p style="font-size: 13px; margin: 0px; max-width: 46ch;">A user accent is written together with the label colour that reads on it. Choosing the better of black and white can never do worse than 4.58:1 on an opaque fill, so a re-tint cannot make a primary button unreadable.</p><div style="--kro-color-accent: #5e6472; --kro-color-on-accent: #ffffff;"><span style="display: inline-flex; align-items: center; height: 44px; padding: 0px 20px; border-radius: var(--kro-radius-pill); background: var(--kro-color-accent); color: var(--kro-color-on-accent); font-weight: 600; font-size: 14px;">Start session · #5e6472 · 5.93:1</span></div><div style="--kro-color-accent: #663399; --kro-color-on-accent: #ffffff;"><span style="display: inline-flex; align-items: center; height: 44px; padding: 0px 20px; border-radius: var(--kro-radius-pill); background: var(--kro-color-accent); color: var(--kro-color-on-accent); font-weight: 600; font-size: 14px;">Start session · #663399 · 8.41:1</span></div><div style="--kro-color-accent: #b0b9d4; --kro-color-on-accent: #000000;"><span style="display: inline-flex; align-items: center; height: 44px; padding: 0px 20px; border-radius: var(--kro-radius-pill); background: var(--kro-color-accent); color: var(--kro-color-on-accent); font-weight: 600; font-size: 14px;">Start session · #b0b9d4 · 10.74:1</span></div><div style="--kro-color-accent: #c78c00; --kro-color-on-accent: #000000;"><span style="display: inline-flex; align-items: center; height: 44px; padding: 0px 20px; border-radius: var(--kro-radius-pill); background: var(--kro-color-accent); color: var(--kro-color-on-accent); font-weight: 600; font-size: 14px;">Start session · #c78c00 · 7.18:1</span></div></div></div></div></div>"`;

exports[`story snapshots > Tokens > Elevation 1`] = `"<div><div style="display: flex; min-height: 100vh;"><div data-theme="light" style="background: var(--kro-color-back); color: var(--kro-color-fore); padding: var(--kro-space-large); min-height: 100%; flex: 1 1 0%; font-family: system-ui, sans-serif;"><h2 style="margin-bottom: var(--kro-space-medium); font-size: 13px; text-transform: uppercase; letter-spacing: 0.08em; color: var(--kro-color-fore-secondary);">light</h2><div style="display: flex; gap: var(--kro-space-large); flex-wrap: wrap;"><div style="width: 180px; height: 110px; display: grid; place-items: center; background: var(--kro-color-absolute); border-radius: var(--kro-radius-surface); box-shadow: var(--kro-shadow-subtle); font-size: 13px;">subtle</div><div style="width: 180px; height: 110px; display: grid; place-items: center; background: var(--kro-color-absolute); border-radius: var(--kro-radius-surface); box-shadow: var(--kro-shadow-card); font-size: 13px;">card</div><div style="width: 180px; height: 110px; display: grid; place-items: center; background: var(--kro-color-absolute); border-radius: var(--kro-radius-surface); box-shadow: var(--kro-shadow-surface); font-size: 13px;">surface</div></div></div><div data-theme="dark" style="background: var(--kro-color-back); color: var(--kro-color-fore); padding: var(--kro-space-large); min-height: 100%; flex: 1 1 0%; font-family: system-ui, sans-serif;"><h2 style="margin-bottom: var(--kro-space-medium); font-size: 13px; text-transform: uppercase; letter-spacing: 0.08em; color: var(--kro-color-fore-secondary);">dark</h2><div style="display: flex; gap: var(--kro-space-large); flex-wrap: wrap;"><div style="width: 180px; height: 110px; display: grid; place-items: center; background: var(--kro-color-absolute); border-radius: var(--kro-radius-surface); box-shadow: var(--kro-shadow-subtle); font-size: 13px;">subtle</div><div style="width: 180px; height: 110px; display: grid; place-items: center; background: var(--kro