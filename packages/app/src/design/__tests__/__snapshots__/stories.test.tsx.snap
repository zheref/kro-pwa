/h3><p style="margin: 6px 0px 0px; font-size: 14px; color: var(--kro-color-fore-secondary);">Due today · 25 minutes</p></div></div></div></div><div data-theme="dark" style="position: relative; min-height: 320px; padding: var(--kro-space-large); background: linear-gradient(120deg, var(--kro-color-header-gradient-indigo) 0%, var(--kro-color-header-gradient-grape) 40%, var(--kro-color-badge-red) 70%, var(--kro-color-badge-orange) 100%); font-family: system-ui, sans-serif; overflow: hidden;"><p style="position: absolute; inset: 24px; margin: 0px; font-size: 34px; font-weight: 700; line-height: 1.2; color: rgba(255, 255, 255, 0.55);">Plan · Do · Earn · Find. Plan · Do · Earn · Find. Plan · Do · Earn · Find. Plan · Do · Earn · Find.</p><div style="position: relative;"><div class="kro-glass"><div style="padding: var(--kro-space-large);"><h3 style="margin: 0px; font-size: 17px; color: var(--kro-color-fore);">Write the KroTokens port</h3><p style="margin: 6px 0px 0px; font-size: 14px; color: var(--kro-color-fore-secondary);">Due today · 25 minutes</p></div></div></div></div></div><div data-theme="light" style="position: relative; min-height: 480px; padding: var(--kro-space-large); background: linear-gradient(120deg, var(--kro-color-header-gradient-indigo) 0%, var(--kro-color-header-gradient-grape) 40%, var(--kro-color-badge-red) 70%, var(--kro-color-badge-orange) 100%); font-family: system-ui, sans-serif; overflow: hidden;"><p style="position: absolute; inset: 24px; margin: 0px; font-size: 34px; font-weight: 700; line-height: 1.2; color: rgba(255, 255, 255, 0.55);">Plan · Do · Earn · Find. Plan · Do · Earn · Find. Plan · Do · Earn · Find. Plan · Do · Earn · Find.</p><div style="position: relative;"><nav class="kro-glass kro-glass--sidebar" style="width: 220px; min-height: 360px; padding: 12px;"><p style="margin: 0px; font-weight: 600; color: var(--kro-color-fore);">Kro</p><p style="margin: 12px 0px 0px; color: var(--kro-color-fore);">Today</p><p style="margin: 4px 0px 0px; color: var(--kro-color-fore-secondary);">Plan</p></nav></div></div><div data-theme="light" style="position: relative; min-height: 240px; padding: var(--kro-space-large); background: linear-gradient(120deg, var(--kro-color-header-gradient-indigo) 0%, var(--kro-color-header-gradient-grape) 40%, var(--kro-color-badge-red) 70%, var(--kro-color-badge-orange) 100%); font-family: system-ui, sans-serif; overflow: hidden;"><p style="position: absolute; inset: 24px; margin: 0px; font-size: 34px; font-weight: 700; line-height: 1.2; color: rgba(255, 255, 255, 0.55);">Plan · Do · Earn · Find. Plan · Do · Earn · Find. Plan · Do · Earn · Find. Plan · Do · Earn · Find.</p><div style="position: relative;"><div style="position: absolute; right: 16px; bottom: 16px; left: 16px;"><nav class="kro-glass kro-glass--dock" style="display: flex; justify-content: space-around; padding: 12px; color: var(--kro-color-fore);"><span>Search</span><span>Plan</span><span>Do</span><span>Earn</span></nav></div></div></div></div></div>"`;

exports[`story snapshots > OnGradient > Gallery 1`] = `"<div><div data-slot="story-gallery" style="display: flex; flex-direction: column; gap: var(--kro-space-large);"><div style="position: relative; height: 220px; padding: 24px;"><div aria-hidden="true" data-testid="<id>" class="kro-detail-backdrop"></div><div style="position: relative; z-index: 1;"><h1 class="kro-on-gradient m-0 font-semibold text-3xl">My Day</h1><p class="kro-on-gradient mt-1 font-normal text-sm">Tuesday, 1 September</p></div></div><div style="position: relative; height: 360px; padding: 24px;"><div aria-hidden="true" data-testid="<id>" class="kro-detail-backdrop"></div><div style="position: relative; z-index: 1;"><h3 class="kro-on-gradient m-0 px-kro-tiny font-semibold text-[13px] uppercase tracking-wide">Preferences</h3><div data-slot="surface-card" class="w-full overflow-hidden" style="padding: var(--kro-space-medium); background-color: var(--kro-color-absolute); border-radius: var(--kro-radius-surface); box-shadow: var(--kro-shadow-card);"><p style="margin: 0px; color: var(--kro-color-fore);">Appearance</p></div></div></div><div style="position: relative; height: 420px; padding: 24px;"><div aria-hidden="true" data-testid="<id>" class="kro-detail-backdrop"></div><div style="position: relative; z-index: 1;"><div class="flex h-full flex-col items-center justify-center gap-kro-small p-kro-x-large text-center"><svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-search kro-on-gradient" aria-hidden="true"><path d="m21 21-4.34-4.34"></path><circle cx="11" cy="11" r="8"></circle></svg><h2 class="kro-on-gradient m-0 font-semibold text-2xl">Find</h2><p class="kro-on-gradient m-0 max-w-prose font-normal text-sm">Find is not built yet.</p></div></div></div></div></div>"`;

exports[`story snapshots > Overview > Gallery 1`] = `"<div><div data-slot="story-gallery" style="display: flex; flex-direction: column; gap: var(--kro-space-large);"><div data-theme="light" data-slot="hig-story-stage" style="display: flex; flex-direction: column; gap: var(--kro-space-medium); align-items: stretch; padding: var(--kro-space-large); min-height: 200px; width: 100%; background: var(--kro-color-back); color: var(--kro-color-fore); font-family: system-ui, sans-serif;"><p style="margin: 0px; font-size: 13px; color: var(--kro-color-fore-secondary); max-width: 72ch;">This is Kro's system. Compact desktop is the default density. HIG, Fluent 2, Material and Primer names are listed at the end of each row so a familiar title still finds the export. 67 exports.</p><section><h2 style="margin: 0px 0px 8px; font-size: 16px; font-weight: 650;">Actions</h2><table style="width: 100%; border-collapse: collapse; font-size: 14px;"><thead><tr style="text-align: left; color: var(--kro-color-fore-secondary); font-size: 12px; letter-spacing: 0.04em; text-transform: uppercase;"><th style="padding: 8px 8px 8px 0px;">Kro</th><th style="padding: 8px 8px;">Purpose</th><th style="padding: 8px 0px 8px 8px;">Also known as</th></tr></thead><tbody><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600; white-space: nowrap;">Button</td><td style="padding: 10px 8px; color: var(--kro-color-fore-secondary);">Trigger a single action. One primary per surface; outline, subtle and transparent for the rest. Compact is the default size.</td><td style="padding: 10px 0px 10px 8px; font-size: 12px; color: var(--kro-color-fore-secondary);">Buttons (HIG) · Button (Fluent 2) · Button (Material) · Button (Primer)</td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600; white-space: nowrap;">CompoundButton</td><td style="padding: 10px 8px; color: var(--kro-color-fore-secondary);">A button with a title and a supporting line. Use when the extra detail helps choose.</td><td style="padding: 10px 0px 10px 8px; font-size: 12px; color: var(--kro-color-fore-secondary);">Compound button (Fluent 2)</td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600; white-space: nowrap;">Link</td><td style="padding: 10px 8px; color: var(--kro-color-fore-secondary);">Interactive text that navigates. Inline with copy, or standalone.</td><td style="padding: 10px 0px 10px 8px; font-size: 12px; color: var(--kro-color-fore-secondary);">Link (Fluent 2) · Link (Primer)</td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600; white-space: nowrap;">PullDownButton</td><td style="padding: 10px 8px; color: var(--kro-color-fore-secondary);">A button that only opens a menu. The label names the action and does not change after a choice.</td><td style="padding: 10px 0px 10px 8px; font-size: 12px; color: var(--kro-color-fore-secondary);">Pull-down buttons (HIG) · Menu button (Fluent 2) · ActionMenu (Primer)</td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600; white-space: nowrap;">PopupButton</td><td style="padding: 10px 8px; color: var(--kro-color-fore-secondary);">Choose one option from a closed list. The trigger shows the current choice.</td><td style="padding: 10px 0px 10px 8px; font-size: 12px; color: var(--kro-color-fore-secondary);">Pop-up buttons (HIG) · Dropdown (Fluent 2) · Select (Material)</td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600; white-space: nowrap;">SplitButton</td><td style="padding: 10px 8px; color: var(--kro-color-fore-secondary);">A primary action plus a chevron that opens related actions. The dominant action is not repeated in the menu.</td><td style="padding: 10px 0px 10px 8px; font-size: 12px; color: var(--kro-color-fore-secondary);">Split button (Fluent 2) · Split button (Material)</td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600; white-space: nowrap;">ToggleButton</td><td style="padding: 10px 8px; color: var(--kro-color-fore-secondary);">A button that stays pressed. Off is rest, on is selected. Not a switch — that is Toggle.</td><td style="padding: 10px 0px 10px 8px; font-size: 12px; color: var(--kro-color-fore-secondary);">Toggle button (Fluent 2) · ToggleButton (Material)</td></tr></tbody></table></section><section><h2 style="margin: 0px 0px 8px; font-size: 16px; font-weight: 650;">Content</h2><table style="width: 100%; border-collapse: collapse; font-size: 14px;"><thead><tr style="text-align: left; color: var(--kro-color-fore-secondary); font-size: 12px; letter-spacing: 0.04em; text-transform: uppercase;"><th style="padding: 8px 8px 8px 0px;">Kro</th><th style="padding: 8px 8px;">Purpose</th><th style="padding: 8px 0px 8px 8px;">Also known as</th></tr></thead><tbody><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600; white-space: nowrap;">Avatar</td><td style="padding: 10px 8px; color: var(--kro-color-fore-secondary);">An image or initials representing a person, with optional presence.</td><td style="padding: 10px 0px 10px 8px; font-size: 12px; color: var(--kro-color-fore-secondary);">Avatar (Fluent 2) · Avatar (Material) · Avatar (Primer)</td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600; white-space: nowrap;">AvatarGroup</td><td style="padding: 10px 8px; color: var(--kro-color-fore-secondary);">Several avatars stacked or spread, with an overflow count.</td><td style="padding: 10px 0px 10px 8px; font-size: 12px; color: var(--kro-color-fore-secondary);">Avatar group (Fluent 2) · AvatarStack (Primer)</td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600; white-space: nowrap;">Chart</td><td style="padding: 10px 8px; color: var(--kro-color-fore-secondary);">A small data picture. The spoken name is the non-colour signal.</td><td style="padding: 10px 0px 10px 8px; font-size: 12px; color: var(--kro-color-fore-secondary);">Charts (HIG)</td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600; white-space: nowrap;">iconForSymbol</td><td style="padding: 10px 8px; color: var(--kro-color-fore-secondary);">A glyph with semantic purpose. Kro maps SF Symbol names onto lucide-react.</td><td style="padding: 10px 0px 10px 8px; font-size: 12px; color: var(--kro-color-fore-secondary);">Icons (HIG) · Icon (Fluent 2) · Icon (Material)</td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600; white-space: nowrap;">ImageView</td><td style="padding: 10px 8px; color: var(--kro-color-fore-secondary);">A still image that can block, fit or be circular. \`alt\` is required.</td><td style="padding: 10px 0px 10px 8px; font-size: 12px; color: var(--kro-color-fore-secondary);">Image views (HIG) · Image (Fluent 2) · Image (Material)</td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600; white-space: nowrap;">Lockup</td><td style="padding: 10px 8px; color: var(--kro-color-fore-secondary);">A generic image-plus-title pair. For a person with presence, use Persona.</td><td style="padding: 10px 0px 10px 8px; font-size: 12px; color: var(--kro-color-fore-secondary);">Lockups (HIG)</td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600; white-space: nowrap;">Persona</td><td style="padding: 10px 8px; color: var(--kro-color-fore-secondary);">A person plus secondary and tertiary text. Presence rides on the avatar.</td><td style="padding: 10px 0px 10px 8px; font-size: 12px; color: var(--kro-color-fore-secondary);">Persona (Fluent 2)</td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600; white-space: nowrap;">Text</td><td style="padding: 10px 8px; color: var(--kro-color-fore-secondary);">Typography as a component: size, weight, wrap, truncate. Not a field — that is TextView. Not a control name — that is Label.</td><td style="padding: 10px 0px 10px 8px; font-size: 12px; color: var(--kro-color-fore-secondary);">Text (Fluent 2) · Typography (Material) · Text (Primer)</td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600; white-space: nowrap;">TextView</td><td style="padding: 10px 8px; color: var(--kro-color-fore-secondary);">Long free-form text. Same recessed field as Input.</td><td style="padding: 10px 0px 10px 8px; font-size: 12px; color: var(--kro-color-fore-secondary);">Text views (HIG) · Textarea (Fluent 2) · Textarea (Primer)</td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600; white-space: nowrap;">WebView</td><td style="padding: 10px 8px; color: var(--kro-color-fore-secondary);">An embedded page. Sandbox is restricted unless the caller opts in.</td><td style="padding: 10px 0px 10px 8px; font-size: 12px; color: var(--kro-color-fore-secondary);">Web views (HIG)</td></tr></tbody></table></section><section><h2 style="margin: 0px 0px 8px; font-size: 16px; font-weight: 650;">Forms</h2><table style="width: 100%; border-collapse: collapse; font-size: 14px;"><thead><tr style="text-align: left; color: var(--kro-color-fore-secondary); font-size: 12px; letter-spacing: 0.04em; text-transform: uppercase;"><th style="padding: 8px 8px 8px 0px;">Kro</th><th style="padding: 8px 8px;">Purpose</th><th style="padding: 8px 0px 8px 8px;">Also known as</th></tr></thead><tbody><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600; white-space: nowrap;">Checkbox</td><td style="padding: 10px 8px; color: var(--kro-color-fore-secondary);">Select several options, or switch one option on or off.</td><td style="padding: 10px 0px 10px 8px; font-size: 12px; color: var(--kro-color-fore-secondary);">Checkboxes (HIG) · Checkbox (Fluent 2) · Checkbox (Material) · Checkbox (Primer)</td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600; white-space: nowrap;">ColorWell</td><td style="padding: 10px 8px; color: var(--kro-color-fore-secondary);">Pick a colour. The swatch is the value, not a word.</td><td style="padding: 10px 0px 10px 8px; font-size: 12px; color: var(--kro-color-fore-secondary);">Color wells (HIG)</td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600; white-space: nowrap;">ComboBox</td><td style="padding: 10px 8px; color: var(--kro-color-fore-secondary);">Type a value or pick one from a list. The field stays editable.</td><td style="padding: 10px 0px 10px 8px; font-size: 12px; color: var(--kro-color-fore-secondary);">Combo boxes (HIG) · Combobox (Fluent 2) · Autocomplete (Material)</td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600; white-space: nowrap;">DigitEntry</td><td style="padding: 10px 8px; color: var(--kro-color-fore-secondary);">A short numeric code, one cell per digit.</td><td style="padding: 10px 0px 10px 8px; font-size: 12px; color: var(--kro-color-fore-secondary);">Digit entry views (HIG)</td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600; white-space: nowrap;">Field</td><td style="padding: 10px 8px; color: var(--kro-color-fore-secondary);">A label plus any form control, with hint, required mark and a validation message.</td><td style="padding: 10px 0px 10px 8px; font-size: 12px; color: var(--kro-color-fore-secondary);">Field (Fluent 2) · FormControl (Primer)</td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600; white-space: nowrap;">InfoLabel</td><td style="padding: 10px 8px; color: var(--kro-color-fore-secondary);">A label with an info button that opens extra copy in a popover.</td><td style="padding: 10px 0px 10px 8px; font-size: 12px; color: var(--kro-color-fore-secondary);">Info label (Fluent 2)</td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600; white-space: nowrap;">Input</td><td style="padding: 10px 8px; color: var(--kro-color-fore-secondary);">Short free-form text. Outline, underline or filled.</td><td style="padding: 10px 0px 10px 8px; font-size: 12px; color: var(--kro-color-fore-secondary);">Text fields (HIG) · Input (Fluent 2) · Text field (Material) · TextInput (Primer)</td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600; white-space: nowrap;">Label</td><td style="padding: 10px 8px; color: var(--kro-color-fore-secondary);">Names a control or group. Required is a mark, not colour alone.</td><td style="padding: 10px 0px 10px 8px; font-size: 12px; color: var(--kro-color-fore-secondary);">Labels (HIG) · Label (Fluent 2) · FormControl.Label (Primer)</td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600; white-space: nowrap;">Picker</td><td style="padding: 10px 8px; color: var(--kro-color-fore-secondary);">A custom list of four or more options. For a native menu, use Select.</td><td style="padding: 10px 0px 10px 8px; font-size: 12px; color: var(--kro-color-fore-secondary);">Pickers (HIG)</td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600; white-space: nowrap;">RadioGroup</td><td style="padding: 10px 8px; color: var(--kro-color-fore-secondary);">Pick exactly one item from a short list.</td><td style="padding: 10px 0px 10px 8px; font-size: 12px; color: var(--kro-color-fore-secondary);">Radio buttons (HIG) · Radio group (Fluent 2) · Radio (Material) · RadioGroup (Primer)</td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600; white-space: nowrap;">RatingIndicator</td><td style="padding: 10px 8px; color: var(--kro-color-fore-secondary);">A discrete 1-to-N score. The number is always spoken and shown.</td><td style="padding: 10px 0px 10px 8px; font-size: 12px; color: var(--kro-color-fore-secondary);">Rating indicators (HIG) · Rating (Fluent 2)</td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600; white-space: nowrap;">SearchField</td><td style="padding: 10px 8px; color: var(--kro-color-fore-secondary);">Find in the current collection. The field is not a destination.</td><td style="padding: 10px 0px 10px 8px; font-size: 12px; color: var(--kro-color-fore-secondary);">Search fields (HIG) · Search (Material)</td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600; white-space: nowrap;">Select</td><td style="padding: 10px 8px; color: var(--kro-color-fore-secondary);">A native select of four or more options. The platform owns the menu. For a custom list, use Picker; for a closed button, use PopupButton.</td><td style="padding: 10px 0px 10px 8px; font-size: 12px; color: var(--kro-color-fore-secondary);">Select (Fluent 2) · Select (Primer)</td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600; white-space: nowrap;">Slider</td><td style="padding: 10px 8px; color: var(--kro-color-fore-secondary);">A value from a continuous range, by dragging a thumb.</td><td style="padding: 10px 0px 10px 8px; font-size: 12px; color: var(--kro-color-fore-secondary);">Sliders (HIG) · Slider (Fluent 2) · Slider (Material)</td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600; white-space: nowrap;">SpinButton</td><td style="padding: 10px 8px; color: var(--kro-color-fore-secondary);">Nudge a numeric value inside a range. The value is in an editable field, unlike a Stepper.</td><td style="padding: 10px 0px 10px 8px; font-size: 12px; color: var(--kro-color-fore-secondary);">Spin button (Fluent 2)</td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600; white-space: nowrap;">Stepper</td><td style="padding: 10px 8px; color: var(--kro-color-fore-secondary);">Plus and minus around a readout. The value is not typed — that is SpinButton.</td><td style="padding: 10px 0px 10px 8px; font-size: 12px; color: var(--kro-color-fore-secondary);">Steppers (HIG)</td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600; white-space: nowrap;">TagPicker</td><td style="padding: 10px 8px; color: var(--kro-color-fore-secondary);">A field of dismissible tags plus a dropdown, for picking several values.</td><td style="padding: 10px 0px 10px 8px; font-size: 12px; color: var(--kro-color-fore-secondary);">Tag picker (Fluent 2)</td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600; white-space: nowrap;">Toggle</td><td style="padding: 10px 8px; color: var(--kro-color-fore-secondary);">Two mutually exclusive options, like on or off. The knob is the state. Not a pressed button — that is ToggleButton.</td><td style="padding: 10px 0px 10px 8px; font-size: 12px; color: var(--kro-color-fore-secondary);">Toggles (HIG) · Switch (Fluent 2) · Switch (Material)</td></tr></tbody></table></section><section><h2 style="margin: 0px 0px 8px; font-size: 16px; font-weight: 650;">Layout</h2><table style="width: 100%; border-collapse: collapse; font-size: 14px;"><thead><tr style="text-align: left; color: var(--kro-color-fore-secondary); font-size: 12px; letter-spacing: 0.04em; text-transform: uppercase;"><th style="padding: 8px 8px 8px 0px;">Kro</th><th style="padding: 8px 8px;">Purpose</th><th style="padding: 8px 0px 8px 8px;">Also known as</th></tr></thead><tbody><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600; white-space: nowrap;">Collection</td><td style="padding: 10px 8px; color: var(--kro-color-fore-secondary);">A wrapping grid of peer items.</td><td style="padding: 10px 0px 10px 8px; font-size: 12px; color: var(--kro-color-fore-secondary);">Collections (HIG)</td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600; white-space: nowrap;">ColumnView</td><td style="padding: 10px 8px; color: var(--kro-color-fore-secondary);">A hierarchy as adjacent columns, Finder-style.</td><td style="padding: 10px 0px 10px 8px; font-size: 12px; color: var(--kro-color-fore-secondary);">Column views (HIG)</td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600; white-space: nowrap;">Disclosure</td><td style="padding: 10px 8px; color: var(--kro-color-fore-secondary);">One block that opens and closes. For a list of those blocks, use Accordion.</td><td style="padding: 10px 0px 10px 8px; font-size: 12px; color: var(--kro-color-fore-secondary);">Disclosure controls (HIG)</td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600; white-space: nowrap;">GroupedBox</td><td style="padding: 10px 8px; color: var(--kro-color-fore-secondary);">An inset group of related rows. For a header/preview/footer card, use Card.</td><td style="padding: 10px 0px 10px 8px; font-size: 12px; color: var(--kro-color-fore-secondary);">Boxes (HIG)</td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600; white-space: nowrap;">List</td><td style="padding: 10px 8px; color: var(--kro-color-fore-secondary);">Like items stacked vertically, with optional sections.</td><td style="padding: 10px 0px 10px 8px; font-size: 12px; color: var(--kro-color-fore-secondary);">Lists and tables (HIG) · List (Fluent 2) · List (Material) · ActionList (Primer)</td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600; white-space: nowrap;">OutlineView</td><td style="padding: 10px 8px; color: var(--kro-color-fore-secondary);">Hierarchical nested data. Rows expand in place.</td><td style="padding: 10px 0px 10px 8px; font-size: 12px; color: var(--kro-color-fore-secondary);">Outline views (HIG) · Tree (Fluent 2) · TreeView (Primer)</td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600; white-space: nowrap;">ScrollView</td><td style="padding: 10px 8px; color: var(--kro-color-fore-secondary);">A region that scrolls on one axis when content overflows.</td><td style="padding: 10px 0px 10px 8px; font-size: 12px; color: var(--kro-color-fore-secondary);">Scroll views (HIG)</td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600; white-space: nowrap;">Separator</td><td style="padding: 10px 8px; color: var(--kro-color-fore-secondary);">A hairline that groups sections. Optional label.</td><td style="padding: 10px 0px 10px 8px; font-size: 12px; color: var(--kro-color-fore-secondary);">Separators (HIG) · Divider (Fluent 2) · Divider (Material)</td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600; white-space: nowrap;">SplitView</td><td style="padding: 10px 8px; color: var(--kro-color-fore-secondary);">Two panes side by side, with a draggable divider.</td><td style="padding: 10px 0px 10px 8px; font-size: 12px; color: var(--kro-color-fore-secondary);">Split views (HIG)</td></tr></tbody></table></section><section><h2 style="margin: 0px 0px 8px; font-size: 16px; font-weight: 650;">Navigation</h2><table style="width: 100%; border-collapse: collapse; font-size: 14px;"><thead><tr style="text-align: left; color: var(--kro-color-fore-secondary); font-size: 12px; letter-spacing: 0.04em; text-transform: uppercase;"><th style="padding: 8px 8px 8px 0px;">Kro</th><th style="padding: 8px 8px;">Purpose</th><th style="padding: 8px 0px 8px 8px;">Also known as</th></tr></thead><tbody><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600; white-space: nowrap;">Accordion</td><td style="padding: 10px 8px; color: var(--kro-color-fore-secondary);">Grouped sections that open and close. Multiple, collapsible, or exclusive. One block alone is Disclosure.</td><td style="padding: 10px 0px 10px 8px; font-size: 12px; color: var(--kro-color-fore-secondary);">Accordion (Fluent 2)</td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600; white-space: nowrap;">NavigationBar</td><td style="padding: 10px 8px; color: var(--kro-color-fore-secondary);">The current place, a back control and trailing actions.</td><td style="padding: 10px 0px 10px 8px; font-size: 12px; color: var(--kro-color-fore-secondary);">Navigation bars (HIG) · AppBar (Material)</td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600; white-space: nowrap;">PathControl</td><td style="padding: 10px 8px; color: var(--kro-color-fore-secondary);">The current place in a hierarchy, with ancestors that jump back. Overflow collapses the middle.</td><td style="padding: 10px 0px 10px 8px; font-size: 12px; color: var(--kro-color-fore-secondary);">Path controls (HIG) · Breadcrumb (Fluent 2) · Breadcrumbs (Primer)</td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600; white-space: nowrap;">Sidebar</td><td style="padding: 10px 8px; color: var(--kro-color-fore-secondary);">A list of links through the main sections of an app. Categories can nest. Selecting a row reports an id.</td><td style="padding: 10px 0px 10px 8px; font-size: 12px; color: var(--kro-color-fore-secondary);">Sidebars (HIG) · Nav (Fluent 2) · Navigation drawer (Material) · NavList (Primer)</td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600; white-space: nowrap;">TabBar</td><td style="padding: 10px 8px; color: var(--kro-color-fore-secondary);">Top-level destinations on a compact surface. In-page category switching is Tabs.</td><td style="padding: 10px 0px 10px 8px; font-size: 12px; color: var(--kro-color-fore-secondary);">Tab bars (HIG) · Navigation bar (Material)</td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600; white-space: nowrap;">Tabs</td><td style="padding: 10px 8px; color: var(--kro-color-fore-secondary);">Switch categories of related information without leaving the page. Not top-level navigation.</td><td style="padding: 10px 0px 10px 8px; font-size: 12px; color: var(--kro-color-fore-secondary);">Tab views (HIG) · Segmented controls (HIG) · Tablist (Fluent 2) · Tabs (Material) · UnderlineNav (Primer)</td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600; white-space: nowrap;">Toolbar</td><td style="padding: 10px 8px; color: var(--kro-color-fore-secondary);">Frequent actions for the current view, grouped.</td><td style="padding: 10px 0px 10px 8px; font-size: 12px; color: var(--kro-color-fore-secondary);">Toolbars (HIG) · Toolbar (Fluent 2)</td></tr></tbody></table></section><section><h2 style="margin: 0px 0px 8px; font-size: 16px; font-weight: 650;">Surfaces</h2><table style="width: 100%; border-collapse: collapse; font-size: 14px;"><thead><tr style="text-align: left; color: var(--kro-color-fore-secondary); font-size: 12px; letter-spacing: 0.04em; text-transform: uppercase;"><th style="padding: 8px 8px 8px 0px;">Kro</th><th style="padding: 8px 8px;">Purpose</th><th style="padding: 8px 0px 8px 8px;">Also known as</th></tr></thead><tbody><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600; white-space: nowrap;">ActionSheet</td><td style="padding: 10px 8px; color: var(--kro-color-fore-secondary);">A set of actions related to the current context, from an edge.</td><td style="padding: 10px 0px 10px 8px; font-size: 12px; color: var(--kro-color-fore-secondary);">Action sheets (HIG)</td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600; white-space: nowrap;">Alert</td><td style="padding: 10px 8px; color: var(--kro-color-fore-secondary);">A confirmation that can require an action before work continues. For a general supplemental surface, use Dialog.</td><td style="padding: 10px 0px 10px 8px; font-size: 12px; color: var(--kro-color-fore-secondary);">Alerts (HIG)</td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600; white-space: nowrap;">Card</td><td style="padding: 10px 8px; color: var(--kro-color-fore-secondary);">A container for one concept: header, preview, body, footer. Filled, outline or subtle. Not an inset group — that is GroupedBox.</td><td style="padding: 10px 0px 10px 8px; font-size: 12px; color: var(--kro-color-fore-secondary);">Card (Fluent 2) · Card (Material)</td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600; white-space: nowrap;">Carousel</td><td style="padding: 10px 8px; color: var(--kro-color-fore-secondary);">Cycle through peer content without leaving the page. Pagination is numbered, not colour alone.</td><td style="padding: 10px 0px 10px 8px; font-size: 12px; color: var(--kro-color-fore-secondary);">Carousel (Fluent 2) · Carousel (Material)</td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600; white-space: nowrap;">Dialog</td><td style="padding: 10px 8px; color: var(--kro-color-fore-secondary);">A supplemental surface that can require an action before work continues.</td><td style="padding: 10px 0px 10px 8px; font-size: 12px; color: var(--kro-color-fore-secondary);">Dialog (Fluent 2) · Dialog (Material) · Dialog (Primer)</td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600; white-space: nowrap;">DropdownMenu</td><td style="padding: 10px 8px; color: var(--kro-color-fore-secondary);">A hidden list of options shown from a trigger.</td><td style="padding: 10px 0px 10px 8px; font-size: 12px; color: var(--kro-color-fore-secondary);">Menus (HIG) · Context menus (HIG) · Menu (Fluent 2) · Menu (Material) · ActionMenu (Primer)</td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600; white-space: nowrap;">Panel</td><td style="padding: 10px 8px; color: var(--kro-color-fore-secondary);">A persistent inspector beside the main view.</td><td style="padding: 10px 0px 10px 8px; font-size: 12px; color: var(--kro-color-fore-secondary);">Panels (HIG)</td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600; white-space: nowrap;">Popover</td><td style="padding: 10px 8px; color: var(--kro-color-fore-secondary);">A small surface anchored to a control for nonessential context.</td><td style="padding: 10px 0px 10px 8px; font-size: 12px; color: var(--kro-color-fore-secondary);">Popovers (HIG) · Popover (Fluent 2) · AnchoredOverlay (Primer)</td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600; white-space: nowrap;">Sheet</td><td style="padding: 10px 8px; color: var(--kro-color-fore-secondary);">A secondary surface that slides in from an edge.</td><td style="padding: 10px 0px 10px 8px; font-size: 12px; color: var(--kro-color-fore-secondary);">Sheets (HIG) · Drawer (Fluent 2) · Navigation drawer (Material)</td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600; white-space: nowrap;">Tooltip</td><td style="padding: 10px 8px; color: var(--kro-color-fore-secondary);">Supplemental context near a target. Relationship is labelled.</td><td style="padding: 10px 0px 10px 8px; font-size: 12px; color: var(--kro-color-fore-secondary);">Tooltip (Fluent 2) · Tooltip (Material) · Tooltip (Primer)</td></tr></tbody></table></section><section><h2 style="margin: 0px 0px 8px; font-size: 16px; font-weight: 650;">Status</h2><table style="width: 100%; border-collapse: collapse; font-size: 14px;"><thead><tr style="text-align: left; color: var(--kro-color-fore-secondary); font-size: 12px; letter-spacing: 0.04em; text-transform: uppercase;"><th style="padding: 8px 8px 8px 0px;">Kro</th><th style="padding: 8px 8px;">Purpose</th><th style="padding: 8px 0px 8px 8px;">Also known as</th></tr></thead><tbody><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600; white-space: nowrap;">Badge</td><td style="padding: 10px 8px; color: var(--kro-color-fore-secondary);">A status or description of an associated control. Colour is never the only signal. For a card-corner capsule, use CardBadge.</td><td style="padding: 10px 0px 10px 8px; font-size: 12px; color: var(--kro-color-fore-secondary);">Badge (Fluent 2) · Badge (Material) · CounterLabel (Primer)</td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600; white-space: nowrap;">Gauge</td><td style="padding: 10px 8px; color: var(--kro-color-fore-secondary);">A value on a known scale, as a ring.</td><td style="padding: 10px 0px 10px 8px; font-size: 12px; color: var(--kro-color-fore-secondary);">Gauges (HIG)</td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600; white-space: nowrap;">InlineBanner</td><td style="padding: 10px 8px; color: var(--kro-color-fore-secondary);">Important information about the product or the current surface. Intent is named in words. Success, dismiss and single/multiline layouts are included.</td><td style="padding: 10px 0px 10px 8px; font-size: 12px; color: var(--kro-color-fore-secondary);">Message bar (Fluent 2) · Banner (Material) · Flash (Primer)</td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600; white-space: nowrap;">ProgressIndicator</td><td style="padding: 10px 8px; color: var(--kro-color-fore-secondary);">How far a determinate task has got, or that one is still running. The indeterminate kind is the spinner.</td><td style="padding: 10px 0px 10px 8px; font-size: 12px; color: var(--kro-color-fore-secondary);">Progress indicators (HIG) · Progress bar (Fluent 2) · Spinner (Fluent 2) · Progress indicator (Material) · Spinner (Primer)</td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600; white-space: nowrap;">Skeleton</td><td style="padding: 10px 8px; color: var(--kro-color-fore-secondary);">A section is loading, without blocking the rest of the page. Shape, not colour, is the signal.</td><td style="padding: 10px 0px 10px 8px; font-size: 12px; color: var(--kro-color-fore-secondary);">Skeleton (Fluent 2) · Skeleton (Material)</td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600; white-space: nowrap;">Tag</td><td style="padding: 10px 8px; color: var(--kro-color-fore-secondary);">A value someone picked (a recipient, a category). Dismissible. For an identity/status capsule, use KroChip.</td><td style="padding: 10px 0px 10px 8px; font-size: 12px; color: var(--kro-color-fore-secondary);">Tag (Fluent 2) · Chip (Material) · Token (Primer)</td></tr></tbody></table></section></div></div></div>"`;

exports[`story snapshots > Sheet > Gallery 1`] = `"<div><div data-slot="story-gallery" style="display: flex; flex-direction: column; gap: var(--kro-space-large);"><div data-theme="light" style="padding: 24px; background: var(--kro-color-back);"><button data-slot="button" data-shape="rounded" type="button" class="inline-flex shrink-0 items-center justify-center gap-1 cursor-default whitespace-nowrap font-medium kro-motion-quick transition-[color,background-color,box-shadow,transform] outline-none focus-visible:shadow-[var(--kro-ring)] active:scale-[0.97] disabled:pointer-events-none disabled:opacity-[var(--kro-opacity-disabled)] [&amp;_svg]:pointer-events-none [&amp;_svg:not([class*='size-'])]:size-3.5 kro-glass kro-glass--control kro-glass--accent kro-glass--interactive text-kro-on-accent h-6 rounded-kro-small px-2 text-xs" aria-haspopup="dialog" aria-expanded="false" data-state="closed">Open inbox</button></div><div data-theme="light" style="padding: 24px; background: var(--kro-color-back);"><button data-slot="button" data-shape="rounded" type="button" class="inline-flex shrink-0 items-center justify-center gap-1 cursor-default whitespace-nowrap font-medium kro-motion-quick transition-[color,background-color,box-shadow,transform] outline-none focus-visible:shadow-[var(--kro-ring)] active:scale-[0.97] disabled:pointer-events-none disabled:opacity-[var(--kro-opacity-disabled)] [&amp;_svg]:pointer-events-none [&amp;_svg:not([class*='size-'])]:size-3.5 kro-glass kro-glass--control kro-glass--interactive text-kro-fore h-6 rounded-kro-small px-2 text-xs" aria-haspopup="dialog" aria-expanded="false" data-state="closed">Visibility</button></div><div data-theme="light" style="padding: 24px; background: var(--kro-color-back);"><button data-slot="button" data-shape="rounded" type="button" class="inline-flex shrink-0 items-center justify-center gap-1 cursor-default whitespace-nowrap font-medium kro-motion-quick transition-[color,background-color,box-shadow,transform] outline-n