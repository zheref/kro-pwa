exports[`story snapshots > Tokens > Gallery 1`] = `"<div><div data-slot="story-gallery" style="display: flex; flex-direction: column; gap: var(--kro-space-large);"><div style="display: flex; min-height: 100vh;"><div data-theme="light" style="background: var(--kro-color-back); color: var(--kro-color-fore); padding: var(--kro-space-large); min-height: 100%; flex: 1 1 0%; font-family: system-ui, sans-serif;"><h2 style="margin-bottom: var(--kro-space-medium); font-size: 13px; text-transform: uppercase; letter-spacing: 0.08em; color: var(--kro-color-fore-secondary);">light</h2><div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(190px, 1fr)); gap: var(--kro-space-medium);"><div><div style="display: flex; align-items: center; gap: var(--kro-space-small);"><div style="width: 44px; height: 44px; flex-shrink: 0; border-radius: var(--kro-radius-small); background: var(--kro-color-back); box-shadow: inset 0 0 0 1px var(--kro-color-hairline);"></div><div style="min-width: 0;"><div style="font-size: 13px; font-weight: 600;">back</div><div style="font-size: 11px; color: var(--kro-color-fore-secondary);">var(--kro-color-back)</div></div></div></div><div><div style="display: flex; align-items: center; gap: var(--kro-space-small);"><div style="width: 44px; height: 44px; flex-shrink: 0; border-radius: var(--kro-radius-small); background: var(--kro-color-back-inner); box-shadow: inset 0 0 0 1px var(--kro-color-hairline);"></div><div style="min-width: 0;"><div style="font-size: 13px; font-weight: 600;">backInner</div><div style="font-size: 11px; color: var(--kro-color-fore-secondary);">var(--kro-color-back-inner)</div></div></div></div><div><div style="display: flex; align-items: center; gap: var(--kro-space-small);"><div style="width: 44px; height: 44px; flex-shrink: 0; border-radius: var(--kro-radius-small); background: var(--kro-color-back-next); box-shadow: inset 0 0 0 1px var(--kro-color-hairline);"></div><div style="min-width: 0;"><div style="font-size: 13px