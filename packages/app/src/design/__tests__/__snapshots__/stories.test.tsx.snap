exports[`story snapshots > DetailBackdrop > Gallery 1`] = `"<div><div data-slot="story-gallery" style="display: flex; flex-direction: column; gap: var(--kro-space-large);"><div data-theme="light" style="position: relative; height: 100vh;"><div aria-hidden="true" data-testid="<id>" class="kro-detail-backdrop"></div></div><div data-theme="light" style="position: relative; display: flex; gap: 8px; height: 100vh; padding: 8px; font-family: system-ui, sans-serif;"><div aria-hidden="true" data-testid="<id>" class="kro-detail-backdrop"></div><div class="kro-glass kro-glass--sidebar" style="position: relative; width: 220px; padding: 12px; color: var(--kro-color-fore);"><p style="margin: 0px; font-weight: 600;">Kro</p><p style="margin: 8px 0px 0px; font-size: 14px;">Today</p><p style="margin: 4px 0px 0px; font-size: 14px;">Plan</p></div><div style="position: relative; flex: 1 1 0%; color: rgb(255, 255, 255);"><h1 style="margin: 16px; font-size: 32px;">My Day</h1></div></div><div data-theme="dark" style="position: relative; height: 100vh;"><div aria-hidden="true" data-testid="<id>" class="kro-detail-backdrop"></div><div class="kro-glass kro-glass--dock" style="position: absolute; right: 16px; bottom: 16px; left: 16px; display: flex; justify-content: space-around; padding: 12px; color: var(--kro-color-fore);"><span>Search</span><span>Plan</span><span>Do</span><span>Earn</span></div></div></div></div>"`;

