exports[`story snapshots > EmojiPicker > PinnedHeadings 1`] = `"<div><div data-theme="light" style="position: relative; min-height: 380px; overflow: hidden; background: linear-gradient(120deg, #5856d6 0%, #663399 40%, #b7162f 70%, #c78c00 100%); font-family: system-ui, sans-serif;"><p style="position: absolute; inset: 24px; margin: 0px; font-size: 30px; font-weight: 700; line-height: 1.2; color: rgba(255, 255, 255, 0.5); pointer-events: none;">Plan · Do · Earn · Find. Plan · Do · Earn · Find. Plan · Do · Earn · Find.</p><p style="position: absolute; top: 8px; left: 12px; margin: 0px; font-size: 12px; font-weight: 700; letter-spacing: 1px; text-transform: uppercase; color: rgba(255, 255, 255, 0.85);">Scroll the panel</p><div class="kro-glass" style="position: absolute; top: 24px; left: 24px; width: 360px; height: 320px; border-radius: 16px; overflow: hidden;"><div data-kro-emoji-picker="" class="overflow-y-auto" style="height: 100%;"><section data-kro-emoji-category="activities"><h3 data-kro-emoji-heading="" class="kro-glass kro-glass--bar text-kro-fore-secondary" style="position: sticky; top: 0px; z-index: 1; margin: 0px; padding: 6px 12px; font-size: 11px; font-weight: 600; letter-spacing: 1.2px; text-transform: uppercase;">Activities</h3><div role="group" aria-label="Activities" style="display: grid; grid-template-columns: repeat(7, minmax(var(--kro-size-min-touch-target), 56px)); gap: 4px; padding: 6px 12px 12px;"><button type="button" aria-label="💼" aria-pressed="false" data-kro-emoji="available" class="kro-motion-quick outline-none focus-visible:shadow-[var(--kro-ring)]" style="min-height: var(--kro-size-min-touch-target); border-radius: 8px; cursor: pointer; font-size: 26px; line-height: 1; background: transparent;"><span aria-hidden="true">💼</span></button><button type="button" aria-label="📊" aria-pressed="false" data-kro-emoji="available" class="kro-motion-quick outline-none focus-visible:shadow-[var(--kro-ring)]" style="min-height: var(--kro-size-min-touch-