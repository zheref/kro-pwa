exports[`story snapshots > RotatingGlow > TwoHuesVersusOne 1`] = `"<div><div data-theme="dark" style="position: relative; min-height: 280px; overflow: hidden; background: linear-gradient(120deg, #5856d6 0%, #663399 40%, #b7162f 70%, #c78c00 100%); font-family: system-ui, sans-serif;"><p style="position: absolute; inset: 24px; margin: 0px; font-size: 30px; font-weight: 700; line-height: 1.2; color: rgba(255, 255, 255, 0.5); pointer-events: none;">Plan · Do · Earn · Find. Plan · Do · Earn · Find. Plan · Do · Earn · Find.</p><p style="position: absolute; top: 8px; left: 12px; margin: 0px; font-size: 12px; font-weight: 700; letter-spacing: 1px; text-transform: uppercase; color: rgba(255, 255, 255, 0.85);">Left: two hues (travels). Right: one (pulses).</p><div style="position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; gap: 40px;"><div data-kro-glow="active" data-kro-glow-animating="true" style="position: relative; isolation: isolate; display: inline-flex;"><div aria-hidden="true" data-kro-glow-band="" style="position: absolute; inset: -3px; padding: 3px; border-radius: 9999px; mask-image: linear-gradient(#000 0 0), linear-gradient(#000 0 0); mask-clip: content-box, border-box; mask-composite: exclude; filter: blur(5px); z-index: -1; pointer-events: none;"><div data-kro-glow-sweep="" style="position: absolute; left: -50%; top: -50%; width: 200%; height: 200%; background: conic-gradient(from 0deg, var(--kro-color-ring-emerald), var(--kro-color-glow-lime), var(--kro-color-ring-emerald));"></div></div><div aria-hidden="true" data-kro-glow-band="" style="position: absolute; inset: -3px; padding: 3px; border-radius: 9999px; mask-image: linear-gradient(#000 0 0), linear-gradient(#000 0 0); mask-clip: content-box, border-box; mask-composite: exclude; filter: blur(5px); z-index: -1; pointer-events: none;"><div data-kro-glow-sweep="" style="position: absolute; left: -50%; top: -50%; width: 200%; height: 200%; background: conic-gradient(from 0