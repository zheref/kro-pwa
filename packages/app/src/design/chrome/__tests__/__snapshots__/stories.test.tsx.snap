px); z-index: -1; pointer-events: none;"><div data-kro-glow-sweep="" style="position: absolute; left: -50%; top: -50%; width: 200%; height: 200%; background: conic-gradient(from 0deg, var(--kro-color-ring-emerald), var(--kro-color-ring-emerald));"></div></div><div aria-hidden="true" data-kro-glow-band="" style="position: absolute; inset: -3px; padding: 3px; border-radius: 9999px; mask-image: linear-gradient(#000 0 0), linear-gradient(#000 0 0); mask-clip: content-box, border-box; mask-composite: exclude; filter: blur(5px); z-index: -1; pointer-events: none;"><div data-kro-glow-sweep="" style="position: absolute; left: -50%; top: -50%; width: 200%; height: 200%; background: conic-gradient(from 0deg, var(--kro-color-ring-emerald), var(--kro-color-ring-emerald));"></div></div><div aria-hidden="true" data-kro-glow-band="" style="position: absolute; inset: -3px; padding: 3px; border-radius: 9999px; mask-image: linear-gradient(#000 0 0), linear-gradient(#000 0 0); mask-clip: content-box, border-box; mask-composite: exclude; filter: blur(5px); z-index: -1; pointer-events: none;"><div data-kro-glow-sweep="" style="position: absolute; left: -50%; top: -50%; width: 200%; height: 200%; background: conic-gradient(from 0deg, var(--kro-color-ring-emerald), var(--kro-color-ring-emerald));"></div></div><button data-slot="button" type="button" class="inline-flex shrink-0 items-center justify-center gap-kro-small whitespace-nowrap font-medium kro-motion-quick transition-[color,background-color,box-shadow,transform] outline-none focus-visible:shadow-[var(--kro-ring)] active:scale-[0.97] disabled:pointer-events-none disabled:opacity-[var(--kro-opacity-disabled)] [&amp;_svg]:pointer-events-none [&amp;_svg:not([class*='size-'])]:size-5 kro-glass kro-glass--control kro-glass--interactive px-kro-medium size-11 rounded-kro-field" aria-label="One hue" data-kro-fab="" style="width: 62px; height: 62px; border-radius: 50%; padding: 0px;"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-plus size-6" aria-hidden="true"><path d="M5 12h14"></path><path d="M12 5v14"></path></svg></button></div></div></div></div>"`;
