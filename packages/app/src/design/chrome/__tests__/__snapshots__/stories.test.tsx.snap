exports[`story snapshots > ActivityRings > AnimatedTransition 1`] = `"<div><div data-theme="light" style="position: relative; min-height: 340px; overflow: hidden; background: linear-gradient(120deg, #5856d6 0%, #663399 40%, #b7162f 70%, #c78c00 100%); font-family: system-ui, sans-serif;"><p style="position: absolute; inset: 24px; margin: 0px; font-size: 30px; font-weight: 700; line-height: 1.2; color: rgba(255, 255, 255, 0.5); pointer-events: none;">Plan · Do · Earn · Find. Plan · Do · Earn · Find. Plan · Do · Earn · Find.</p><p style="position: absolute; top: 8px; left: 12px; margin: 0px; font-size: 12px; font-weight: 700; letter-spacing: 1px; text-transform: uppercase; color: rgba(255, 255, 255, 0.85);">Mark one complete and watch the arc move</p><div style="position: absolute; inset: 0; display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 28px; padding: 24px;"><div style="display: flex; flex-direction: column; align-items: center; gap: 10px; min-width: 130px;"><svg width="110" height="110" viewBox="0 0 110 110" data-kro-activity-rings="2" role="img" aria-label="Habits, 1 of 4 complete, Tasks, 2 of 5 complete"><title>Habits, 1 of 4 complete, Tasks, 2 of 5 complete</title><g data-kro-ring="habits" transform="rotate(-90 55 55)"><circle cx="55" cy="55" r="48.5" fill="none" stroke="var(--kro-color-ring-gold)" stroke-opacity="0.22" stroke-width="13" data-kro-ring-track=""></circle><circle cx="55" cy="55" r="48.5" fill="none" stroke="var(--kro-color-ring-gold)" stroke-width="13" stroke-linecap="round" stroke-dasharray="304.7344873982099" stroke-dashoffset="228.55086554865744" data-kro-ring-arc="" data-kro-ring-progress="0.25" style="transition-property: stroke-dashoffset; transition-duration: 619ms; transition-timing-function: linear(0, 0.0441, 0.1481, 0.2792, 0.4158, 0.5446, 0.6583, 0.7538, 0.8306, 0.8901, 0.9345, 0.9662, 0.9878, 1.0017, 1.0098, 1.0139, 1.0151, 1.0147, 1.0132, 1.0113, 1.0092, 1.0072, 1.0054, 1.0039, 1);"></circle></g><g da