exports[`story snapshots > ActivityRings > TruthTable 1`] = `"<div><div data-theme="light" style="position: relative; min-height: 320px; overflow: hidden; background: linear-gradient(120deg, #5856d6 0%, #663399 40%, #b7162f 70%, #c78c00 100%); font-family: system-ui, sans-serif;"><p style="position: absolute; inset: 24px; margin: 0px; font-size: 30px; font-weight: 700; line-height: 1.2; color: rgba(255, 255, 255, 0.5); pointer-events: none;">Plan · Do · Earn · Find. Plan · Do · Earn · Find. Plan · Do · Earn · Find.</p><p style="position: absolute; top: 8px; left: 12px; margin: 0px; font-size: 12px; font-weight: 700; letter-spacing: 1px; text-transform: uppercase; color: rgba(255, 255, 255, 0.85);">Nothing expected · habits only · tasks only · both · both complete</p><div style="position: absolute; inset: 0; display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 28px; padding: 24px;"><div style="display: flex; flex-direction: column; align-items: center; gap: 10px; min-width: 130px;"><svg width="72" height="72" viewBox="0 0 72 72" data-kro-activity-rings="0" role="presentation" aria-hidden="true"><title></title></svg><span style="font-size: 12px; font-weight: 600; text-align: center; color: rgba(255, 255, 255, 0.95);">Nothing expected — no rings</span></div><div style="display: flex; flex-direction: column; align-items: center; gap: 10px; min-width: 130px;"><svg width="72" height="72" viewBox="0 0 72 72" data-kro-activity-rings="1" role="img" aria-label="Habits, 2 of 4 complete"><title>Habits, 2 of 4 complete</title><g data-kro-ring="habits" transform="rotate(-90 36 36)"><circle cx="36" cy="36" r="31.5" fill="none" stroke="var(--kro-color-ring-gold)" stroke-opacity="0.22" stroke-width="9" data-kro-ring-track=""></circle><circle cx="36" cy="36" r="31.5" fill="none" stroke="var(--kro-color-ring-gold)" stroke-width="9" stroke-linecap="round" stroke-dasharray="197.92033717615698" stroke-dashoffset="98.96016858807849" data-kro-ring-arc="" data-