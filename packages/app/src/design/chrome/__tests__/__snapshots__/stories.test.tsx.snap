exports[`story snapshots > ActiveToast > ActionStyles 1`] = `"<div><div style="display: grid; grid-template-columns: 1fr 1fr;"><div data-theme="light" style="position: relative; min-height: 420px; overflow: hidden; background: linear-gradient(120deg, #5856d6 0%, #663399 40%, #b7162f 70%, #c78c00 100%); font-family: system-ui, sans-serif;"><p style="position: absolute; inset: 24px; margin: 0px; font-size: 30px; font-weight: 700; line-height: 1.2; color: rgba(255, 255, 255, 0.5); pointer-events: none;">Plan · Do · Earn · Find. Plan · Do · Earn · Find. Plan · Do · Earn · Find.</p><p style="position: absolute; top: 8px; left: 12px; margin: 0px; font-size: 12px; font-weight: 700; letter-spacing: 1px; text-transform: uppercase; color: rgba(255, 255, 255, 0.85);">Light</p><div style="position: absolute; inset: 0; display: flex; flex-direction: column; align-items: flex-start; justify-content: center; gap: 16px; padding: 20px;"><div class="kro-glass text-kro-fore" data-kro-toast="" style="display: flex; align-items: center; gap: 12px; min-height: 72px; max-width: 360px; width: 100%; border-radius: 16px; padding: 16px 18px;"><div style="display: flex; align-items: center; gap: 10px; min-width: 0; flex: 1 1 0%;"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-check" aria-hidden="true" style="width: 20px; height: 20px; flex: 0 0 24px; color: var(--kro-color-badge-green);"><circle cx="12" cy="12" r="10"></circle><path d="m16 9-5.5 5.5L8 12"></path></svg><div style="display: flex; flex-direction: column; gap: 6px; min-width: 0;"><span data-kro-toast-message="" style="font-size: 15px; font-weight: 500; line-height: 1.3; display: -webkit-box; -webkit-line-clamp: 2; overflow: hidden;">"Buy groceries" marked complete</span><span data-kro-toast-reward="" style="display: inline-flex; align-items: center; gap: 4px; color: va