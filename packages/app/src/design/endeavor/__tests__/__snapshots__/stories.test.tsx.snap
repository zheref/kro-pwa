exports[`story snapshots > CompactPresentationHeader > Gallery 1`] = `"<div data-slot="story-gallery" style="display: flex; flex-direction: column; gap: var(--kro-space-large);"><div data-theme="light" data-slot="story-stage" style="display: flex; flex-direction: column; gap: var(--kro-space-medium); align-items: flex-start; padding: var(--kro-space-large); min-height: 160px; width: 100%; background: var(--kro-color-back); font-family: system-ui, sans-serif;"><div style="width: 560px; overflow: hidden; border-radius: var(--kro-radius-surface); background: var(--kro-color-absolute); box-shadow: var(--kro-shadow-card);"><header data-slot="compact-presentation-header" class="flex w-full items-center gap-2.5 px-3 py-2.5" style="background-color: color-mix(in srgb, var(--kro-color-fore) 2.5%, transparent);"><button type="button" aria-label="Close" class="inline-flex shrink-0 items-center justify-center rounded-kro-pill outline-none focus-visible:shadow-[var(--kro-ring)]" style="min-width: var(--kro-size-min-touch-target); min-height: var(--kro-size-min-touch-target);"><span aria-hidden="true" class="inline-flex size-[30px] items-center justify-center rounded-kro-pill" style="background-color: color-mix(in srgb, var(--kro-color-fore) 8%, transparent); color: var(--kro-color-fore);"><svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-x" aria-hidden="true"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg></span></button><div class="flex min-w-0 flex-col gap-px"><p class="m-0 truncate text-base font-semibold" style="color: var(--kro-color-fore);">Inbox</p><p class="m-0 truncate text-xs" style="color: var(--kro-color-fore-secondary);">3 endeavors</p></div></header></div></div><div data-theme="light" data-slot="story-stage" style="display: flex; flex-direction: column; gap: var(--kro-space-medium); align-items: flex-start; padding: var(--kro-space-large); min-height: 160px; width: 100%; background: var(--kro-color-back); font-family: system-ui, sans-serif;"><div style="width: 460px; overflow: hidden; border-radius: var(--kro-radius-surface); background: var(--kro-color-absolute); box-shadow: var(--kro-shadow-card);"><header data-slot="compact-presentation-header" class="flex w-full items-center gap-2.5 px-3 py-2.5" style="background-color: color-mix(in srgb, var(--kro-color-fore) 2.5%, transparent);"><button type="button" aria-label="Back" class="inline-flex shrink-0 items-center justify-center rounded-kro-pill outline-none focus-visible:shadow-[var(--kro-ring)]" style="min-width: var(--kro-size-min-touch-target); min-height: var(--kro-size-min-touch-target);"><span aria-hidden="true" class="inline-flex size-[30px] items-center justify-center rounded-kro-pill" style="background-color: color-mix(in srgb, var(--kro-color-fore) 8%, transparent); color: var(--kro-color-fore);"><svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-left" aria-hidden="true"><path d="m15 18-6-6 6-6"></path></svg></span></button><div class="flex min-w-0 flex-col gap-px"><p class="m-0 truncate text-base font-semibold" style="color: var(--kro-color-fore);">Triage</p><p class="m-0 truncate text-xs" style="color: var(--kro-color-fore-secondary);">Prepare presentation slides</p></div></header></div></div><div data-theme="light" data-slot="story-stage" style="display: flex; flex-direction: column; gap: var(--kro-space-medium); align-items: flex-start; padding: var(--kro-space-large); min-height: 160px; width: 100%; background: var(--kro-color-back); font-family: system-ui, sans-serif;"><div style="display: flex; flex-direction: column; gap: 8px; align-items: flex-start;"><span style="font-size: 11px; font-weight: 600; letter-spacing: 0.02em; color: v