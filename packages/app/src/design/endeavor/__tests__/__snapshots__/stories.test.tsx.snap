exports[`story snapshots > EmptyStateCard > Gallery 1`] = `"<div data-slot="story-gallery" style="display: flex; flex-direction: column; gap: var(--kro-space-large);"><div data-theme="light" data-slot="story-stage" style="display: flex; flex-direction: column; gap: var(--kro-space-medium); align-items: flex-start; padding: var(--kro-space-large); min-height: 160px; width: 460px; background: var(--kro-color-back); font-family: system-ui, sans-serif;"><div data-slot="surface-card" class="w-full overflow-hidden" style="padding: var(--kro-space-medium); background-color: var(--kro-color-absolute); border-radius: var(--kro-radius-surface); box-shadow: var(--kro-shadow-card);"><div data-slot="empty-state-card" class="flex w-full flex-col items-center gap-kro-small py-kro-small text-center"><svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-rotate-ccw-clock" aria-hidden="true" style="color: color-mix(in srgb, var(--kro-color-fore-secondary) 65%, transparent);"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path><path d="M3 3v5h5"></path><path d="M12 7v5l4 2"></path></svg><p class="m-0 text-sm font-semibold" style="color: var(--kro-color-fore);">No performances yet</p></div></div></div><div data-theme="light" data-slot="story-stage" style="display: flex; flex-direction: column; gap: var(--kro-space-medium); align-items: flex-start; padding: var(--kro-space-large); min-height: 160px; width: 460px; background: var(--kro-color-back); font-family: system-ui, sans-serif;"><div data-slot="surface-card" class="w-full overflow-hidden" style="padding: var(--kro-space-medium); background-color: var(--kro-color-absolute); border-radius: var(--kro-radius-surface); box-shadow: var(--kro-shadow-card);"><div data-slot="empty-state-card" class="flex w-full flex-col items-center gap-kro-small py-kro-small text-center"><svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-undo2 lucide-undo-2" aria-hidden="true" style="color: color-mix(in srgb, var(--kro-color-fore-secondary) 65%, transparent);"><path d="M9 14 4 9l5-5"></path><path d="M4 9h10.5a5.5 5.5 0 0 1 5.5 5.5a5.5 5.5 0 0 1-5.5 5.5H11"></path></svg><p class="m-0 text-sm font-semibold" style="color: var(--kro-color-fore);">Never deferred</p><p class="m-0 text-[13px]" style="color: var(--kro-color-fore-secondary);">Defers appear here each time you push this endeavor's due date back.</p></div></div></div><div data-theme="light" data-slot="story-stage" style="display: flex; flex-direction: column; gap: var(--kro-space-medium); align-items: flex-start; padding: var(--kro-space-large); min-height: 160px; width: 460px; background: var(--kro-color-back); font-family: system-ui, sans-serif;"><div data-slot="surface-card" class="w-full overflow-hidden" style="padding: var(--kro-space-medium); background-color: var(--kro-color-absolute); border-radius: var(--kro-radius-surface); box-shadow: var(--kro-shadow-card);"><div data-slot="empty-state-card" class="flex w-full flex-col items-center gap-kro-small py-kro-small text-center"><svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-network" aria-hidden="true" style="color: color-mix(in srgb, var(--kro-color-fore-secondary) 65%, transparent);"><rect x="16" y="16" width="6" height="6" rx="1"></rect><rect x="2" y="16" width="6" height="6" rx="1"></rect><rect x="9" y="2" width="6" height="6" rx="1"></rect><path d="M5 16v-3a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1v3"></path><path d="M12 12V8"></path></svg><p class="m-0 text-sm font-semibold" style="color: var(--kro-color-fore);">Not mirrored anywhere</p><p class="m-0 text-[13px]" style="color: var(--kro-color-fore-secondary);">Attach a calendar or reminders account to keep this endeavor in sync.</p><button type="button" class="mt-kro-tiny inline-flex items-center px-4 text-[13px] font-semibold outline-none focus-visible:shadow-[var(--kro-ring)]" style="min-height: var(--kro-size-min-touch-target); border-radius: var(--kro-radius-pill); background-color: var(--kro-color-accent); color: var(--kro-color-on-accent);">Attach a host</button></div></div></div><div style="display: grid; grid-template-columns: 1fr 1fr;"><div data-theme="light" data-slot="story-stage" style="display: flex; flex-direction: column; gap: var(--kro-space-medium); align-items: flex-start; padding: var(--kro-space-large); min-height: 160px; width: 100%; background: var(--kro-color-back); font-family: system-ui, sans-serif;"><div data-slot="surface-card" class="w-full overflow-hidden" style="padding: var(--kro-space-medium); background-color: var(--kro-color-absolute); border-radius: var(--kro-radius-surface); box-shadow: var(--kro-shadow-card);"><div data-slot="empty-state-card" class="flex w-full flex-col items-center gap-kro-small py-kro-small text-center"><svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-inbox" aria-hidden="true" style="color: color-mix(in srgb, var(--kro-color-fore-secondary) 65%, transparent);"><polyline points="22 12 16 12 14 15 10 15 8 12 2 12"></polyline><path d="M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z"></path></svg><p class="m-0 text-sm font-semibold" style="color: var(--kro-color-fore);">Nothing to triage</p><p class="m-0 text-[13px]" style="color: var(--kro-color-fore-secondary);">Captured endeavors land here first.</p><button type="button" class="mt-kro-tiny inline-flex items-center px-4 text-[13px] font-semibold outline-none focus-visible:shadow-[var(--kro-ring)]" style="min-height: var(--kro-size-min-touch-target); border-radius: var(--kro-radius-pill); background-color: var(--kro-color-accent); color: var(--kro-color-on-accent);">Capture something</button></div></div></div><div data-theme="dark" data-slot="story-stage" style="display: flex; flex-direction: column; gap: var(--kro-space-medium); align-items: flex-start; padding: var(--kro-space-large); min-height: 160px; width: 100%; background: var(--kro-color-back); font-family: system-ui, sans-serif;"><div data-slot="surface-card" class="w-full overflow-hidden" style="padding: var(--kro-space-medium); background-color: var(--kro-color-absolute); border-radius: var(--kro-radius-surface); box-shadow: var(--kro-shadow-card);"><div data-slot="empty-state-card" class="flex w-full flex-col items-center gap-kro-small py-kro-small text-center"><svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-inbox" aria-hidden="true" style="color: color-mix(in srgb, var(--kro-color-fore-secondary) 65%, transparent);"><polyline points="22 12 16 12 14 15 10 15 8 12 2 12"></polyline><path d="M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z"></path></svg><p class="m-0 text-sm font-semibold" style="color: var(--kro-color-fore);">Nothing to triage</p><p class="m-0 text-[13px]" style="color: var(--kro-color-fore-secondary);">Captured endeavors land here first.</p><button type="button" class="mt-kro-tiny inline-flex items-center px-4 text-[13px] font-semibold outline-none focus-visible:shadow-[var(--kro-ring)]" style="min-height: var(--kro-size-min-touch-target); border-radius: var(--kro-radius-pill); background-color: var(--kro-color-accent); color: var(--kro-color-on-accent);">Capture something</button></div></div></div></div></div>"`;

