exports[`story snapshots > SurfaceCard > Gallery 1`] = `"<div data-slot="story-gallery" style="display: flex; flex-direction: column; gap: var(--kro-space-large);"><div data-theme="light" data-slot="story-stage" style="display: flex; flex-direction: column; gap: var(--kro-space-medium); align-items: flex-start; padding: var(--kro-space-large); min-height: 160px; width: 460px; background: var(--kro-color-back); font-family: system-ui, sans-serif;"><div data-slot="surface-card" class="w-full overflow-hidden" style="padding: var(--kro-space-medium); background-color: var(--kro-color-absolute); border-radius: var(--kro-radius-surface); box-shadow: var(--kro-shadow-card);"><p style="margin: 0px; color: var(--kro-color-fore);">Two sessions logged this week.</p></div><div style="display: flex; flex-direction: column; gap: 8px; align-items: flex-start;"><span style="font-size: 11px; font-weight: 600; letter-spacing: 0.02em; color: var(--kro-color-fore-secondary);">isElevated={false}</span><div data-slot="surface-card" class="w-full overflow-hidden" style="padding: var(--kro-space-medium); background-color: var(--kro-color-absolute); border-radius: var(--kro-radius-surface);"><p style="margin: 0px; color: var(--kro-color-fore);">Flat, for a nested card.</p></div></div></div><div data-theme="light" data-slot="story-stage" style="display: flex; flex-direction: column; gap: var(--kro-space-medium); align-items: flex-start; padding: var(--kro-space-large); min-height: 160px; width: 460px; background: var(--kro-color-back); font-family: system-ui, sans-serif;"><section class="flex w-full flex-col gap-kro-small"><header class="flex items-center gap-kro-small px-kro-tiny"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-info" aria-hidden="true" style="color: var(--kro-color-fore-secondary);"><circle cx="12" cy="12" r="10"></circle><path d="M12 16v-4"></path><path d="M12 8h.01"></path></svg><h2 class="m-0 text-[13px] font-semibold uppercase tracking-wide" style="color: var(--kro-color-fore-secondary);">Core</h2><span class="flex-1"></span></header><div data-slot="surface-card" class="w-full overflow-hidden" style="background-color: var(--kro-color-absolute); border-radius: var(--kro-radius-surface); box-shadow: var(--kro-shadow-card);"><div data-slot="card-row-stack" class="flex w-full flex-col"><div data-slot="card-row" class="px-kro-medium py-2.5"><div data-slot="property-row" data-stacked="false" class="flex min-h-7 w-full gap-3 flex-row flex-wrap items-baseline justify-between max-[26rem]:flex-col max-[26rem]:items-start"><span class="flex shrink-0 items-center gap-kro-small"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle shrink-0" aria-hidden="true" style="color: var(--kro-color-fore-secondary); width: var(--kro-size-row-icon-column);"><circle cx="12" cy="12" r="10"></circle></svg><span class="text-sm" style="color: var(--kro-color-fore-secondary);">Status</span></span><span aria-hidden="true" class="min-w-0 text-right"><span data-emphasis="soft" class="inline-flex max-w-full shrink-0 items-center rounded-kro-pill font-semibold gap-1 px-2 py-1 text-[11px]" style="background-color: color-mix(in srgb, var(--kro-role-status-pending) 16%, transparent); color: var(--kro-role-status-pending);"><svg xmlns="http://www.w3.org/2000/svg" width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle></svg><span class="truncate">Pending</span></span></span><span class="sr-only">Pending</span></div></div><div aria-hidden="true" data-slot="card-row-separator" style="height: 0.75