exports[`story snapshots > KroChip > Emphasis 1`] = `"<div data-theme="light" data-slot="story-stage" style="display: flex; flex-direction: column; gap: var(--kro-space-medium); align-items: flex-start; padding: var(--kro-space-large); min-height: 160px; width: 100%; background: var(--kro-color-back); font-family: system-ui, sans-serif;"><div style="display: flex; flex-direction: column; gap: 8px; align-items: flex-start;"><span style="font-size: 11px; font-weight: 600; letter-spacing: 0.02em; color: var(--kro-color-fore-secondary);">prominent — the one identity chip on a surface</span><span data-emphasis="prominent" class="inline-flex max-w-full shrink-0 items-center rounded-kro-pill font-semibold gap-[5px] px-2.5 py-1.5 text-xs" style="background-color: var(--kro-role-kind-task); color: var(--kro-color-absolute);"><svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-check" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="m16 9-5.5 5.5L8 12"></path></svg><span class="truncate">Task</span></span></div><div style="display: flex; flex-direction: column; gap: 8px; align-items: flex-start;"><span style="font-size: 11px; font-weight: 600; letter-spacing: 0.02em; color: var(--kro-color-fore-secondary);">soft — the workhorse</span><span data-emphasis="soft" class="inline-flex max-w-full shrink-0 items-center rounded-kro-pill font-semibold gap-[5px] px-2.5 py-1.5 text-xs" style="background-color: color-mix(in srgb, var(--kro-role-status-pending) 16%, transparent); color: var(--kro-role-status-pending);"><svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle></svg><span class="truncate">Pending</span></span></div><div style="display: flex; flex-direction: column; gap: 8px; align-items: flex-start;"><span style="font-size: 11px; font-weight: 600; letter-spacing: 0.02em; color: var(--kro-color-fore-secondary);">outline — de-emphasised or unavailable</span><span data-emphasis="outline" class="inline-flex max-w-full shrink-0 items-center rounded-kro-pill font-semibold gap-[5px] px-2.5 py-1.5 text-xs" style="color: var(--kro-role-chip-neutral); box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--kro-role-chip-neutral) 55%, transparent);"><svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-x" aria-hidden="true"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg><span class="truncate">Not attached</span></span></div><div style="display: flex; flex-direction: column; gap: 8px; align-items: flex-start;"><span style="font-size: 11px; font-weight: 600; letter-spacing: 0.02em; color: var(--kro-color-fore-secondary);">small</span><span data-emphasis="soft" class="inline-flex max-w-full shrink-0 items-center rounded-kro-pill font-semibold gap-1 px-2 py-1 text-[11px]" style="background-color: color-mix(in srgb, var(--kro-color-badge-indigo) 16%, transparent); color: var(--kro-color-badge-indigo);"><svg xmlns="http://www.w3.org/2000/svg" width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-tag" aria-hidden="true"><path d="M12.586 2.586A2 2 0 0 0 11.172 2H4a2 2 0 0 0-2 2v7.172a2 2 0 0 0 .586 1.414l8.704 8.704a2.426 2.426 0 0 0 3.42 0l6.58-6.58a2.426 2.426 0 0 0 0-3.42z"></path><circle cx="7.5" cy="7.5" r=".5" fill="currentColor"></circle></svg><span class="truncate">Engaging</span></span></div></div>"`;

