exports[`story snapshots > EndeavorActionSurface > Gallery 1`] = `"<div data-slot="story-gallery" style="display: flex; flex-direction: column; gap: var(--kro-space-large);"><div data-theme="light" data-slot="story-stage" style="display: flex; flex-direction: column; gap: var(--kro-space-medium); align-items: flex-start; padding: var(--kro-space-large); min-height: 160px; width: 520px; background: var(--kro-color-back); font-family: system-ui, sans-serif;"><div style="display: flex; flex-direction: column; gap: 8px; align-items: flex-start;"><span style="font-size: 11px; font-weight: 600; letter-spacing: 0.02em; color: var(--kro-color-fore-secondary);">Drag right for the leading action, left for the trailing ones</span><div data-slot="endeavor-action-surface" data-input="touch" data-pointer-gutter="0" class="group relative isolate w-full overflow-hidden" style="border-radius: var(--kro-radius-surface); --kro-endeavor-pointer-gutter: 0px;"><div data-slot="endeavor-swipe-leading" aria-hidden="true" class="absolute inset-y-0 z-0 flex items-stretch gap-2 p-1 left-0"><button type="button" tabindex="-1" aria-label="Start Session" class="inline-flex flex-col items-center justify-center gap-0.5 px-3 text-[11px] font-semibold outline-none focus-visible:shadow-[var(--kro-ring)]" style="min-width: var(--kro-size-min-touch-target); border-radius: var(--kro-radius-field); background-color: var(--kro-color-badge-green); color: var(--kro-color-absolute);"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-play" aria-hidden="true"><path d="M9 9.003a1 1 0 0 1 1.517-.859l4.997 2.997a1 1 0 0 1 0 1.718l-4.997 2.997A1 1 0 0 1 9 14.996z"></path><circle cx="12" cy="12" r="10"></circle></svg>Start Session</button></div><div data-slot="endeavor-swipe-trailing" aria-hidden="true" class="absolute inset-y-0 z-0 flex items-stretch gap-2 p-1 right-0"><button type="button" tabindex="-1" aria-label="Delete" class="inline-flex flex-col items-center justify-center gap-0.5 px-3 text-[11px] font-semibold outline-none focus-visible:shadow-[var(--kro-ring)]" style="min-width: var(--kro-size-min-touch-target); border-radius: var(--kro-radius-field); background-color: var(--kro-color-badge-red); color: var(--kro-color-absolute);"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-trash2 lucide-trash-2" aria-hidden="true"><path d="M10 11v6"></path><path d="M14 11v6"></path><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"></path><path d="M3 6h18"></path><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>Delete</button></div><div data-slot="endeavor-action-content" style="transform: translateX(0px); transition: transform 240ms var(--kro-ease-standard); position: relative; z-index: 1;"><div data-slot="endeavor-row" data-config="inbox" class="flex w-full items-center" style="gap: 14px; min-height: 80px; padding: 14px 16px; border-radius: var(--kro-radius-surface); background-color: var(--kro-color-absolute); box-shadow: var(--kro-shadow-card);"><span aria-hidden="true" class="inline-flex shrink-0 items-center justify-center" style="width: 56px; height: 56px; font-size: 39px;">💻</span><div class="flex min-w-0 flex-1 flex-col gap-1.5"><p class="m-0 text-base font-bold" style="color: var(--kro-color-fore); display: -webkit-box; -webkit-line-clamp: 1; overflow: hidden;">Review pull request changes</p><div class="flex flex-wrap items-center gap-1.5"><span role="img" aria-label="Medium" class="inline-flex h-5 shrink-0 items-center gap-0.5 rounded-kro-pill px-1.5 py-[3px] text-[11px] font-bold leading-none" style="background-color: var(--kro-color-athens-gray); color: var(--kro-color-banner-warning);"><svg xmlns="http://www.w3.org/2000/svg" width="10" height="10