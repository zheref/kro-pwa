exports[`story snapshots > InlineBanner > Gallery 1`] = `"<div data-slot="story-gallery" style="display: flex; flex-direction: column; gap: var(--kro-space-large);"><div data-theme="light" data-slot="story-stage" style="display: flex; flex-direction: column; gap: var(--kro-space-medium); align-items: flex-start; padding: var(--kro-space-large); min-height: 160px; width: 520px; background: var(--kro-color-back); font-family: system-ui, sans-serif;"><div style="display: flex; flex-direction: column; gap: 8px; align-items: flex-start;"><span style="font-size: 11px; font-weight: 600; letter-spacing: 0.02em; color: var(--kro-color-fore-secondary);">error</span><div role="status" data-kind="error" data-layout="multiline" data-density="compact" class="flex w-full gap-2.5 rounded-kro-field p-3 items-start" style="background-color: var(--kro-color-banner-danger); color: var(--kro-color-snow);"><span class="sr-only">Error: </span><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-triangle-alert mt-px shrink-0" aria-hidden="true"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3"></path><path d="M12 9v4"></path><path d="M12 17h.01"></path></svg><div class="flex min-w-0 flex-1 flex-col items-stretch gap-2"><p class="m-0 text-[13px] font-semibold leading-snug">Google Calendar rejected the change.</p></div></div></div><div style="display: flex; flex-direction: column; gap: 8px; align-items: flex-start;"><span style="font-size: 11px; font-weight: 600; letter-spacing: 0.02em; color: var(--kro-color-fore-secondary);">warning</span><div role="status" data-kind="warning" data-layout="multiline" data-density="compact" class="flex w-full gap-2.5 rounded-kro-field p-3 items-start" style="background-color: var(--kro-color-banner-warning); color: var(--kro-color-snow);"><span class="sr-only">Warning: </span><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-alert mt-px shrink-0" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><line x1="12" x2="12" y1="8" y2="12"></line><line x1="12" x2="12.01" y1="16" y2="16"></line></svg><div class="flex min-w-0 flex-1 flex-col items-stretch gap-2"><p class="m-0 text-[13px] font-semibold leading-snug">This endeavor is past its expiry.</p><p class="m-0 text-[13px] leading-snug" style="color: rgba(255, 255, 255, 0.7);">It will stop appearing in Do at midnight.</p></div></div></div><div style="display: flex; flex-direction: column; gap: 8px; align-items: flex-start;"><span style="font-size: 11px; font-weight: 600; letter-spacing: 0.02em; color: var(--kro-color-fore-secondary);">info</span><div role="status" data-kind="info" data-layout="multiline" data-density="compact" class="flex w-full gap-2.5 rounded-kro-field p-3 items-start" style="background-color: var(--kro-color-back-inner); color: var(--kro-color-fore);"><span class="sr-only">Note: </span><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-info mt-px shrink-0" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M12 16v-4"></path><path d="M12 8h.01"></path></svg><div class="flex min-w-0 flex-1 flex-col items-stretch gap-2"><p class="m-0 text-[13px] font-semibold leading-snug">This endeavor's kind doesn't support editing performances.</p></div></div></div><div style="display: flex; flex-direction: column; gap: 8px; align-items: flex-start;"><span style="font-size: 11px; font-weight: 600; letter-spacing: 0.02em; color: var(--kro-color-fore-secondary);">success</span><div role="status" data-kind="success" data-layout="multiline" data-density="compact" class="flex w-full gap-2.5 rounded-kro-field p-3 items-start" style="background-color: var(--kro-color-focus-green); color: var(--kro-color-snow);"><span class="sr-only">Success: </span><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-check mt-px shrink-0" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="m16 9-5.5 5.5L8 12"></path></svg><div class="flex min-w-0 flex-1 flex-col items-stretch gap-2"><p class="m-0 text-[13px] font-semibold leading-snug">Saved to the plan.</p></div><button type="button" aria-label="Dismiss" class="inline-flex shrink-0 items-center justify-center size-6 rounded-kro-small outline-none focus-visible:shadow-[var(--kro-ring)]" style="color: var(--kro-color-snow);"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-x" aria-hidden="true"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg></button></div></div></div><div data-theme="light" data-slot="story-stage" style="display: flex; flex-direction: column; gap: var(--kro-space-medium); align-items: flex-start; padding: var(--kro-space-large); min-height: 160px; width: 520px; background: var(--kro-color-back); font-family: system-ui, sans-serif;"><div role="status" data-kind="error" data-layout="multiline" data-density="compact" class="flex w-full gap-2.5 rounded-kro-field p-3 items-start" style="background-color: var(--kro-color-banner-danger); color: var(--kro-color-snow);"><span class="sr-only">Error: </span><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-triangle-alert mt-px shrink-0" aria-hidden="true"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3"></path><path d="M12 9v4"></path><path d="M12 17h.01"></path></svg><div class="flex min-w-0 flex-1 flex-col items-stretch gap-2"><p class="m-0 text-[13px] font-semibold leading-snug">Google Calendar rejected the change.</p><p class="m-0 text-[13px] leading-snug" style="color: rgba(255, 255, 255, 0.7);">The event may have been deleted on the host.</p><button type="button" class="inline-flex w-fit shrink-0 items-center rounded-kro-small px-3 h-6 text-[13px] font-semibold underline underline-offset-2 outline-none focus-visible:shadow-[var(--kro-ring)]" style="color: var(--kro-color-snow);">Try again</button></div></div></div><div data-theme="light" data-slot="story-stage" style="display: flex; flex-direction: column; gap: var(--kro-space-medium); align-items: flex-start; padding: var(--kro-space-large); min-height: 160px; width: 420px; background: var(--kro-color-back); font-family: system-ui, sans-serif;"><div role="status" data-kind="warning" data-layout="multiline" data-density="compact" class="flex w-full gap-2.5 rounded-kro-field p-3 items-start" style="background-color: var(--kro-color-banner-warning); color: var(--kro-color-snow);"><span class="sr-only">Warning: </span><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-alert mt-px shrink-0" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><line x1="12" x2="12" y1="8" y2="12"></line><line x1="12" x2="12.01" y1="16" y2="16"></line></svg><div class="flex min-w-0 flex-1 flex-col items-stretch gap-2"><p class="m-0 text-[13px] font-semibold leading-snug">Rescheduling failed because the quarterly budget reconciliation report needs another department's sign-off before it can be finalized and submitted.</p><button type="button" class="inline-flex w-fit shrink-0 items-center rounded-kro-small px-3 h-6 text-[13px] font-semibold underline underline-offset-2 outline-none focus-visible:shadow-[var(--kro-ring)]" style="color: var(--kro-color-snow);">Open the report</button></div></div></div><div style="display: grid; grid-template-columns: 1fr 1fr;"><div data-theme="light" data-slot="story-stage" style="display: flex; flex-direction: column; gap: var(--kro-space-medium); align-items: flex-start; padding: var(--kro-space-large); min-height: 160px; width: 100%; background: var(--kro-color-back); font-family: system-ui, sans-serif;"><div role="status" data-kind="error" data-layout="multiline" data-density="compact" class="flex w-full gap-2.5 rounded-kro-field p-3 items-start" style="background-color: var(--kro-color-banner-danger); color: var(--kro-color-snow);"><span class="sr-only">Error: </span><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-triangle-alert mt-px shrink-0" aria-hidden="true"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3"></path><path d="M12 9v4"></path><path d="M12 17h.01"></path></svg><div class="flex min-w-0 flex-1 flex-col items-stretch gap-2"><p class="m-0 text-[13px] font-semibold leading-snug">You're offline — this host will sync once you're back online.</p></div></div><div role="status" data-kind="warning" data-layout="multiline" data-density="compact" class="flex w-full gap-2.5 rounded-kro-field p-3 items-start" style="background-color: var(--kro-color-banner-warning); color: var(--kro-color-snow);"><span class="sr-only">Warning: </span><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-alert mt-px shrink-0" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><line x1="12" x2="12" y1="8" y2="12"></line><line x1="12" x2="12.01" y1="16" y2="16"></line></svg><div class="flex min-w-0 flex-1 flex-col items-stretch gap-2"><p class="m-0 text-[13px] font-semibold leading-snug">Two hosts disagree about this endeavor.</p></div></div><div role="status" data-kind="info" data-layout="multiline" data-density="compact" class="flex w-full gap-2.5 rounded-kro-field p-3 items-start" style="background-color: var(--kro-color-back-inner); color: var(--kro-color-fore);"><span class="sr-only">Note: </span><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-info mt-px shrink-0" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M12 16v-4"></path><path d="M12 8h.01"></path></svg><div class="flex min-w-0 flex-1 flex-col items-stretch gap-2"><p class="m-0 text-[13px] font-semibold leading-snug">Read-only: this host does not accept edits.</p></div></div></div><div data-theme="dark" data-slot="story-stage" style="display: flex; flex-direction: column; gap: var(--kro-space-medium); align-items: flex-start; padding: var(--kro-space-large); min-height: 160px; width: 100%; background: var(--kro-color-back); font-family: system-ui, sans-serif;"><div role="status" data-kind="error" data-layout="multiline" data-density="compact" class="flex w-full gap-2.5 rounded-kro-field p-3 items-start" style="background-color: var(--kro-color-banner-danger); color: var(--kro-color-snow);"><span class="sr-only">Error: </span><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-triangle-alert mt-px shrink-0" aria-hidden="true"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3"></path><path d="M12 9v4"></path><path d="M12 17h.01"></path></svg><div class="flex min-w-0 flex-1 flex-col items-stretch gap-2"><p class="m-0 text-[13px] font-semibold leading-snug">You're offline — this host will sync once you're back online.</p></div></div><div role="status" data-kind="warning" data-layout="multiline" data-density="compact" class="flex w-full gap-2.5 rounded-kro-field p-3 items-start" style="background-color: var(--kro-color-banner-warning); color: var(--kro-color-snow);"><span class="sr-only">Warning: </span><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-alert mt-px shrink-0" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><line x1="12" x2="12" y1="8" y2="12"></line><line x1="12" x2="12.01" y1="16" y2="16"></line></svg><div class="flex min-w-0 flex-1 flex-col items-stretch gap-2"><p class="m-0 text-[13px] font-semibold leading-snug">Two hosts disagree about this endeavor.</p></div></div><div role="status" data-kind="info" data-layout="multiline" data-density="compact" class="flex w-full gap-2.5 rounded-kro-field p-3 items-start" style="background-color: var(--kro-color-back-inner); color: var(--kro-color-fore);"><span class="sr-only">Note: </span><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-info mt-px shrink-0" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M12 16v-4"></path><path d="M12 8h.01"></path></svg><div class="flex min-w-0 flex-1 flex-col items-stretch gap-2"><p class="m-0 text-[13px] font-semibold leading-snug">Read-only: this host does not accept edits.</p></div></div></div></div></div>"`;

exports[`story snapshots > KroChip > Gallery 1`] = `"<div data-slot="story-gallery" style="display: flex; flex-direction: column; gap: var(--kro-space-large);"><div data-theme="light" data-slot="story-stage" style="display: flex; flex-direction: column; gap: var(--kro-space-medium); align-items: flex-start; padding: var(--kro-space-large); min-height: 160px; width: 100%; background: var(--kro-color-back); font-family: system-ui, sans-serif;"><div style="display: flex; flex-direction: column; gap: 8px; align-items: flex-start;"><span style="font-size: 11px; font-weight: 600; letter-spacing: 0.02em; color: var(--kro-color-fore-secondary);">prominent — the one identity chip on a surface</span><span data-emphasis="prominent" class="inline-flex max-w-full shrink-0 items-center rounded-kro-pill font-semibold gap-[5px] px-2.5 py-1.5 text-xs" style="background-color: var(--kro-role-kind-task); color: var(--kro-color-absolute);"><svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-check" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="m16 9-5.5 5.5L8 12"></path></svg><span class="truncate">Task</span></span></div><div style="display: flex; flex-direction: column; gap: 8px; align-items: flex-start;"><span style="font-size: 11px; font-weight: 600; letter-spacing: 0.02em; color: var(--kro-color-fore-secondary);">soft — the workhorse</span><span data-emphasis="soft" class="inline-flex max-w-full shrink-0 items-center rounded-kro-pill font-semibold gap-[5px] px-2.5 py-1.5 text-xs" style="background-color: color-mix(in srgb, var(--kro-role-status-pending) 16%, transparent); color: var(--kro-role-status-pending);"><svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle></svg><span class="truncate">Pending</span></span></div><div style="display: flex; flex-direction: column; gap: 8px; align-items: flex-start;"><span style="font-size: 11px; font-weight: 600; letter-spacing: 0.02em; color: var(--kro-color-fore-secondary);">outline — de-emphasised or unavailable</span><span data-emphasis="outline" class="inline-flex max-w-full shrink-0 items-center rounded-kro-pill font-semibold gap-[5px] px-2.5 py-1.5 text-xs" style="color: var(--kro-role-chip-neutral); box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--kro-role-chip-neutral) 55%, transparent);"><svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-x" aria-hidden="true"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg><span class="truncate">Not attached</span></span></div><div style="display: flex; flex-direction: column; gap: 8px; align-items: flex-start;"><span style="font-size: 11px; font-weight: 600; letter-spacing: 0.02em; color: var(--kro-color-fore-secondary);">small</span><span data-emphasis="soft" class="inline-flex max-w-full shrink-0 items-center rounded-kro-pill font-semibold gap-1 px-2 py-1 text-[11px]" style="background-color: color-mix(in srgb, var(--kro-color-badge-indigo) 16%, transparent); color: var(--kro-color-badge-indigo);"><svg xmlns="http://www.w3.org/2000/svg" width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-tag" aria-hidden="true"><path d="M12.586 2.586A2 2 0 0 0 11.172 2H4a2 2 0 0 0-2 2v7.172a2 2 0 0 0 .586 1.414l8.704 8.704a2.426 2.426 0 0 0 3.42 0l6.58-6.58a2.426 2.426 0 0 0 0-3.42z"></path><circle cx="7.5" cy="7.5" r=".5" fill="currentColor"></circle></svg><span class="truncate">Engaging</span></span></div><