ejoin="round" class="lucide lucide-circle-alert" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><line x1="12" x2="12" y1="8" y2="12"></line><line x1="12" x2="12.01" y1="16" y2="16"></line></svg>Medium</span><span role="img" aria-label="30 reward points" class="inline-flex h-5 shrink-0 items-center gap-0.5 rounded-kro-pill px-1.5 py-[3px] text-[11px] font-bold leading-none" style="background-color: var(--kro-color-scotch-mist); color: var(--kro-color-banner-warning);"><svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-zap" aria-hidden="true"><path d="M15.914 4a1.5 1.5 0 00-2.474-1.561l-9 9A1.5 1.5 0 005.5 14h4.002a.5.5 0 01.471.666L8.086 20a1.5 1.5 0 002.475 1.56l9-9A1.5 1.5 0 0018.5 10h-3.997a.5.5 0 01-.472-.667z"></path></svg>30</span></div></div></div></div><button type="button" aria-label="Actions for Review pull request changes" class="absolute top-1 right-1 z-3 inline-flex size-7 items-center justify-center rounded-kro-small opacity-0 outline-none group-hover:opacity-100 group-focus-within:opacity-100 focus-visible:opacity-100 pointer-events-none group-hover:pointer-events-auto group-focus-within:pointer-events-auto focus-visible:pointer-events-auto focus-visible:shadow-[var(--kro-ring)]" style="color: var(--kro-color-fore-secondary);" id="<id>" aria-haspopup="menu" aria-expanded="false" data-state="closed"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-ellipsis" aria-hidden="true"><circle cx="12" cy="12" r="1"></circle><circle cx="19" cy="12" r="1"></circle><circle cx="5" cy="12" r="1"></circle></svg></button></div></div></div>"`;

exports[`story snapshots > EndeavorActionSurface > TouchWithTrailingButtons 1`] = `"<div data-theme="light" data-slot="story-stage" style="display: flex; flex-direction: column; gap: var(--kro-space-medium); align-items: flex-start; padding: var(--kro-space-large); min-height: 160px; width: 520px; background: var(--kro-color-back); font-family: system-ui, sans-serif;"><div style="display: flex; flex-direction: column; gap: 8px; align-items: flex-start;"><span style="font-size: 11px; font-weight: 600; letter-spacing: 0.02em; color: var(--kro-color-fore-secondary);">Tap Triage. A swipe still swipes; a tap must reach the button.</span><div style="width: 460px; display: grid; gap: 12px;"><div data-slot="endeavor-action-surface" data-input="touch" data-pointer-gutter="0" class="group relative isolate w-full overflow-hidden" style="border-radius: var(--kro-radius-surface); --kro-endeavor-pointer-gutter: 0px;"><div data-slot="endeavor-swipe-trailing" aria-hidden="true" class="absolute inset-y-0 z-0 flex items-stretch gap-2 p-1 right-0"><button type="button" tabindex="-1" aria-label="Complete" class="inline-flex flex-col items-center justify-center gap-0.5 px-3 text-[11px] font-semibold outline-none focus-visible:shadow-[var(--kro-ring)]" style="min-width: var(--kro-size-min-touch-target); border-radius: var(--kro-radius-field); background-color: var(--kro-color-badge-green); color: var(--kro-color-absolute);"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-check-big" aria-hidden="true"><path d="M21.801 10A10 10 0 1 1 17 3.335"></path><path d="m9 11 3 3L22 4"></path></svg>Complete</button><button type="button" tabindex="-1" aria-label="Delete" class="inline-flex flex-col items-center justify-center gap-0.5 px-3 text-[11px] font-semibold outline-none focus-visible:shadow-[var(--kro-ring)]" style="min-width: var(--kro