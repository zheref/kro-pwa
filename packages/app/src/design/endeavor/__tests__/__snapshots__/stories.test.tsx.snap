exports[`story snapshots > EndeavorCard > BadgeMatrix 1`] = `"<div data-theme="light" data-slot="story-stage" style="display: flex; flex-direction: column; gap: var(--kro-space-medium); align-items: flex-start; padding: var(--kro-space-large); min-height: 160px; width: 100%; background: linear-gradient(135deg, var(--kro-color-header-gradient-indigo), var(--kro-color-header-gradient-grape)); font-family: system-ui, sans-serif;"><div style="display: flex; flex-direction: column; gap: 12px;"><h3 style="margin: 0px; color: rgb(255, 255, 255); font-size: 15px;">Do mode</h3><div style="display: flex; gap: 20px; flex-wrap: wrap;"><div style="display: flex; flex-direction: column; gap: 8px; align-items: flex-start;"><span style="font-size: 11px; font-weight: 600; letter-spacing: 0.02em; color: var(--kro-color-fore-secondary);">low · ⚡10 · task</span><div data-slot="endeavor-card" data-layout="vertical" data-selected="false" data-mark-complete-mode="false" class="relative" style="transform: rotate(0deg); transition: transform 180ms ease-out;"><div data-slot="endeavor-card-shell" class="relative flex flex-col overflow-hidden" style="width: 160px; height: 200px; border-radius: var(--kro-radius-surface); background-color: var(--kro-color-absolute); box-shadow: var(--kro-shadow-card);"><div data-slot="endeavor-card-content" class="absolute inset-0 flex flex-col p-3" style="transition: filter 200ms var(--kro-ease-standard);"><div class="flex items-start justify-between gap-1"><span></span><span role="img" aria-label="10 reward points" class="inline-flex h-5 shrink-0 items-center gap-0.5 rounded-kro-pill px-1.5 py-[3px] text-[11px] font-bold leading-none" style="background-color: var(--kro-color-scotch-mist); color: var(--kro-color-banner-warning);"><svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-zap" aria-hidden="true"><path 