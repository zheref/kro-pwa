exports[`story snapshots > EndeavorCard > MarkCompleteMode 1`] = `"<div data-theme="light" data-slot="story-stage" style="display: flex; flex-direction: column; gap: var(--kro-space-medium); align-items: flex-start; padding: var(--kro-space-large); min-height: 160px; width: 100%; background: linear-gradient(135deg, var(--kro-color-header-gradient-indigo), var(--kro-color-header-gradient-grape)); font-family: system-ui, sans-serif;"><p style="margin: 0px; color: rgba(255, 255, 255, 0.8); font-size: 13px;">The cards tilt ±0.35° on a 0.32s half-period. Turn on Reduce Motion and reload: the tilt stops and the cards settle to exactly 0°.</p><div style="display: flex; gap: 20px;"><div data-slot="endeavor-card" data-layout="vertical" data-selected="false" data-mark-complete-mode="true" class="relative" style="transform: rotate(0.35deg); transition: transform 320ms ease-in-out;"><div data-slot="endeavor-card-shell" class="relative flex flex-col overflow-hidden" style="width: 160px; height: 200px; border-radius: var(--kro-radius-surface); background-color: var(--kro-color-absolute); box-shadow: var(--kro-shadow-card);"><div data-slot="endeavor-card-content" class="absolute inset-0 flex flex-col p-3" style="transition: filter 200ms var(--kro-ease-standard);"><div class="flex items-start justify-between gap-1"><span role="img" aria-label="High" class="inline-flex h-5 shrink-0 items-center gap-0.5 rounded-kro-pill px-1.5 py-[3px] text-[11px] font-bold leading-none" style="background-color: var(--kro-color-athens-gray); color: var(--kro-color-banner-danger);"><svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-alert" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><line x1="12" x2="12" y1="8" y2="12"></line><line x1="12" x2="12.01" y1="16" y2="16"></line></svg>High</span><span role="img" aria-label="50 reward points" class="inline-flex h-5 shrink-0 items-center gap-0.5 rounded-kro-pill px-1.5 py-[3px] text-[11px] font-bold leading-none" style="background-color: var(--kro-color-scotch-mist); color: var(--kro-color-banner-warning);"><svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-zap" aria-hidden="true"><path d="M15.914 4a1.5 1.5 0 00-2.474-1.561l-9 9A1.5 1.5 0 005.5 14h4.002a.5.5 0 01.471.666L8.086 20a1.5 1.5 0 002.475 1.56l9-9A1.5 1.5 0 0018.5 10h-3.997a.5.5 0 01-.472-.667z"></path></svg>50</span></div><div class="flex flex-1 flex-col items-center justify-center gap-1 px-1 text-center"><span class="relative inline-flex"><span aria-hidden="true" style="font-size: 44px; line-height: 1;">📊</span><span class="absolute top-0 right-0" style="transform: translate(14px, -8px);"><button type="button" aria-label="Mark complete" tabindex="0" class="inline-flex shrink-0 items-center justify-center rounded-kro-pill outline-none focus-visible:shadow-[var(--kro-ring)]" style="width: 28px; height: 28px; background-color: var(--kro-color-complete-blue); color: var(--kro-color-snow); box-shadow: var(--kro-shadow-subtle);" aria-haspopup="dialog" aria-expanded="false" data-state="closed"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-check" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg></button></span></span><button type="button" class="m-0 line-clamp-2 max-w-full font-bold outline-none focus-visible:shadow-[var(--kro-ring)] text-sm" style="color: var(--kro-color-fore);">Prepare presentation slides</button></div><div class="flex flex-col items-center gap-0.5"><span class="inline-flex items-center gap-1 text-[11px]" style="color: var(--kro-color-fore-secondary);"><svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-clock" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M12 6v6l4 2"></path></svg>1:15 PM</span><span class="inline-flex items-center gap-1 text-[11px]" style="color: var(--kro-color-fore-secondary);"><svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-timer" aria-hidden="true"><line x1="10" x2="14" y1="2" y2="2"></line><line x1="12" x2="15" y1="14" y2="11"></line><circle cx="12" cy="14" r="8"></circle></svg>45m</span></div></div><div data-slot="endeavor-card-prep-overlay" aria-hidden="true" class="absolute inset-0 flex flex-col items-center justify-center" style="gap: 10px; opacity: 0; pointer-events: none; transition: opacity 200ms var(--kro-ease-standard);"><button type="button" aria-label="Mark complete" tabindex="-1" class="inline-flex shrink-0 items-center justify-center rounded-kro-pill outline-none focus-visible:shadow-[var(--kro-ring)]" style="width: 38px; height: 38px; background-color: var(--kro-color-complete-blue); color: var(--kro-color-snow); box-shadow: var(--kro-shadow-subtle);" aria-haspopup="dialog" aria-expanded="false" data-state="closed"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-check" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg></button><button type="button" aria-label="Start" tabindex="-1" class="inline-flex shrink-0 items-center justify-center rounded-kro-pill outline-none focus-visible:shadow-[var(--kro-ring)]" style="width: 54px; height: 54px; font-size: 24px; background-color: var(--kro-color-badge-green); color: v