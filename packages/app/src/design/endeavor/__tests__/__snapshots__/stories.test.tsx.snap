.w3.org/2000/svg" width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-repeat2 lucide-repeat-2" aria-hidden="true"><path d="m2 9 3-3 3 3"></path><path d="M13 18H7a2 2 0 0 1-2-2V6"></path><path d="m22 15-3 3-3-3"></path><path d="M11 6h6a2 2 0 0 1 2 2v10"></path></svg><span class="truncate">Habit</span></span><span data-emphasis="soft" class="inline-flex max-w-full shrink-0 items-center rounded-kro-pill font-semibold gap-1 px-2 py-1 text-[11px]" style="background-color: color-mix(in srgb, var(--kro-role-chip-neutral) 16%, transparent); color: var(--kro-role-chip-neutral);"><svg xmlns="http://www.w3.org/2000/svg" width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-check" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="m16 9-5.5 5.5L8 12"></path></svg><span class="truncate">Closed</span></span></div></div></div></div>"`;

exports[`story snapshots > EndeavorRow > InboxWithTrailingActions 1`] = `"<div data-theme="light" data-slot="story-stage" style="display: flex; flex-direction: column; gap: var(--kro-space-medium); align-items: flex-start; padding: var(--kro-space-large); min-height: 160px; width: 100%; background: var(--kro-color-back); font-family: system-ui, sans-serif;"><div style="width: 560px; display: flex; flex-direction: column; gap: 12px;"><div data-slot="endeavor-row" data-config="inbox" class="flex w-full items-center" style="gap: 14px; min-height: 80px; padding-right: calc(16px + var(--kro-endeavor-pointer-gutter, 0px)); border-radius: var(--kro-radius-surface); background-color: var(--kro-color-absolute); box-shadow: var(--kro-shadow-card);"><span aria-hidden="true" class="inline-flex shrink-0 items-center justify-center" style="width: 56px; height: 56px; font-size: 39px;">📊</span><div class="flex min-w-0 flex-1 flex-col gap-1.5"><p class="m-0 text-base font-bold" style="color: var(--kro-color-fore); display: -webkit-box; -webkit-line-clamp: 1; overflow: hidden;">Prepare presentation slides</p><div class="flex flex-wrap items-center gap-1.5"><span role="img" aria-label="High" class="inline-flex h-5 shrink-0 items-center gap-0.5 rounded-kro-pill px-1.5 py-[3px] text-[11px] font-bold leading-none" style="background-color: var(--kro-color-athens-gray); color: var(--kro-color-banner-danger);"><svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-alert" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><line x1="12" x2="12" y1="8" y2="12"></line><line x1="12" x2="12.01" y1="16" y2="16"></line></svg>High</span><span role="img" aria-label="50 reward points" class="inline-flex h-5 shrink-0 items-center gap-0.5 rounded-kro-pill px-1.5 py-[3px] text-[11px] font-bold leading-none" style="background-color: var(--kro-