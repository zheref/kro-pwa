exports[`story snapshots > Popovers > Gallery 1`] = `"<div data-slot="story-gallery" style="display: flex; flex-direction: column; gap: var(--kro-space-large);"><div data-theme="light" data-slot="story-stage" style="display: flex; flex-direction: column; gap: var(--kro-space-medium); align-items: flex-start; padding: var(--kro-space-large); min-height: 160px; width: 100%; background: linear-gradient(135deg, var(--kro-color-header-gradient-indigo), var(--kro-color-header-gradient-grape)); font-family: system-ui, sans-serif;"><div style="display: flex; flex-direction: column; gap: 8px; align-items: flex-start;"><span style="font-size: 11px; font-weight: 600; letter-spacing: 0.02em; color: var(--kro-color-fore-secondary);">Defaults to now; the user may set an earlier moment</span><div class="kro-glass" style="padding: var(--kro-space-medium); border-radius: var(--kro-radius-surface);"><div class="flex min-w-65 flex-col gap-3.5"><p class="m-0 text-base font-semibold" style="color: var(--kro-color-fore);">Mark complete</p><input data-slot="input" data-density="compact" class="flex w-full min-w-0 rounded-kro-field px-kro-small h-6 text-xs bg-kro-back-inner text-kro-fore border border-kro-hairline placeholder:text-kro-fore-secondary kro-motion-quick transition-[border-color,box-shadow] outline-none disabled:pointer-events-none disabled:opacity-[var(--kro-opacity-disabled)] aria-invalid:border-kro-banner-danger file:inline-flex file:border-0 file:bg-transparent file:text-xs file:font-medium" aria-label="Completed at" type="datetime-local" value="2026-04-15T14:00"><div class="flex items-center justify-between gap-3"><button data-slot="button" data-shape="rounded" data-size="sm" type="button" class="inline-flex shrink-0 items-center justify-center gap-1 cursor-default whitespace-nowrap font-medium kro-motion-quick transition-[color,background-color,box-shadow,transform] outline-none focus-visible:shadow-[var(--kro-ring)] active:scale-[0.97] disabled:pointer-events-none disabled:opacity-[var(--kro-opacity-disabled)] [&amp;_svg]:pointer-events-none [&amp;_svg:not([class*='size-'])]:size-3.5 kro-glass kro-glass--control kro-glass--interactive text-kro-fore h-7 rounded-kro-small px-2.5 text-xs">Cancel</button><button data-slot="button" data-shape="rounded" data-size="sm" type="button" class="inline-flex shrink-0 items-center justify-center gap-1 cursor-default whitespace-nowrap font-medium kro-motion-quick transition-[color,background-color,box-shadow,transform] outline-none focus-visible:shadow-[var(--kro-ring)] active:scale-[0.97] disabled:pointer-events-none disabled:opacity-[var(--kro-opacity-disabled)] [&amp;_svg]:pointer-events-none [&amp;_svg:not([class*='size-'])]:size-3.5 kro-glass kro-glass--control kro-glass--accent kro-glass--interactive text-kro-on-accent h-7 rounded-kro-small px-2.5 text-xs">Mark<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-check" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg></button></div></div></div></div></div><div data-theme="light" data-slot="story-stage" style="display: flex; flex-direction: column; gap: var(--kro-space-medium); align-items: flex-start; padding: var(--kro-space-large); min-height: 160px; width: 100%; background: linear-gradient(135deg, var(--kro-color-header-gradient-indigo), var(--kro-color-header-gradient-grape)); font-family: system-ui, sans-serif;"><div style="display: flex; flex-direction: column; gap: 8px; align-items: flex-start;"><span style="font-size: 11px; font-weight: 600; letter-spacing: 0.02em; color: var(--kro-color-fore-secondary);">From the overflow menu — Skip sits alongside</span><div class="kro-glass" style="padding: var(--kro-space-medium); border-radius: var(--kro-radius-surface);"><div class="flex min-w-65 flex-col gap-3.5"><p class="m-0 text-base font-semibold" style="color: var(--kro-color-fore);"