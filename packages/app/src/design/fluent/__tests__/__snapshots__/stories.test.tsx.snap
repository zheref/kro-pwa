rect><rect width="7" height="7" x="14" y="3" rx="1"></rect><rect width="7" height="7" x="14" y="14" rx="1"></rect><rect width="7" height="7" x="3" y="14" rx="1"></rect></svg><span class="min-w-0 truncate">Plan</span></button></div><div class="flex flex-col"><button type="button" class="flex w-full items-center gap-kro-small rounded-kro-small px-kro-small min-h-9 text-sm text-left text-kro-fore outline-none focus-visible:shadow-[var(--kro-ring)] hover:bg-kro-back-inner"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle shrink-0" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle></svg><span class="min-w-0 truncate">Earn</span></button></div><div class="flex flex-col"><button type="button" class="flex w-full items-center gap-kro-small rounded-kro-small px-kro-small min-h-9 text-sm text-left text-kro-fore outline-none focus-visible:shadow-[var(--kro-ring)] hover:bg-kro-back-inner"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-search shrink-0" aria-hidden="true"><path d="m21 21-4.34-4.34"></path><circle cx="11" cy="11" r="8"></circle></svg><span class="min-w-0 truncate">Find</span></button></div></nav></div></div></div></div></div>"`;

exports[`Fluent 2 story snapshots > Overview > Gallery 1`] = `"<div><div data-slot="story-gallery" style="display: flex; flex-direction: column; gap: var(--kro-space-large);"><div data-theme="light" data-slot="hig-story-stage" style="display: flex; flex-direction: column; gap: var(--kro-space-medium); align-items: stretch; padding: var(--kro-space-large); min-height: 200px; width: 100%; background: var(--kro-color-back); color: var(--kro-color-fore); font-family: system-ui, sans-serif;"><p style="margin: 0px; font-size: 13px; color: var(--kro-color-fore-secondary); max-width: 72ch;">Titles, use cases and variants follow <a href="https://fluent2.microsoft.design/components/web/react">Fluent 2 Web</a>. Paint, materials and type follow KroTokens and KroGlass. 50 titles.</p><section><h2 style="margin: 0px 0px 8px; font-size: 16px; font-weight: 650;">Actions</h2><table style="width: 100%; border-collapse: collapse; font-size: 14px;"><thead><tr style="text-align: left; color: var(--kro-color-fore-secondary); font-size: 12px; letter-spacing: 0.04em; text-transform: uppercase;"><th style="padding: 8px 8px 8px 0px;">Title</th><th style="padding: 8px 8px;">Kro</th><th style="padding: 8px 0px 8px 8px;">Purpose</th></tr></thead><tbody><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600;">Button</td><td style="padding: 10px 8px; white-space: nowrap;"><span style="color: var(--kro-color-banner-warning);">Conflict · Button</span></td><td style="padding: 10px 0px 10px 8px; color: var(--kro-color-fore-secondary);">Trigger a single action. One primary per surface; outline, subtle and transparent for the rest.<span> — Same export name as the Kro primitive. Fluent appearances (outline, subtle, transparent) and shapes (rounded, circular, square) are folded into that primitive rather than a second Button.</span></td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600;">Compound button</td><td style="padding: 10px 8px; white-space: nowrap;"><span style="color: var(--kro-role-status-pending);">Kro · CompoundButton</span></td><td style="padding: 10px 0px 10px 8px; color: var(--kro-color-fore-secondary);">A button with a title and a supporting line. Use when the extra detail helps choose.</td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600;">Menu button</td><td style="padding: 10px 8px; white-space: nowrap;"><span style="color: var(--kro-role-status-pending);">Kro · MenuButton</span></td><td style="padding: 10px 0px 10px 8px; color: var(--kro-color-fore-secondary);">A button that only opens a menu. Unlike a split button, there is no primary action on the face.<span> — HIG Pull-down button is the same job. MenuButton is the Fluent name and variant set; both exist until you pick one name.</span></td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600;">Split button</td><td style="padding: 10px 8px; white-space: nowrap;"><span style="color: var(--kro-role-status-pending);">Kro · SplitButton</span></td><td style="padding: 10px 0px 10px 8px; color: var(--kro-color-fore-secondary);">A primary action plus a chevron that opens related actions. The dominant action is not repeated in the menu.</td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600;">Toggle button</td><td style="padding: 10px 8px; white-space: nowrap;"><span style="color: var(--kro-role-status-pending);">Kro · ToggleButton</span></td><td style="padding: 10px 0px 10px 8px; color: var(--kro-color-fore-secondary);">A button that stays pressed. Off is rest, on is selected. Not a switch — use Switch/Toggle for settings.<span> — HIG Toggle is a switch. Fluent ToggleButton is a pressed button (toolbar idiom). Different jobs, easy to confuse by name.</span></td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600;">Link</td><td style="padding: 10px 8px; white-space: nowrap;"><span style="color: var(--kro-role-status-pending);">Kro · Link</span></td><td style="padding: 10px 0px 10px 8px; color: var(--kro-color-fore-secondary);">Interactive text that navigates. Inline with copy, or standalone. Appearance is default or subtle.</td></tr></tbody></table></section><section><h2 style="margin: 0px 0px 8px; font-size: 16px; font-weight: 650;">Content</h2><table style="width: 100%; border-collapse: collapse; font-size: 14px;"><thead><tr style="text-align: left; color: var(--kro-color-fore-secondary); font-size: 12px; letter-spacing: 0.04em; text-transform: uppercase;"><th style="padding: 8px 8px 8px 0px;">Title</th><th style="padding: 8px 8px;">Kro</th><th style="padding: 8px 0px 8px 8px;">Purpose</th></tr></thead><tbody><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600;">Avatar</td><td style="padding: 10px 8px; white-space: nowrap;"><span style="color: var(--kro-role-status-pending);">Kro · Avatar</span></td><td style="padding: 10px 0px 10px 8px; color: var(--kro-color-fore-secondary);">An image or initials representing a person, with optional presence and activity.</td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600;">Avatar group</td><td style="padding: 10px 8px; white-space: nowrap;"><span style="color: var(--kro-role-status-pending);">Kro · AvatarGroup</span></td><td style="padding: 10px 0px 10px 8px; color: var(--kro-color-fore-secondary);">Several avatars stacked or spread, with an overflow count.</td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600;">Icon</td><td style="padding: 10px 8px; white-space: nowrap;"><span style="color: var(--kro-role-status-ongoing);">Existing · iconForSymbol</span></td><td style="padding: 10px 0px 10px 8px; color: var(--kro-color-fore-secondary);">A glyph with semantic purpose. Kro maps SF Symbol names onto lucide-react.<span> — Fluent Icon is a wrapper around SVG glyphs, not a second icon set.</span></td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600;">Image</td><td style="padding: 10px 8px; white-space: nowrap;"><span style="color: var(--kro-role-status-ongoing);">Existing · ImageView</span></td><td style="padding: 10px 0px 10px 8px; color: var(--kro-color-fore-secondary);">A still image that can block, fit or be circular.<span> — HIG Image views already own still frames. Fluent Image would collide on the short name Image if exported.</span></td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600;">Persona</td><td style="padding: 10px 8px; white-space: nowrap;"><span style="color: var(--kro-role-status-pending);">Kro · Persona</span></td><td style="padding: 10px 0px 10px 8px; color: var(--kro-color-fore-secondary);">A person plus secondary and tertiary text. Presence rides on the avatar, not on colour alone.<span> — HIG Lockup is the generic image+title pair. Persona adds presence and a sized type ramp for people.</span></td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600;">Text</td><td style="padding: 10px 8px; white-space: nowrap;"><span style="color: var(--kro-role-status-pending);">Kro · Text</span></td><td style="padding: 10px 0px 10px 8px; color: var(--kro-color-fore-secondary);">Typography opinions as a component: size, weight, wrap, truncate, italic.<span> — HIG Label names a control. Fluent Text is the type ramp for any copy. Easy to mix up.</span></td></tr></tbody></table></section><section><h2 style="margin: 0px 0px 8px; font-size: 16px; font-weight: 650;">Forms</h2><table style="width: 100%; border-collapse: collapse; font-size: 14px;"><thead><tr style="text-align: left; color: var(--kro-color-fore-secondary); font-size: 12px; letter-spacing: 0.04em; text-transform: uppercase;"><th style="padding: 8px 8px 8px 0px;">Title</th><th style="padding: 8px 8px;">Kro</th><th style="padding: 8px 0px 8px 8px;">Purpose</th></tr></thead><tbody><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600;">Checkbox</td><td style="padding: 10px 8px; white-space: nowrap;"><span style="color: var(--kro-color-banner-warning);">Conflict · Checkbox</span></td><td style="padding: 10px 0px 10px 8px; color: var(--kro-color-fore-secondary);">Select several options, or switch one option on or off.<span> — Same export name as the HIG checkbox. Restaged under Fluent 2 with Fluent size names mapped onto density.</span></td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600;">Combobox</td><td style="padding: 10px 8px; white-space: nowrap;"><span style="color: var(--kro-color-banner-warning);">Conflict · ComboBox</span></td><td style="padding: 10px 0px 10px 8px; color: var(--kro-color-fore-secondary);">Type a value or pick one (or more) from a list. The field stays editable.<span> — Fluent spells Combobox; Kro exports ComboBox. Same control. Not re-exported under a second casing.</span></td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600;">Dropdown</td><td style="padding: 10px 8px; white-space: nowrap;"><span style="color: var(--kro-role-status-ongoing);">Existing · PopupButton</span></td><td style="padding: 10px 0px 10px 8px; color: var(--kro-color-fore-secondary);">Choose one or more options from a closed list. The field is not free text.<span> — HIG pop-up button is the closed-list picker. Fluent Dropdown is the same job with a field-shaped trigger.</span></td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600;">Field</td><td style="padding: 10px 8px; white-space: nowrap;"><span style="color: var(--kro-role-status-pending);">Kro · Field</span></td><td style="padding: 10px 0px 10px 8px; color: var(--kro-color-fore-secondary);">A label plus any form control, with hint, required mark and a validation message.</td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600;">Info label</td><td style="padding: 10px 8px; white-space: nowrap;"><span style="color: var(--kro-role-status-pending);">Kro · InfoLabel</span></td><td style="padding: 10px 0px 10px 8px; color: var(--kro-color-fore-secondary);">A label with an info button that opens extra copy in a popover.</td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600;">Input</td><td style="padding: 10px 8px; white-space: nowrap;"><span style="color: var(--kro-color-banner-warning);">Conflict · Input</span></td><td style="padding: 10px 0px 10px 8px; color: var(--kro-color-fore-secondary);">Short free-form text. Outline, underline or filled.<span> — Same export name as the Kro field primitive. Fluent appearances are restaged, not a second Input.</span></td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600;">Label</td><td style="padding: 10px 8px; white-space: nowrap;"><span style="color: var(--kro-color-banner-warning);">Conflict · Label</span></td><td style="padding: 10px 0px 10px 8px; color: var(--kro-color-fore-secondary);">Names a control or group. Required is a mark, not colour alone.<span> — Same export name as the HIG Label. Restaged with Fluent size names mapped onto density.</span></td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600;">Radio group</td><td style="padding: 10px 8px; white-space: nowrap;"><span style="color: var(--kro-color-banner-warning);">Conflict · RadioGroup</span></td><td style="padding: 10px 0px 10px 8px; color: var(--kro-color-fore-secondary);">Pick exactly one item from a short list.<span> — Same export name as the HIG radio group.</span></td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600;">Rating</td><td style="padding: 10px 8px; white-space: nowrap;"><span style="color: var(--kro-role-status-ongoing);">Existing · RatingIndicator</span></td><td style="padding: 10px 0px 10px 8px; color: var(--kro-color-fore-secondary);">A discrete 1-to-N score. The number is always spoken and shown.<span> — HIG rating indicator is the same control. Fluent short name Rating would collide if exported.</span></td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600;">Select</td><td style="padding: 10px 8px; white-space: nowrap;"><span style="color: var(--kro-role-status-pending);">Kro · Select</span></td><td style="padding: 10px 0px 10px 8px; color: var(--kro-color-fore-secondary);">A native select of four or more options. The platform owns the menu.<span> — HIG Picker (list) and pop-up button cover the same choice. Fluent Select is the native &lt;select&gt; styling.</span></td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600;">Slider</td><td style="padding: 10px 8px; white-space: nowrap;"><span style="color: var(--kro-color-banner-warning);">Conflict · Slider</span></td><td style="padding: 10px 0px 10px 8px; color: var(--kro-color-fore-secondary);">A value from a continuous range, by dragging a thumb.<span> — Same export name as the HIG slider.</span></td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600;">Spin button</td><td style="padding: 10px 8px; white-space: nowrap;"><span style="color: var(--kro-role-status-pending);">Kro · SpinButton</span></td><td style="padding: 10px 0px 10px 8px; color: var(--kro-color-fore-secondary);">Nudge a numeric value inside a range. The value is in a field, unlike a stepper.<span> — HIG Stepper is plus/minus around a readout. Fluent SpinButton puts the value in an editable field.</span></td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600;">Switch</td><td style="padding: 10px 8px; white-space: nowrap;"><span style="color: var(--kro-role-status-ongoing);">Existing · Toggle</span></td><td style="padding: 10px 0px 10px 8px; color: var(--kro-color-fore-secondary);">Two mutually exclusive options, like on or off. The knob is the state.<span> — HIG calls it Toggle; Fluent calls it Switch. Same binary control. Not duplicated.</span></td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600;">Tag picker</td><td style="padding: 10px 8px; white-space: nowrap;"><span style="color: var(--kro-role-status-pending);">Kro · TagPicker</span></td><td style="padding: 10px 0px 10px 8px; color: var(--kro-color-fore-secondary);">A field of dismissible tags plus a dropdown, for picking several values.</td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600;">Textarea</td><td style="padding: 10px 8px; white-space: nowrap;"><span style="color: var(--kro-role-status-ongoing);">Existing · TextView</span></td><td style="padding: 10px 0px 10px 8px; color: var(--kro-color-fore-secondary);">Long free-form text. Same recessed field as Input.<span> — HIG Text views is the multiline field. Fluent Textarea would collide if exported as Textarea next to TextView.</span></td></tr></tbody></table></section><section><h2 style="margin: 0px 0px 8px; font-size: 16px; font-weight: 650;">Navigation</h2><table style="width: 100%; border-collapse: collapse; font-size: 14px;"><thead><tr style="text-align: left; color: var(--kro-color-fore-secondary); font-size: 12px; letter-spacing: 0.04em; text-transform: uppercase;"><th style="padding: 8px 8px 8px 0px;">Title</th><th style="padding: 8px 8px;">Kro</th><th style="padding: 8px 0px 8px 8px;">Purpose</th></tr></thead><tbody><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600;">Accordion</td><td style="padding: 10px 8px; white-space: nowrap;"><span style="color: var(--kro-role-status-pending);">Kro · Accordion</span></td><td style="padding: 10px 0px 10px 8px; color: var(--kro-color-fore-secondary);">Grouped sections that open and close. Multiple, collapsible, or exclusive.<span> — HIG Disclosure is one block. Fluent Accordion is a list of those blocks with exclusive/multiple modes.</span></td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600;">Breadcrumb</td><td style="padding: 10px 8px; white-space: nowrap;"><span style="color: var(--kro-role-status-pending);">Kro · Breadcrumb</span></td><td style="padding: 10px 0px 10px 8px; color: var(--kro-color-fore-secondary);">The current place in a hierarchy, with ancestors that jump back.<span> — HIG Path control is the same trail. Breadcrumb is the Fluent name with overflow. Both exist until you pick one.</span></td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600;">Nav</td><td style="padding: 10px 8px; white-space: nowrap;"><span style="color: var(--kro-role-status-pending);">Kro · Nav</span></td><td style="padding: 10px 0px 10px 8px; color: var(--kro-color-fore-secondary);">A list of links through the main sections of an app. Categories can nest.<span> — HIG Sidebar is the destination list. Fluent Nav adds nested categories and a selected indicator.</span></td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600;">Tablist</td><td style="padding: 10px 8px; white-space: nowrap;"><span style="color: var(--kro-role-status-ongoing);">Existing · Tabs</span></td><td style="padding: 10px 0px 10px 8px; color: var(--kro-color-fore-secondary);">Switch categories of related information without leaving the page. Not top-level navigation.<span> — Kro Tabs is the segmented control / tablist. Fluent Tablist is the same pattern.</span></td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600;">Toolbar</td><td style="padding: 10px 8px; white-space: nowrap;"><span style="color: var(--kro-color-banner-warning);">Conflict · Toolbar</span></td><td style="padding: 10px 0px 10px 8px; color: var(--kro-color-fore-secondary);">Frequent actions for the current view, grouped.<span> — Same export name as the HIG toolbar.</span></td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600;">Tree</td><td style="padding: 10px 8px; white-space: nowrap;"><span style="color: var(--kro-role-status-ongoing);">Existing · OutlineView</span></td><td style="padding: 10px 0px 10px 8px; color: var(--kro-color-fore-secondary);">Hierarchical nested data. Rows expand in place.<span> — HIG Outline views is the tree. Fluent Tree would collide if exported as Tree.</span></td></tr></tbody></table></section><section><h2 style="margin: 0px 0px 8px; font-size: 16px; font-weight: 650;">Surfaces</h2><table style="width: 100%; border-collapse: collapse; font-size: 14px;"><thead><tr style="text-align: left; color: var(--kro-color-fore-secondary); font-size: 12px; letter-spacing: 0.04em; text-transform: uppercase;"><th style="padding: 8px 8px 8px 0px;">Title</th><th style="padding: 8px 8px;">Kro</th><th style="padding: 8px 0px 8px 8px;">Purpose</th></tr></thead><tbody><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600;">Card</td><td style="padding: 10px 8px; white-space: nowrap;"><span style="color: var(--kro-role-status-pending);">Kro · Card</span></td><td style="padding: 10px 0px 10px 8px; color: var(--kro-color-fore-secondary);">A container for one concept: header, preview, body, footer. Filled, outline or subtle.<span> — Endeavor SurfaceCard / HIG GroupedBox already group content. Fluent Card adds header/preview/footer anatomy and appearance variants. Short name Card is new.</span></td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600;">Carousel</td><td style="padding: 10px 8px; white-space: nowrap;"><span style="color: var(--kro-role-status-pending);">Kro · Carousel</span></td><td style="padding: 10px 0px 10px 8px; color: var(--kro-color-fore-secondary);">Cycle through peer content without leaving the page. Pagination is numbered, not colour alone.</td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600;">Dialog</td><td style="padding: 10px 8px; white-space: nowrap;"><span style="color: var(--kro-color-banner-warning);">Conflict · Dialog</span></td><td style="padding: 10px 0px 10px 8px; color: var(--kro-color-fore-secondary);">A supplemental surface that can require an action before work continues.<span> — Same export name as the Kro/Radix dialog primitive. Also overlaps HIG Alert.</span></td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600;">Divider</td><td style="padding: 10px 8px; white-space: nowrap;"><span style="color: var(--kro-role-status-ongoing);">Existing · Separator</span></td><td style="padding: 10px 0px 10px 8px; color: var(--kro-color-fore-secondary);">A hairline that groups sections. Optional label.<span> — HIG Separator is the hairline. Fluent Divider is the same control.</span></td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600;">Drawer</td><td style="padding: 10px 8px; white-space: nowrap;"><span style="color: var(--kro-role-status-ongoing);">Existing · Sheet</span></td><td style="padding: 10px 0px 10px 8px; color: var(--kro-color-fore-secondary);">A secondary surface that slides in from an edge.<span> — Kro Sheet already slides from any edge. Fluent Drawer is the same presentation.</span></td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600;">List</td><td style="padding: 10px 8px; white-space: nowrap;"><span style="color: var(--kro-color-banner-warning);">Conflict · List</span></td><td style="padding: 10px 0px 10px 8px; color: var(--kro-color-fore-secondary);">Like items stacked vertically.<span> — Same export name as the HIG list.</span></td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600;">Menu</td><td style="padding: 10px 8px; white-space: nowrap;"><span style="color: var(--kro-role-status-ongoing);">Existing · DropdownMenu</span></td><td style="padding: 10px 0px 10px 8px; color: var(--kro-color-fore-secondary);">A hidden list of options shown from a trigger.<span> — Kro DropdownMenu is the menu. Fluent Menu would collide if exported as Menu.</span></td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600;">Popover</td><td style="padding: 10px 8px; white-space: nowrap;"><span style="color: var(--kro-color-banner-warning);">Conflict · Popover</span></td><td style="padding: 10px 0px 10px 8px; color: var(--kro-color-fore-secondary);">A small surface anchored to a control for nonessential context.<span> — Same export name as the Kro popover primitive.</span></td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600;">Tooltip</td><td style="padding: 10px 8px; white-space: nowrap;"><span style="color: var(--kro-role-status-pending);">Kro · Tooltip</span></td><td style="padding: 10px 0px 10px 8px; color: var(--kro-color-fore-secondary);">Supplemental context near a target. Relationship is label, description or inaccessible.</td></tr></tbody></table></section><section><h2 style="margin: 0px 0px 8px; font-size: 16px; font-weight: 650;">Status</h2><table style="width: 100%; border-collapse: collapse; font-size: 14px;"><thead><tr style="text-align: left; color: var(--kro-color-fore-secondary); font-size: 12px; letter-spacing: 0.04em; text-transform: uppercase;"><th style="padding: 8px 8px 8px 0px;">Title</th><th style="padding: 8px 8px;">Kro</th><th style="padding: 8px 0px 8px 8px;">Purpose</th></tr></thead><tbody><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600;">Badge</td><td style="padding: 10px 8px; white-space: nowrap;"><span style="color: var(--kro-role-status-pending);">Kro · Badge</span></td><td style="padding: 10px 0px 10px 8px; color: var(--kro-color-fore-secondary);">A status or description of an associated control. Colour is never the only signal — the text is.<span> — Endeavor CardBadge is a 20px capsule for card corners. Fluent Badge is the generic status chip with appearances, sizes and colours.</span></td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600;">Message bar</td><td style="padding: 10px 8px; white-space: nowrap;"><span style="color: var(--kro-role-status-pending);">Kro · MessageBar</span></td><td style="padding: 10px 0px 10px 8px; color: var(--kro-color-fore-secondary);">Important information about the product or the current surface. Intent is named in words.<span> — Endeavor InlineBanner is info/warning/error. Fluent MessageBar adds success and single/multiline layouts.</span></td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600;">Progress bar</td><td style="padding: 10px 8px; white-space: nowrap;"><span style="color: var(--kro-role-status-ongoing);">Existing · ProgressIndicator</span></td><td style="padding: 10px 0px 10px 8px; color: var(--kro-color-fore-secondary);">How far a determinate task has got, or that one is still running.<span> — HIG Progress indicators already cover bar, circular and indeterminate.</span></td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600;">Skeleton</td><td style="padding: 10px 8px; white-space: nowrap;"><span style="color: var(--kro-role-status-pending);">Kro · Skeleton</span></td><td style="padding: 10px 0px 10px 8px; color: var(--kro-color-fore-secondary);">A section is loading, without blocking the rest of the page. Shape, not colour, is the signal.</td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600;">Spinner</td><td style="padding: 10px 8px; white-space: nowrap;"><span style="color: var(--kro-role-status-pending);">Kro · Spinner</span></td><td style="padding: 10px 0px 10px 8px; color: var(--kro-color-fore-secondary);">Something is processing. The label says what, not the colour.<span> — HIG ProgressIndicator kind=indeterminate is the spinner. Fluent Spinner is a dedicated export with a size ramp.</span></td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600;">Tag</td><td style="padding: 10px 8px; white-space: nowrap;"><span style="color: var(--kro-role-status-pending);">Kro · Tag</span></td><td style="padding: 10px 0px 10px 8px; color: var(--kro-color-fore-secondary);">A value someone picked (a recipient, a category). Dismissible, with a glyph and a word.<span> — KroChip is the endeavor identity/status capsule. Fluent Tag is the generic dismissible token.</span></td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600;">Toast</td><td style="padding: 10px 8px; white-space: nowrap;"><span style="color: var(--kro-role-status-ongoing);">Existing · ActiveToast</span></td><td style="padding: 10px 0px 10px 8px; color: var(--kro-color-fore-secondary);">The status of an action, or something that happened elsewhere. Transient.<span> — Chrome ActiveToast is the product toast. Fluent Toast is the same job.</span></td></tr></tbody></table></section><section><h2 style="margin: 0px 0px 8px; font-size: 16px; font-weight: 650;">Utilities</h2><table style="width: 100%; border-collapse: collapse; font-size: 14px;"><thead><tr style="text-align: left; color: var(--kro-color-fore-secondary); font-size: 12px; letter-spacing: 0.04em; text-transform: uppercase;"><th style="padding: 8px 8px 8px 0px;">Title</th><th style="padding: 8px 8px;">Kro</th><th style="padding: 8px 0px 8px 8px;">Purpose</th></tr></thead><tbody><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600;">Fluent provider</td><td style="padding: 10px 8px; white-space: nowrap;"><span style="color: var(--kro-color-fore-secondary);">Out of scope</span></td><td style="padding: 10px 0px 10px 8px; color: var(--kro-color-fore-secondary);">Defines the styles used in the app. Kro already does this with tokens and data-theme.<span> — KroTokens, palettes and data-theme already provide the theme. A FluentProvider would wrap a second token set we do not ship.</span></td></tr></tbody></table></section></div><div data-theme="light" data-slot="hig-story-stage" style="display: flex; flex-direction: column; gap: var(--kro-space-medium); align-items: stretch; padding: var(--kro-space-large); min-height: 200px; width: 100%; background: var(--kro-color-back); color: var(--kro-color-fore); font-family: system-ui, sans-serif;"><table style="width: 100%; border-collapse: collapse; font-size: 14px;"><thead><tr style="text-align: left; color: var(--kro-color-fore-secondary); font-size: 12px; letter-spacing: 0.04em; text-transform: uppercase;"><th style="padding: 8px 8px 8px 0px;">Title</th><th style="padding: 8px 8px;">Kro</th><th style="padding: 8px 0px 8px 8px;">Purpose</th></tr></thead><tbody><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600;">Compound button</td><td style="padding: 10px 8px; white-space: nowrap;"><span style="color: var(--kro-role-status-pending);">Kro · CompoundButton</span></td><td style="padding: 10px 0px 10px 8px; color: var(--kro-color-fore-secondary);">A button with a title and a supporting line. Use when the extra detail helps choose.</td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600;">Menu button</td><td style="padding: 10px 8px; white-space: nowrap;"><span style="color: var(--kro-role-status-pending);">Kro · MenuButton</span></td><td style="padding: 10px 0px 10px 8px; color: var(--kro-color-fore-secondary);">A button that only opens a menu. Unlike a split button, there is no primary action on the face.<span> — HIG Pull-down button is the same job. MenuButton is the Fluent name and variant set; both exist until you pick one name.</span></td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600;">Split button</td><td style="padding: 10px 8px; white-space: nowrap;"><span style="color: var(--kro-role-status-pending);">Kro · SplitButton</span></td><td style="padding: 10px 0px 10px 8px; color: var(--kro-color-fore-secondary);">A primary action plus a chevron that opens related actions. The dominant action is not repeated in the menu.</td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600;">Toggle button</td><td style="padding: 10px 8px; white-space: nowrap;"><span style="color: var(--kro-role-status-pending);">Kro · ToggleButton</span></td><td style="padding: 10px 0px 10px 8px; color: var(--kro-color-fore-secondary);">A button that stays pressed. Off is rest, on is selected. Not a switch — use Switch/Toggle for settings.<span> — HIG Toggle is a switch. Fluent ToggleButton is a pressed button (toolbar idiom). Different jobs, easy to confuse by name.</span></td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600;">Link</td><td style="padding: 10px 8px; white-space: nowrap;"><span style="color: var(--kro-role-status-pending);">Kro · Link</span></td><td style="padding: 10px 0px 10px 8px; color: var(--kro-color-fore-secondary);">Interactive text that navigates. Inline with copy, or standalone. Appearance is default or subtle.</td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600;">Avatar</td><td style="padding: 10px 8px; white-space: nowrap;"><span style="color: var(--kro-role-status-pending);">Kro · Avatar</span></td><td style="padding: 10px 0px 10px 8px; color: var(--kro-color-fore-secondary);">An image or initials representing a person, with optional presence and activity.</td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600;">Avatar group</td><td style="padding: 10px 8px; white-space: nowrap;"><span style="color: var(--kro-role-status-pending);">Kro · AvatarGroup</span></td><td style="padding: 10px 0px 10px 8px; color: var(--kro-color-fore-secondary);">Several avatars stacked or spread, with an overflow count.</td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600;">Persona</td><td style="padding: 10px 8px; white-space: nowrap;"><span style="color: var(--kro-role-status-pending);">Kro · Persona</span></td><td style="padding: 10px 0px 10px 8px; color: var(--kro-color-fore-secondary);">A person plus secondary and tertiary text. Presence rides on the avatar, not on colour alone.<span> — HIG Lockup is the generic image+title pair. Persona adds presence and a sized type ramp for people.</span></td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600;">Text</td><td style="padding: 10px 8px; white-space: nowrap;"><span style="color: var(--kro-role-status-pending);">Kro · Text</span></td><td style="padding: 10px 0px 10px 8px; color: var(--kro-color-fore-secondary);">Typography opinions as a component: size, weight, wrap, truncate, italic.<span> — HIG Label names a control. Fluent Text is the type ramp for any copy. Easy to mix up.</span></td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600;">Field</td><td style="padding: 10px 8px; white-space: nowrap;"><span style="color: var(--kro-role-status-pending);">Kro · Field</span></td><td style="padding: 10px 0px 10px 8px; color: var(--kro-color-fore-secondary);">A label plus any form control, with hint, required mark and a validation message.</td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600;">Info label</td><td style="padding: 10px 8px; white-space: nowrap;"><span style="color: var(--kro-role-status-pending);">Kro · InfoLabel</span></td><td style="padding: 10px 0px 10px 8px; color: var(--kro-color-fore-secondary);">A label with an info button that opens extra copy in a popover.</td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600;">Select</td><td style="padding: 10px 8px; white-space: nowrap;"><span style="color: var(--kro-role-status-pending);">Kro · Select</span></td><td style="padding: 10px 0px 10px 8px; color: var(--kro-color-fore-secondary);">A native select of four or more options. The platform owns the menu.<span> — HIG Picker (list) and pop-up button cover the same choice. Fluent Select is the native &lt;select&gt; styling.</span></td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600;">Spin button</td><td style="padding: 10px 8px; white-space: nowrap;"><span style="color: var(--kro-role-status-pending);">Kro · SpinButton</span></td><td style="padding: 10px 0px 10px 8px; color: var(--kro-color-fore-secondary);">Nudge a numeric value inside a range. The value is in a field, unlike a stepper.<span> — HIG Stepper is plus/minus around a readout. Fluent SpinButton puts the value in an editable field.</span></td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600;">Tag picker</td><td style="padding: 10px 8px; white-space: nowrap;"><span style="color: var(--kro-role-status-pending);">Kro · TagPicker</span></td><td style="padding: 10px 0px 10px 8px; color: var(--kro-color-fore-secondary);">A field of dismissible tags plus a dropdown, for picking several values.</td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600;">Accordion</td><td style="padding: 10px 8px; white-space: nowrap;"><span style="color: var(--kro-role-status-pending);">Kro · Accordion</span></td><td style="padding: 10px 0px 10px 8px; color: var(--kro-color-fore-secondary);">Grouped sections that open and close. Multiple, collapsible, or exclusive.<span> — HIG Disclosure is one block. Fluent Accordion is a list of those blocks with exclusive/multiple modes.</span></td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600;">Breadcrumb</td><td style="padding: 10px 8px; white-space: nowrap;"><span style="color: var(--kro-role-status-pending);">Kro · Breadcrumb</span></td><td style="padding: 10px 0px 10px 8px; color: var(--kro-color-fore-secondary);">The current place in a hierarchy, with ancestors that jump back.<span> — HIG Path control is the same trail. Breadcrumb is the Fluent name with overflow. Both exist until you pick one.</span></td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600;">Nav</td><td style="padding: 10px 8px; white-space: nowrap;"><span style="color: var(--kro-role-status-pending);">Kro · Nav</span></td><td style="padding: 10px 0px 10px 8px; color: var(--kro-color-fore-secondary);">A list of links through the main sections of an app. Categories can nest.<span> — HIG Sidebar is the destination list. Fluent Nav adds nested categories and a selected indicator.</span></td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600;">Card</td><td style="padding: 10px 8px; white-space: nowrap;"><span style="color: var(--kro-role-status-pending);">Kro · Card</span></td><td style="padding: 10px 0px 10px 8px; color: var(--kro-color-fore-secondary);">A container for one concept: header, preview, body, footer. Filled, outline or subtle.<span> — Endeavor SurfaceCard / HIG GroupedBox already group content. Fluent Card adds header/preview/footer anatomy and appearance variants. Short name Card is new.</span></td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600;">Carousel</td><td style="padding: 10px 8px; white-space: nowrap;"><span style="color: var(--kro-role-status-pending);">Kro · Carousel</span></td><td style="padding: 10px 0px 10px 8px; color: var(--kro-color-fore-secondary);">Cycle through peer content without leaving the page. Pagination is numbered, not colour alone.</td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600;">Tooltip</td><td style="padding: 10px 8px; white-space: nowrap;"><span style="color: var(--kro-role-status-pending);">Kro · Tooltip</span></td><td style="padding: 10px 0px 10px 8px; color: var(--kro-color-fore-secondary);">Supplemental context near a target. Relationship is label, description or inaccessible.</td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600;">Badge</td><td style="padding: 10px 8px; white-space: nowrap;"><span style="color: var(--kro-role-status-pending);">Kro · Badge</span></td><td style="padding: 10px 0px 10px 8px; color: var(--kro-color-fore-secondary);">A status or description of an associated control. Colour is never the only signal — the text is.<span> — Endeavor CardBadge is a 20px capsule for card corners. Fluent Badge is the generic status chip with appearances, sizes and colours.</span></td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600;">Message bar</td><td style="padding: 10px 8px; white-space: nowrap;"><span style="color: var(--kro-role-status-pending);">Kro · MessageBar</span></td><td style="padding: 10px 0px 10px 8px; color: var(--kro-color-fore-secondary);">Important information about the product or the current surface. Intent is named in words.<span> — Endeavor InlineBanner is info/warning/error. Fluent MessageBar adds success and single/multiline layouts.</span></td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600;">Skeleton</td><td style="padding: 10px 8px; white-space: nowrap;"><span style="color: var(--kro-role-status-pending);">Kro · Skeleton</span></td><td style="padding: 10px 0px 10px 8px; color: var(--kro-color-fore-secondary);">A section is loading, without blocking the rest of the page. Shape, not colour, is the signal.</td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600;">Spinner</td><td style="padding: 10px 8px; white-space: nowrap;"><span style="color: var(--kro-role-status-pending);">Kro · Spinner</span></td><td style="padding: 10px 0px 10px 8px; color: var(--kro-color-fore-secondary);">Something is processing. The label says what, not the colour.<span> — HIG ProgressIndicator kind=indeterminate is the spinner. Fluent Spinner is a dedicated export with a size ramp.</span></td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600;">Tag</td><td style="padding: 10px 8px; white-space: nowrap;"><span style="color: var(--kro-role-status-pending);">Kro · Tag</span></td><td style="padding: 10px 0px 10px 8px; color: var(--kro-color-fore-secondary);">A value someone picked (a recipient, a category). Dismissible, with a glyph and a word.<span> — KroChip is the endeavor identity/status capsule. Fluent Tag is the generic dismissible token.</span></td></tr></tbody></table></div><div data-theme="light" data-slot="hig-story-stage" style="display: flex; flex-direction: column; gap: var(--kro-space-medium); align-items: stretch; padding: var(--kro-space-large); min-height: 200px; width: 100%; background: var(--kro-color-back); color: var(--kro-color-fore); font-family: system-ui, sans-serif;"><div style="display: flex; flex-direction: column; gap: 8px;"><span style="font-size: 11px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--kro-color-fore-secondary);">Flagged for a human decision</span><div style="display: flex; flex-wrap: wrap; gap: 12px; align-items: center;"><span style="color: var(--kro-color-fore-secondary);">Exact names collide with a live \`@kro/app/design\` export. Conceptual overlaps share a job under two titles. Nothing was deleted.</span></div></div><table style="width: 100%; border-collapse: collapse; font-size: 14px;"><thead><tr style="text-align: left; color: var(--kro-color-fore-secondary); font-size: 12px; letter-spacing: 0.04em; text-transform: uppercase;"><th style="padding: 8px 8px 8px 0px;">Title</th><th style="padding: 8px 8px;">Kro</th><th style="padding: 8px 0px 8px 8px;">Purpose</th></tr></thead><tbody><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600;">Button</td><td style="padding: 10px 8px; white-space: nowrap;"><span style="color: var(--kro-color-banner-warning);">Conflict · Button</span></td><td style="padding: 10px 0px 10px 8px; color: var(--kro-color-fore-secondary);">Trigger a single action. One primary per surface; outline, subtle and transparent for the rest.<span> — Same export name as the Kro primitive. Fluent appearances (outline, subtle, transparent) and shapes (rounded, circular, square) are folded into that primitive rather than a second Button.</span></td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600;">Menu button</td><td style="padding: 10px 8px; white-space: nowrap;"><span style="color: var(--kro-role-status-pending);">Kro · MenuButton</span></td><td style="padding: 10px 0px 10px 8px; color: var(--kro-color-fore-secondary);">A button that only opens a menu. Unlike a split button, there is no primary action on the face.<span> — HIG Pull-down button is the same job. MenuButton is the Fluent name and variant set; both exist until you pick one name.</span></td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600;">Toggle button</td><td style="padding: 10px 8px; white-space: nowrap;"><span style="color: var(--kro-role-status-pending);">Kro · ToggleButton</span></td><td style="padding: 10px 0px 10px 8px; color: var(--kro-color-fore-secondary);">A button that stays pressed. Off is rest, on is selected. Not a switch — use Switch/Toggle for settings.<span> — HIG Toggle is a switch. Fluent ToggleButton is a pressed button (toolbar idiom). Different jobs, easy to confuse by name.</span></td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600;">Icon</td><td style="padding: 10px 8px; white-space: nowrap;"><span style="color: var(--kro-role-status-ongoing);">Existing · iconForSymbol</span></td><td style="padding: 10px 0px 10px 8px; color: var(--kro-color-fore-secondary);">A glyph with semantic purpose. Kro maps SF Symbol names onto lucide-react.<span> — Fluent Icon is a wrapper around SVG glyphs, not a second icon set.</span></td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600;">Image</td><td style="padding: 10px 8px; white-space: nowrap;"><span style="color: var(--kro-role-status-ongoing);">Existing · ImageView</span></td><td style="padding: 10px 0px 10px 8px; color: var(--kro-color-fore-secondary);">A still image that can block, fit or be circular.<span> — HIG Image views already own still frames. Fluent Image would collide on the short name Image if exported.</span></td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600;">Persona</td><td style="padding: 10px 8px; white-space: nowrap;"><span style="color: var(--kro-role-status-pending);">Kro · Persona</span></td><td style="padding: 10px 0px 10px 8px; color: var(--kro-color-fore-secondary);">A person plus secondary and tertiary text. Presence rides on the avatar, not on colour alone.<span> — HIG Lockup is the generic image+title pair. Persona adds presence and a sized type ramp for people.</span></td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600;">Text</td><td style="padding: 10px 8px; white-space: nowrap;"><span style="color: var(--kro-role-status-pending);">Kro · Text</span></td><td style="padding: 10px 0px 10px 8px; color: var(--kro-color-fore-secondary);">Typography opinions as a component: size, weight, wrap, truncate, italic.<span> — HIG Label names a control. Fluent Text is the type ramp for any copy. Easy to mix up.</span></td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600;">Checkbox</td><td style="padding: 10px 8px; white-space: nowrap;"><span style="color: var(--kro-color-banner-warning);">Conflict · Checkbox</span></td><td style="padding: 10px 0px 10px 8px; color: var(--kro-color-fore-secondary);">Select several options, or switch one option on or off.<span> — Same export name as the HIG checkbox. Restaged under Fluent 2 with Fluent size names mapped onto density.</span></td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600;">Combobox</td><td style="padding: 10px 8px; white-space: nowrap;"><span style="color: var(--kro-color-banner-warning);">Conflict · ComboBox</span></td><td style="padding: 10px 0px 10px 8px; color: var(--kro-color-fore-secondary);">Type a value or pick one (or more) from a list. The field stays editable.<span> — Fluent spells Combobox; Kro exports ComboBox. Same control. Not re-exported under a second casing.</span></td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600;">Dropdown</td><td style="padding: 10px 8px; white-space: nowrap;"><span style="color: var(--kro-role-status-ongoing);">Existing · PopupButton</span></td><td style="padding: 10px 0px 10px 8px; color: var(--kro-color-fore-secondary);">Choose one or more options from a closed list. The field is not free text.<span> — HIG pop-up button is the closed-list picker. Fluent Dropdown is the same job with a field-shaped trigger.</span></td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600;">Input</td><td style="padding: 10px 8px; white-space: nowrap;"><span style="color: var(--kro-color-banner-warning);">Conflict · Input</span></td><td style="padding: 10px 0px 10px 8px; color: var(--kro-color-fore-secondary);">Short free-form text. Outline, underline or filled.<span> — Same export name as the Kro field primitive. Fluent appearances are restaged, not a second Input.</span></td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600;">Label</td><td style="padding: 10px 8px; white-space: nowrap;"><span style="color: var(--kro-color-banner-warning);">Conflict · Label</span></td><td style="padding: 10px 0px 10px 8px; color: var(--kro-color-fore-secondary);">Names a control or group. Required is a mark, not colour alone.<span> — Same export name as the HIG Label. Restaged with Fluent size names mapped onto density.</span></td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600;">Radio group</td><td style="padding: 10px 8px; white-space: nowrap;"><span style="color: var(--kro-color-banner-warning);">Conflict · RadioGroup</span></td><td style="padding: 10px 0px 10px 8px; color: var(--kro-color-fore-secondary);">Pick exactly one item from a short list.<span> — Same export name as the HIG radio group.</span></td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600;">Rating</td><td style="padding: 10px 8px; white-space: nowrap;"><span style="color: var(--kro-role-status-ongoing);">Existing · RatingIndicator</span></td><td style="padding: 10px 0px 10px 8px; color: var(--kro-color-fore-secondary);">A discrete 1-to-N score. The number is always spoken and shown.<span> — HIG rating indicator is the same control. Fluent short name Rating would collide if exported.</span></td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600;">Select</td><td style="padding: 10px 8px; white-space: nowrap;"><span style="color: var(--kro-role-status-pending);">Kro · Select</span></td><td style="padding: 10px 0px 10px 8px; color: var(--kro-color-fore-secondary);">A native select of four or more options. The platform owns the menu.<span> — HIG Picker (list) and pop-up button cover the same choice. Fluent Select is the native &lt;select&gt; styling.</span></td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600;">Slider</td><td style="padding: 10px 8px; white-space: nowrap;"><span style="color: var(--kro-color-banner-warning);">Conflict · Slider</span></td><td style="padding: 10px 0px 10px 8px; color: var(--kro-color-fore-secondary);">A value from a continuous range, by dragging a thumb.<span> — Same export name as the HIG slider.</span></td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600;">Spin button</td><td style="padding: 10px 8px; white-space: nowrap;"><span style="color: var(--kro-role-status-pending);">Kro · SpinButton</span></td><td style="padding: 10px 0px 10px 8px; color: var(--kro-color-fore-secondary);">Nudge a numeric value inside a range. The value is in a field, unlike a stepper.<span> — HIG Stepper is plus/minus around a readout. Fluent SpinButton puts the value in an editable field.</span></td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600;">Switch</td><td style="padding: 10px 8px; white-space: nowrap;"><span style="color: var(--kro-role-status-ongoing);">Existing · Toggle</span></td><td style="padding: 10px 0px 10px 8px; color: var(--kro-color-fore-secondary);">Two mutually exclusive options, like on or off. The knob is the state.<span> — HIG calls it Toggle; Fluent calls it Switch. Same binary control. Not duplicated.</span></td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600;">Textarea</td><td style="padding: 10px 8px; white-space: nowrap;"><span style="color: var(--kro-role-status-ongoing);">Existing · TextView</span></td><td style="padding: 10px 0px 10px 8px; color: var(--kro-color-fore-secondary);">Long free-form text. Same recessed field as Input.<span> — HIG Text views is the multiline field. Fluent Textarea would collide if exported as Textarea next to TextView.</span></td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600;">Accordion</td><td style="padding: 10px 8px; white-space: nowrap;"><span style="color: var(--kro-role-status-pending);">Kro · Accordion</span></td><td style="padding: 10px 0px 10px 8px; color: var(--kro-color-fore-secondary);">Grouped sections that open and close. Multiple, collapsible, or exclusive.<span> — HIG Disclosure is one block. Fluent Accordion is a list of those blocks with exclusive/multiple modes.</span></td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600;">Breadcrumb</td><td style="padding: 10px 8px; white-space: nowrap;"><span style="color: var(--kro-role-status-pending);">Kro · Breadcrumb</span></td><td style="padding: 10px 0px 10px 8px; color: var(--kro-color-fore-secondary);">The current place in a hierarchy, with ancestors that jump back.<span> — HIG Path control is the same trail. Breadcrumb is the Fluent name with overflow. Both exist until you pick one.</span></td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600;">Nav</td><td style="padding: 10px 8px; white-space: nowrap;"><span style="color: var(--kro-role-status-pending);">Kro · Nav</span></td><td style="padding: 10px 0px 10px 8px; color: var(--kro-color-fore-secondary);">A list of links through the main sections of an app. Categories can nest.<span> — HIG Sidebar is the destination list. Fluent Nav adds nested categories and a selected indicator.</span></td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600;">Tablist</td><td style="padding: 10px 8px; white-space: nowrap;"><span style="color: var(--kro-role-status-ongoing);">Existing · Tabs</span></td><td style="padding: 10px 0px 10px 8px; color: var(--kro-color-fore-secondary);">Switch categories of related information without leaving the page. Not top-level navigation.<span> — Kro Tabs is the segmented control / tablist. Fluent Tablist is the same pattern.</span></td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600;">Toolbar</td><td style="padding: 10px 8px; white-space: nowrap;"><span style="color: var(--kro-color-banner-warning);">Conflict · Toolbar</span></td><td style="padding: 10px 0px 10px 8px; color: var(--kro-color-fore-secondary);">Frequent actions for the current view, grouped.<span> — Same export name as the HIG toolbar.</span></td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600;">Tree</td><td style="padding: 10px 8px; white-space: nowrap;"><span style="color: var(--kro-role-status-ongoing);">Existing · OutlineView</span></td><td style="padding: 10px 0px 10px 8px; color: var(--kro-color-fore-secondary);">Hierarchical nested data. Rows expand in place.<span> — HIG Outline views is the tree. Fluent Tree would collide if exported as Tree.</span></td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600;">Card</td><td style="padding: 10px 8px; white-space: nowrap;"><span style="color: var(--kro-role-status-pending);">Kro · Card</span></td><td style="padding: 10px 0px 10px 8px; color: var(--kro-color-fore-secondary);">A container for one concept: header, preview, body, footer. Filled, outline or subtle.<span> — Endeavor SurfaceCard / HIG GroupedBox already group content. Fluent Card adds header/preview/footer anatomy and appearance variants. Short name Card is new.</span></td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600;">Dialog</td><td style="padding: 10px 8px; white-space: nowrap;"><span style="color: var(--kro-color-banner-warning);">Conflict · Dialog</span></td><td style="padding: 10px 0px 10px 8px; color: var(--kro-color-fore-secondary);">A supplemental surface that can require an action before work continues.<span> — Same export name as the Kro/Radix dialog primitive. Also overlaps HIG Alert.</span></td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600;">Divider</td><td style="padding: 10px 8px; white-space: nowrap;"><span style="color: var(--kro-role-status-ongoing);">Existing · Separator</span></td><td style="padding: 10px 0px 10px 8px; color: var(--kro-color-fore-secondary);">A hairline that groups sections. Optional label.<span> — HIG Separator is the hairline. Fluent Divider is the same control.</span></td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600;">Drawer</td><td style="padding: 10px 8px; white-space: nowrap;"><span style="color: var(--kro-role-status-ongoing);">Existing · Sheet</span></td><td style="padding: 10px 0px 10px 8px; color: var(--kro-color-fore-secondary);">A secondary surface that slides in from an edge.<span> — Kro Sheet already slides from any edge. Fluent Drawer is the same presentation.</span></td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600;">List</td><td style="padding: 10px 8px; white-space: nowrap;"><span style="color: var(--kro-color-banner-warning);">Conflict · List</span></td><td style="padding: 10px 0px 10px 8px; color: var(--kro-color-fore-secondary);">Like items stacked vertically.<span> — Same export name as the HIG list.</span></td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600;">Menu</td><td style="padding: 10px 8px; white-space: nowrap;"><span style="color: var(--kro-role-status-ongoing);">Existing · DropdownMenu</span></td><td style="padding: 10px 0px 10px 8px; color: var(--kro-color-fore-secondary);">A hidden list of options shown from a trigger.<span> — Kro DropdownMenu is the menu. Fluent Menu would collide if exported as Menu.</span></td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600;">Popover</td><td style="padding: 10px 8px; white-space: nowrap;"><span style="color: var(--kro-color-banner-warning);">Conflict · Popover</span></td><td style="padding: 10px 0px 10px 8px; color: var(--kro-color-fore-secondary);">A small surface anchored to a control for nonessential context.<span> — Same export name as the Kro popover primitive.</span></td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600;">Badge</td><td style="padding: 10px 8px; white-space: nowrap;"><span style="color: var(--kro-role-status-pending);">Kro · Badge</span></td><td style="padding: 10px 0px 10px 8px; color: var(--kro-color-fore-secondary);">A status or description of an associated control. Colour is never the only signal — the text is.<span> — Endeavor CardBadge is a 20px capsule for card corners. Fluent Badge is the generic status chip with appearances, sizes and colours.</span></td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600;">Message bar</td><td style="padding: 10px 8px; white-space: nowrap;"><span style="color: var(--kro-role-status-pending);">Kro · MessageBar</span></td><td style="padding: 10px 0px 10px 8px; color: var(--kro-color-fore-secondary);">Important information about the product or the current surface. Intent is named in words.<span> — Endeavor InlineBanner is info/warning/error. Fluent MessageBar adds success and single/multiline layouts.</span></td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600;">Progress bar</td><td style="padding: 10px 8px; white-space: nowrap;"><span style="color: var(--kro-role-status-ongoing);">Existing · ProgressIndicator</span></td><td style="padding: 10px 0px 10px 8px; color: var(--kro-color-fore-secondary);">How far a determinate task has got, or that one is still running.<span> — HIG Progress indicators already cover bar, circular and indeterminate.</span></td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600;">Spinner</td><td style="padding: 10px 8px; white-space: nowrap;"><span style="color: var(--kro-role-status-pending);">Kro · Spinner</span></td><td style="padding: 10px 0px 10px 8px; color: var(--kro-color-fore-secondary);">Something is processing. The label says what, not the colour.<span> — HIG ProgressIndicator kind=indeterminate is the spinner. Fluent Spinner is a dedicated export with a size ramp.</span></td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600;">Tag</td><td style="padding: 10px 8px; white-space: nowrap;"><span style="color: var(--kro-role-status-pending);">Kro · Tag</span></td><td style="padding: 10px 0px 10px 8px; color: var(--kro-color-fore-secondary);">A value someone picked (a recipient, a category). Dismissible, with a glyph and a word.<span> — KroChip is the endeavor identity/status capsule. Fluent Tag is the generic dismissible token.</span></td></tr><tr style="border-top: 1px solid var(--kro-color-hairline); vertical-align: top;"><td style="padding: 10px 8px 10px 0px; font-weight: 600;">Toast</td><td style="padding: 10px 8px; white-space: nowrap;"><span style="color: var(--kro-role-status-ongoing);">Existing · ActiveToast</span></td><td style="padding: 10px 0px 10px 8px; color: var(--kro-color-fore-secondary);">The status of an action, or something that happened elsewhere. Transient.<span> — Chrome ActiveToast is the product toast. Fluent Toast is the same job.</span></td></tr></tbody></table></div></div></div>"`;

exports[`Fluent 2 story snapshots > Persona > Gallery 1`] = `"<div><div data-slot="story-gallery" style="display: flex; flex-direction: column; gap: var(--kro-space-large);"><div data-theme="light" data-slot="hig-story-stage" style="display: flex; flex-direction: column; gap: var(--kro-space-medium); align-items: stretch; padding: var(--kro-space-large); min-height: 200px; width: 100%; background: var(--kro-color-back); color: var(--kro-color-fore); font-family: system-ui, sans-serif;"><div style="display: flex; flex-direction: column; gap: 8px;"><span style="font-size: 11px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--kro-color-fore-secondary);">extra-small</span><div style="display: flex; flex-wrap: wrap; gap: 12px; align-items: center;"><span data-slot="persona" class="inline-flex gap-kro-small flex-row items-center text-start"><span data-slot="avatar" role="img" aria-label="Ada Lovelace" class="relative inline-flex shrink-0" style="width: 20px; height: 20px;"><span class="kro-fluent-avatar h-full w-full rounded-full bg-kro-accent text-kro-on-accent" style="font-size: 8px;" aria-hidden="true">AL</span><span data-slot="presence-badge" role="img" aria-label="available" class="absolute end-0 bottom-0 rounded-full" style="width: 10px; height: 10px; background-color: var(--kro-color-focus-green); box-shadow: 0 0 0 2px var(--kro-color-back);"></span></span><span class="flex min-w-0 flex-col"><span data-slot="text" class="m-0 text-[12px] font-semibold text-kro-fore">Ada Lovelace</span><span data-slot="text" class="m-0 text-[11px] font-normal text-kro-fore-secondary">Available · Mathematician</span><span data-slot="text" class="m-0 text-[11px] font-normal text-kro-fore-secondary">Analytical Engine</span></span></span></div></div><div style="display: flex; flex-direction: column; gap: 8px;"><span style="font-size: 11px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--kro-color-fore-secondary);">small<