exports[`Fluent-origin story snapshots > Select > Gallery 1`] = `"<div><div data-slot="story-gallery" style="display: flex; flex-direction: column; gap: var(--kro-space-large);"><div data-theme="light" data-slot="hig-story-stage" style="display: flex; flex-direction: column; gap: var(--kro-space-medium); align-items: stretch; padding: var(--kro-space-large); min-height: 200px; width: 100%; background: var(--kro-color-back); color: var(--kro-color-fore); font-family: system-ui, sans-serif;"><div style="display: flex; flex-direction: column; gap: 8px;"><span style="font-size: 11px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--kro-color-fore-secondary);">Outline · hairline box</span><div style="display: flex; flex-wrap: wrap; gap: 12px; align-items: center;"><div class="flex w-full flex-col gap-kro-small text-kro-fore"><label data-slot="label" data-density="compact" for="<id>" class="text-kro-fore font-medium text-[13px]">Quadrant</label><div class="relative w-full"><select id="<id>" data-slot="select" data-density="compact" data-appearance="outline" class="kro-fluent-select flex w-full min-w-0 px-kro-small pr-8 h-6 text-xs bg-kro-back-inner text-kro-fore kro-motion-quick transition-[border-color,box-shadow] outline-none focus-visible:border-kro-accent focus-visible:shadow-[var(--kro-ring)] rounded-kro-field border border-kro-hairline"><option value="prioritize">Prioritize</option><option value="decide">Schedule</option><option value="delegate">Delegate</option><option value="delete">Archive</option></select><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down pointer-events-none absolute top-1/2 right-2 size-3.5 -translate-y-1/2 text-kro-fore-secondary" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></div></div></div></div><div style="display: flex; flex-direction: