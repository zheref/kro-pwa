exports[`Fluent 2 story snapshots > Message bar > Gallery 1`] = `"<div><div data-slot="story-gallery" style="display: flex; flex-direction: column; gap: var(--kro-space-large);"><div data-theme="light" data-slot="hig-story-stage" style="display: flex; flex-direction: column; gap: var(--kro-space-medium); align-items: stretch; padding: var(--kro-space-large); min-height: 200px; width: 100%; background: var(--kro-color-back); color: var(--kro-color-fore); font-family: system-ui, sans-serif;"><div style="display: flex; flex-direction: column; gap: 8px;"><span style="font-size: 11px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--kro-color-fore-secondary);">Info</span><div style="display: flex; flex-wrap: wrap; gap: 12px; align-items: center;"><div role="status" data-slot="message-bar" data-intent="info" data-layout="singleline" class="flex w-full gap-2.5 rounded-kro-field p-3 items-center" style="background-color: var(--kro-color-back-inner); color: var(--kro-color-fore);"><span class="sr-only">Note: </span><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-info mt-px shrink-0" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M12 16v-4"></path><path d="M12 8h.01"></path></svg><div class="flex min-w-0 flex-1 flex-row items-center gap-2"><p class="m-0 text-[13px] font-semibold leading-snug shrink-0">This host is read-only.</p></div></div></div></div><div style="display: flex; flex-direction: column; gap: 8px;"><span style="font-size: 11px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--kro-color-fore-secondary);">Success</span><div style="display: flex; flex-wrap: wrap; gap: 12px; align-items: center;"><div role="status" data-slot="message-bar" data-intent="success" data-layout="singleline" class="flex w-full gap-2.5 rounded-kro-field p-3 items-center" style="background-color: var(--kro-color-focus-green); color: var(--kro-color-snow);"><span class="sr-only">Success: </span><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-check mt-px shrink-0" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="m16 9-5.5 5.5L8 12"></path></svg><div class="flex min-w-0 flex-1 flex-row items-center gap-2"><p class="m-0 text-[13px] font-semibold leading-snug shrink-0">Changes saved.</p></div></div></div></div><div style="display: flex; flex-direction: column; gap: 8px;"><span style="font-size: 11px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--kro-color-fore-secondary);">Warning</span><div style="display: flex; flex-wrap: wrap; gap: 12px; align-items: center;"><div role="status" data-slot="message-bar" data-intent="warning" data-layout="singleline" class="flex w-full gap-2.5 rounded-kro-field p-3 items-center" style="background-color: var(--kro-color-banner-warning); color: var(--kro-color-snow);"><span class="sr-only">Warning: </span><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-triangle-alert mt-px shrink-0" aria-hidden="true"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3"></path><path d="M12 9v4"></path><path d="M12 17h.01"></path></svg><div class="flex min-w-0 flex-1 flex-row items-center gap-2"><p class="m-0 text-[13px] font-semibold leading-snug shrink-0">This endeavor is past its expiry.</p><p class="m-0 text-[13px] leading-snug truncate" style="color: rgba(255, 255, 255, 0.7);">It will stop appearing in Do at midnight.</p></div></div></div></div><div style="display: flex; flex-direction: column; gap: 8px;