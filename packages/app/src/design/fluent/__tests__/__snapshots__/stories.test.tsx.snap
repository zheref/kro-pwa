exports[`Fluent 2 story snapshots > Badge > Gallery 1`] = `"<div><div data-slot="story-gallery" style="display: flex; flex-direction: column; gap: var(--kro-space-large);"><div data-theme="light" data-slot="hig-story-stage" style="display: flex; flex-direction: column; gap: var(--kro-space-medium); align-items: stretch; padding: var(--kro-space-large); min-height: 200px; width: 100%; background: var(--kro-color-back); color: var(--kro-color-fore); font-family: system-ui, sans-serif;"><div style="display: flex; flex-direction: column; gap: 8px;"><span style="font-size: 11px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--kro-color-fore-secondary);">Filled</span><div style="display: flex; flex-wrap: wrap; gap: 12px; align-items: center;"><span data-slot="badge" data-appearance="filled" data-size="medium" data-shape="rounded" data-color="brand" class="inline-flex max-w-full shrink-0 items-center justify-center font-semibold whitespace-nowrap h-7 min-w-7 px-2.5 text-xs rounded-kro-small" style="background-color: var(--kro-color-accent); color: var(--kro-color-on-accent);">New</span><span data-slot="badge" data-appearance="filled" data-size="medium" data-shape="rounded" data-color="success" class="inline-flex max-w-full shrink-0 items-center justify-center font-semibold whitespace-nowrap h-7 min-w-7 px-2.5 text-xs rounded-kro-small" style="background-color: var(--kro-color-focus-green); color: var(--kro-color-snow);">Done</span><span data-slot="badge" data-appearance="filled" data-size="medium" data-shape="rounded" data-color="danger" class="inline-flex max-w-full shrink-0 items-center justify-center font-semibold whitespace-nowrap h-7 min-w-7 px-2.5 text-xs rounded-kro-small" style="background-color: var(--kro-color-banner-danger); color: var(--kro-color-snow);">Failed</span></div></div><div style="display: flex; flex-direction: column; gap: 8px;"><span style="font-size: 11px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--kro-color-fore-secondary);">Ghost</span><div style="display: flex; flex-wrap: wrap; gap: 12px; align-items: center;"><span data-slot="badge" data-appearance="ghost" data-size="medium" data-shape="rounded" data-color="brand" class="inline-flex max-w-full shrink-0 items-center justify-center font-semibold whitespace-nowrap h-7 min-w-7 px-2.5 text-xs rounded-kro-small" style="color: var(--kro-color-accent);">Draft</span><span data-slot="badge" data-appearance="ghost" data-size="medium" data-shape="rounded" data-color="informative" class="inline-flex max-w-full shrink-0 items-center justify-center font-semibold whitespace-nowrap h-7 min-w-7 px-2.5 text-xs rounded-kro-small" style="color: var(--kro-color-cozy-blue);">Info</span></div></div><div style="display: flex; flex-direction: column; gap: 8px;"><span style="font-size: 11px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--kro-color-fore-secondary);">Outline</span><div style="display: flex; flex-wrap: wrap; gap: 12px; align-items: center;"><span data-slot="badge" data-appearance="outline" data-size="medium" data-shape="rounded" data-color="warning" class="inline-flex max-w-full shrink-0 items-center justify-center font-semibold whitespace-nowrap h-7 min-w-7 px-2.5 text-xs rounded-kro-small" style="color: var(--kro-color-badge-orange); box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--kro-color-badge-orange) 55%, transparent);">Late</span><span data-slot="badge" data-appearance="outline" data-size="medium" data-shape="rounded" data-color="severe" class="inline-flex max-w-full shrink-0 items-center justify-center font-semibold whitespace-nowrap h-7 min-w-7 px-2.5 text-xs rounded-kro-small" style="color: var(--kro-color-banner-warning); box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--kro-color-banner-warning) 55%, transparent);">Blocked</span></div></div><div style="display: flex; flex-direction: column; gap: 8px;"><span style="font-size: 11px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--kro-color-fore-secondary);">Tint</span><div style="display: flex; flex-wrap: wrap; gap: 12px; align-items: center;"><span data-slot="badge" data-appearance="tint" data-size="medium" data-shape="rounded" data-color="brand" class="inline-flex max-w-full shrink-0 items-center justify-center font-semibold whitespace-nowrap h-7 min-w-7 px-2.5 text-xs rounded-kro-small" style="background-color: color-mix(in srgb, var(--kro-color-accent) 16%, transparent); color: var(--kro-color-accent);">Live</span><span data-slot="badge" data-appearance="tint" data-size="medium" data-shape="rounded" data-color="important" class="inline-flex max-w-full shrink-0 items-center justify-center font-semibold whitespace-nowrap h-7 min-w-7 px-2.5 text-xs rounded-kro-small" style="background-color: color-mix(in srgb, var(--kro-color-payne-gray) 16%, transparent); color: var(--kro-color-payne-gray);">Pinned</span></div></div></div><div data-theme="light" data-slot="hig-story-stage" style="display: flex; flex-direction: column; gap: var(--kro-space-medium); align-items: stretch; padding: var(--kro-space-large); min-height: 200px; width: 100%; background: var(--kro-color-back); color: var(--kro-color-fore); font-family: system-ui, sans-serif;"><div style="display: flex; flex-direction: column; gap: 8px;"><span style="font-size: 11px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--kro-color-fore-secondary);">Filled</span><div style="display: flex; flex-wrap: wrap; gap: 12px; align-items: center;"><span data-slot="badge" data-appearance="filled" data-size="medium" data-shape="rounded" data-color="brand" class="inline-flex max-w-full shrink-0 items-center justify-center font-semibold whitespace-nowrap h-7 min-w-7 px-2.5 text-xs rounded-kro-small" style="background-color: var(--kro-color-accent); color: var(--kro-color-on-accent);">brand</span><span data-slot="badge" data-appearance="filled" data-siz