exports[`Fluent-origin story snapshots > Skeleton > Gallery 1`] = `"<div><div data-slot="story-gallery" style="display: flex; flex-direction: column; gap: var(--kro-space-large);"><div data-theme="light" data-slot="hig-story-stage" style="display: flex; flex-direction: column; gap: var(--kro-space-medium); align-items: stretch; padding: var(--kro-space-large); min-height: 200px; width: 100%; background: var(--kro-color-back); color: var(--kro-color-fore); font-family: system-ui, sans-serif;"><div style="display: flex; flex-direction: column; gap: 8px;"><span style="font-size: 11px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--kro-color-fore-secondary);">A row of content arriving</span><div style="display: flex; flex-wrap: wrap; gap: 12px; align-items: center;"><span class="sr-only">Loading</span><div data-slot="skeleton" data-animation="pulse" data-appearance="opaque" aria-hidden="true" class="flex w-full flex-col gap-2"><span data-slot="skeleton-item" data-animation="pulse" data-appearance="opaque" data-shape="rectangle" aria-hidden="true" class="kro-fluent-skeleton overflow-hidden" style="width: 100%; height: 12px;"></span><span data-slot="skeleton-item" data-animation="pulse" data-appearance="opaque" data-shape="rectangle" aria-hidden="true" class="kro-fluent-skeleton overflow-hidden" style="width: 80%; height: 12px;"></span><span data-slot="skeleton-item" data-animation="pulse" data-appearance="opaque" data-shape="rectangle" aria-hidden="true" class="kro-fluent-skeleton overflow-hidden" style="width: 60%; height: 12px;"></span></div></div></div></div><div data-theme="light" data-slot="hig-story-stage" style="display: flex; flex-direction: column; gap: var(--kro-space-medium); align-items: stretch; padding: var(--kro-space-large); min-height: 200px; width: 100%; background: var(--kro-color-back); color: var(--kro-color-fore); font-family: system-ui, sans-serif;"><div style="display: flex; flex-direction: column; gap: 8px;"><sp