exports[`HIG-origin story snapshots > Panel > Gallery 1`] = `"<div><div data-slot="story-gallery" style="display: flex; flex-direction: column; gap: var(--kro-space-large);"><div data-theme="light" data-slot="hig-story-stage" style="display: flex; flex-direction: column; gap: var(--kro-space-medium); align-items: stretch; padding: var(--kro-space-large); min-height: 200px; width: 100%; background: linear-gradient(135deg, var(--kro-color-header-gradient-indigo), var(--kro-color-header-gradient-grape)); color: var(--kro-color-fore); font-family: system-ui, sans-serif;"><div style="display: flex; flex-direction: column; gap: 8px;"><span style="font-size: 11px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--kro-color-fore-secondary);">Inspector</span><div style="display: flex; flex-wrap: wrap; gap: 12px; align-items: center;"><div class="kro-glass flex min-h-0 min-w-0 overflow-hidden flex-col rounded-kro-surface p-kro-medium" data-slot="panel" data-density="compact" style="width: 320px;"><div class="mb-kro-small flex items-center gap-kro-small min-h-6 text-xs"><h2 class="min-w-0 flex-1 font-semibold text-kro-fore text-lg">Endeavor properties</h2><button type="button" class="inline-flex shrink-0 items-center justify-center rounded-kro-small size-6 text-kro-fore-secondary hover:text-kro-fore outline-none focus-visible:shadow-[var(--kro-ring)]"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-x size-5" aria-hidden="true"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg><span class="sr-only">Close</span></button></div><div style="display: flex; justify-content: space-between; gap: 12px; min-height: 44px; align-items: center; border-bottom: 1px solid var(--kro-color-hairline);"><span style="color: var(--kro-color-fore-secondary); font-size: 13px;">Kind</span><span style="color: