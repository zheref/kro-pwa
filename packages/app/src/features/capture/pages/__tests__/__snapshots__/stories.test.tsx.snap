exports[`story snapshots > InboxDestinationPage > EmptyTray 1`] = `"<div><div data-theme="light" style="min-height: 420px; background: var(--kro-color-back); font-family: system-ui, sans-serif;"><div style="height: 620px;"><section data-testid="inbox-surface" data-kro-presentation="inline" aria-label="Inbox" class="relative flex h-full min-h-0 w-full flex-col"><div class="shrink-0"><header data-slot="compact-presentation-header" class="flex w-full items-center gap-2.5 px-3 py-2.5" style="background-color: color-mix(in srgb, var(--kro-color-fore) 2.5%, transparent);"><div class="flex min-w-0 flex-col gap-px"><p class="m-0 truncate text-base font-semibold" style="color: var(--kro-color-fore);">Inbox</p></div></header></div><div class="flex min-h-0 flex-1 flex-col"><div data-slot="inbox-tray-empty-state" class="flex w-full flex-1 flex-col items-center justify-center gap-3 py-kro-x-large text-center"><svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-inbox" aria-hidden="true" style="color: color-mix(in srgb, var(--kro-color-fore-secondary) 45%, transparent);"><polyline points="22 12 16 12 14 15 10 15 8 12 2 12"></polyline><path d="M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z"></path></svg><p class="m-0 text-base font-semibold" style="color: var(--kro-color-fore-secondary);">Inbox is empty</p><p class="m-0 text-sm" style="color: color-mix(in srgb, var(--kro-color-fore-secondary) 70%, transparent);">Recently added endeavors will appear here</p></div></div></section></div></div></div>"`;

