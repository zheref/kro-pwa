exports[`story snapshots > CaptureSuggestionsFragment > TwoSelected 1`] = `"<div><div data-theme="dark" style="min-height: 420px; background: var(--kro-color-back); font-family: system-ui, sans-serif;"><div style="width: 680px; height: 360px; padding: 16px;"><section aria-label="Suggestions" data-testid="capture-suggestions" class="kro-glass flex h-full flex-col overflow-hidden" style="border-radius: var(--kro-radius-panel); box-shadow: var(--kro-shadow-surface); padding: var(--kro-space-medium) var(--kro-space-medium) 0; gap: var(--kro-space-small);"><div class="flex shrink-0 items-baseline text-xs" style="gap: var(--kro-space-small);"><h2 class="relative m-0 font-semibold text-base" style="color: var(--kro-color-fore);"><span aria-hidden="true" data-slot="button-shortcut" data-placement="keycap" data-revealed="false" class="pointer-events-none font-medium" style="position: absolute; top: -7px; left: -4px; z-index: 1; padding: 1px 3px; font-size: 11px; line-height: 1.1; white-space: nowrap; border-radius: 4px; border: 1px solid var(--kro-color-hairline); background: var(--kro-color-back); color: var(--kro-color-fore-secondary); opacity: 0; transition-property: opacity; transition-duration: var(--kro-duration-quick, 180ms); transition-timing-function: var(--kro-ease-standard);">⌥S</span>Suggestions</h2><span aria-hidden="true" data-testid="capture-suggestions-keys" class="min-w-0 flex-1 truncate" style="color: var(--kro-color-fore-secondary-on-glass);">⌥S to browse with the keyboard</span><button data-slot="button" data-shape="rounded" data-size="sm" type="button" class="inline-flex shrink-0 items-center justify-center gap-1 cursor-default whitespace-nowrap font-medium kro-motion-quick transition-[color,background-color,box-shadow,transform] outline-none focus-visible:shadow-[var(--kro-ring)] active:scale-[0.97] disabled:pointer-events-none disabled:opacity-[var(--kro-opacity-disabled)] [&amp;_svg]:pointer-events-none [&amp;_svg:not([class*='size-'])]:size-3.5 kro-g