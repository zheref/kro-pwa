exports[`story snapshots > InboxDestinationPage > DesktopDark 1`] = `"<div><div data-theme="dark" style="min-height: 420px; background: var(--kro-color-back); font-family: system-ui, sans-serif;"><div style="height: 620px;"><section data-testid="inbox-surface" data-kro-presentation="inline" aria-label="Inbox" class="relative flex h-full min-h-0 w-full flex-col"><div class="shrink-0"><header data-slot="compact-presentation-header" class="flex w-full items-center gap-2.5 px-3 py-2.5" style="background-color: color-mix(in srgb, var(--kro-color-fore) 2.5%, transparent);"><div class="flex min-w-0 flex-col gap-px"><p class="m-0 truncate text-base font-semibold" style="color: var(--kro-color-fore);">Inbox</p><p class="m-0 truncate text-xs" style="color: var(--kro-color-fore-secondary);">4 endeavors</p></div></header></div><div class="flex min-h-0 flex-1 flex-col gap-4 overflow-y-auto py-2"><section aria-label="Pending Triage" data-testid="inbox-section-pending-triage" class="flex flex-col gap-2 px-2.5"><header class="flex items-center gap-2 pt-2"><span style="color: var(--kro-color-fore-secondary);"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-inbox" aria-hidden="true"><polyline points="22 12 16 12 14 15 10 15 8 12 2 12"></polyline><path d="M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z"></path></svg></span><h3 class="m-0 font-semibold text-sm" style="color: var(--kro-color-fore-secondary);">Pending Triage</h3><span class="flex-1"></span><span class="rounded-kro-pill px-2 py-0.5 font-bold text-xs" style="color: var(--kro-color-fore-secondary); background-color: color-mix(in srgb, var(--kro-color-fore) 8%, transparent);">4</span></header><ul class="m-0 flex list-none flex-col p-0 gap-1"><li><div class="flex flex-col gap-2"><div data-slot="endeavor-action-surfac