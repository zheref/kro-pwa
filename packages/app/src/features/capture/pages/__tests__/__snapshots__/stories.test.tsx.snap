exports[`story snapshots > CapturePromptPage > ClosedRendersNothing 1`] = `"<div><div data-theme="light" style="min-height: 420px; background: var(--kro-color-back); font-family: system-ui, sans-serif;"></div></div>"`;

exports[`story snapshots > CapturePromptPage > EventBlockedOnTimes 1`] = `"<span data-radix-focus-guard="" tabindex="0" style="outline: none; opacity: 0; position: fixed; pointer-events: none;" data-aria-hidden="true" aria-hidden="true"></span><div data-aria-hidden="true" aria-hidden="true"><div data-theme="light" style="min-height: 420px; background: var(--kro-color-back); font-family: system-ui, sans-serif;"></div></div><div data-state="open" data-slot="dialog-overlay" class="fixed inset-0 z-50 bg-black/40 kro-fade-overlay" style="pointer-events: auto;" data-aria-hidden="true" aria-hidden="true"></div><div role="dialog" id="radix-_r_2c_" data-state="open" data-slot="sheet-content" data-side="bottom" class="kro-glass fixed z-50 flex flex-col gap-kro-medium p-kro-large kro-motion-standard-spring transition-transform kro-sheet-bottom inset-x-0 bottom-0 max-h-[85vh] rounded-t-kro-surface rounded-b-none h-auto gap-0 p-0" style="position: fixed; pointer-events: auto;" data-testid="capture-prompt" data-kro-presentation="sheet" tabindex="-1" aria-describedby="radix-_r_2e_" aria-labelledby="radix-_r_2d_"><div aria-hidden="true" class="mx-auto h-1 w-10 shrink-0 rounded-kro-pill bg-kro-hairline"></div><h2 id="radix-_r_2d_" data-slot="dialog-title" class="font-semibold text-kro-fore text-lg sr-only">New Event</h2><p id="radix-_r_2e_" data-slot="dialog-description" class="text-kro-fore-secondary text-sm sr-only">Name this event…</p><div class="relative flex flex-col" data-slot="capture-prompt-form" data-kro-density="touch"><div class="relative flex justify-center px-3 pt-4 pb-3"><div role="group" aria-label="Kind" data-kro-segmented="" data-kro-density="comfortable" data-kro-fill="" class="@container flex w-full" style="border-radius: var(--kro-radius-pill); background: color-mix(in srgb, var(--kro-color-fore) 10%, transparent); pointer-events: auto;"><button type="button" aria-pressed="false" data-kro-segment="available" class="relative inline-flex items-center justify-center