">iPad</span></label><label class="relative flex min-h-11 cursor-pointer"><input class="peer absolute inset-0 m-0 size-full cursor-pointer opacity-0" type="radio" value="macos" name="early-access-platform"><span class="flex w-full items-center justify-center rounded-kro-pill border border-kro-hairline px-kro-small text-kro-fore text-sm peer-checked:border-transparent peer-checked:bg-kro-accent peer-checked:font-semibold peer-checked:text-kro-on-accent peer-focus-visible:shadow-[var(--kro-ring)]">Mac</span></label><label class="relative flex min-h-11 cursor-pointer"><input class="peer absolute inset-0 m-0 size-full cursor-pointer opacity-0" type="radio" value="watchos" name="early-access-platform"><span class="flex w-full items-center justify-center rounded-kro-pill border border-kro-hairline px-kro-small text-kro-fore text-sm peer-checked:border-transparent peer-checked:bg-kro-accent peer-checked:font-semibold peer-checked:text-kro-on-accent peer-focus-visible:shadow-[var(--kro-ring)]">Apple Watch</span></label><label class="relative flex min-h-11 cursor-pointer"><input class="peer absolute inset-0 m-0 size-full cursor-pointer opacity-0" type="radio" value="web" name="early-access-platform"><span class="flex w-full items-center justify-center rounded-kro-pill border border-kro-hairline px-kro-small text-kro-fore text-sm peer-checked:border-transparent peer-checked:bg-kro-accent peer-checked:font-semibold peer-checked:text-kro-on-accent peer-focus-visible:shadow-[var(--kro-ring)]">Web</span></label><label class="relative flex min-h-11 cursor-pointer"><input class="peer absolute inset-0 m-0 size-full cursor-pointer opacity-0" type="radio" value="android" name="early-access-platform"><span class="flex w-full items-center justify-center rounded-kro-pill border border-kro-hairline px-kro-small text-kro-fore text-sm peer-checked:border-transparent peer-checked:bg-kro-accent peer-checked:font-semibold peer-checked:text-kro-on-accent peer-focus-visible:shadow-[var(--kro-ring)]">Android</span></label><label class="relative flex min-h-11 cursor-pointer"><input class="peer absolute inset-0 m-0 size-full cursor-pointer opacity-0" type="radio" value="windows" name="early-access-platform"><span class="flex w-full items-center justify-center rounded-kro-pill border border-kro-hairline px-kro-small text-kro-fore text-sm peer-checked:border-transparent peer-checked:bg-kro-accent peer-checked:font-semibold peer-checked:text-kro-on-accent peer-focus-visible:shadow-[var(--kro-ring)]">Windows</span></label></div></fieldset><div aria-hidden="true" style="position: absolute; left: -10000px; width: 1px; height: 1px; overflow: hidden;"><label for="_r_o_-website">Website</label><input id="_r_o_-website" tabindex="-1" autocomplete="off" type="text" value="" name="website"></div><div class="flex flex-wrap items-center gap-kro-medium"><button data-slot="button" data-shape="circular" data-size="lg" type="submit" class="inline-flex shrink-0 items-center justify-center gap-1 cursor-default whitespace-nowrap font-medium kro-motion-quick transition-[color,background-color,box-shadow,transform] outline-none focus-visible:shadow-[var(--kro-ring)] active:scale-[0.97] disabled:pointer-events-none disabled:opacity-[var(--kro-opacity-disabled)] [&amp;_svg]:pointer-events-none kro-glass kro-glass--control kro-glass--accent kro-glass--interactive text-kro-on-accent h-11 rounded-kro-small px-kro-medium text-sm rounded-kro-pill [&amp;_svg:not([class*='size-'])]:size-4">Get early access</button><p class="m-0 max-w-[40ch] text-sm" style="color: var(--kro-color-fore-secondary-on-glass);">We don't show sign-up counts, ratings or quotes here. We'll email you when your platform is ready.</p></div></form></div></div></div></div></section></div></div>"`;

exports[`landing story snapshots > EarlyAccessSection > JoinedPhone 1`] = `"<div><div data-theme="light" data-kro-idiom="mobile" data-slot="marketing-story-stage" style="width: 390px; max-width: 100%; background: var(--kro-color-back); color: var(--kro-color-fore); font-family: system-ui, sans-serif;"><section id="early-access" data-tone="canvas" aria-labelledby="early-access-title" class="kro-marketing-section"><div class="kro-marketing-container kro-marketing-container--narrow"><div aria-hidden="true" class="pointer-events-none absolute inset-0"><span class="kro-glow-blob" style="top: 10%; left: -20%; opacity: 0.35;"></span><span class="kro-glow-blob kro-glow-blob--grape" style="bottom: -10%; right: -20%; opacity: 0.35;"></span></div><div class="relative"><header data-align="start" data-level="2" class="kro-section-header kro-section-header--on-glow"><p class="kro-eyebrow">Early access</p><h2 id="early-access-title" class="kro-display-2">Be first through the door.</h2><p class="kro-lede">Tell us where you want Kro, and we will write when it is ready for you.</p></header><div data-reveal="idle" class="kro-reveal"><div class="kro-glass grid gap-kro-medium p-6 text-kro-fore md:p-10" data-state="joined"><h3 class="m-0 font-semibold text-2xl" tabindex="-1">You're on the list for iPhone</h3><p class="m-0 text-base" style="color: var(--kro-color-fore-secondary-on-glass);" role="status">We'll email ada@example.com when your platform is ready. You are number 3 in line.</p><div class="flex flex-wrap gap-kro-small"><a href="/my-day" data-slot="button" data-shape="circular" data-size="lg" class="inline-flex shrink-0 items-center justify-center gap-1 cursor-default whitespace-nowrap font-medium kro-motion-quick transition-[color,background-color,box-shadow,transform] outline-none focus-visible:shadow-[var(--kro-ring)] active:scale-[0.97] disabled:pointer-events-none disabled:opacity-[var(--kro-opacity-disabled)] [&amp;_svg]:pointer-events-none kro-glass kro-glass--control kro-glass--accent kro-glass--interactive text-kro-on-accent h-11 rounded-kro-small px-kro-medium text-sm rounded-kro-pill [&amp;_svg:not([class*='size-'])]:size-4">Open Kro for Web</a><button data-slot="button" data-shape="circular" data-size="lg" type="button" class="inline-flex shrink-0 items-center justify-center gap-1 cursor-default whitespace-nowrap font-medium kro-motion-quick transition-[color,background-color,box-shadow,transform] outline-none focus-visible:shadow-[var(--kro-ring)] active:scale-[0.97] disabled:pointer-events-none disabled:opacity-[var(--kro-opacity-disabled)] [&amp;_svg]:pointer-events-none kro-glass kro-glass--control kro-glass--interactive text-kro-fore h-11 rounded-kro-small px-kro-medium text-sm rounded-kro-pill [&amp;_svg:not([class*='size-'])]:size-4">Add another address</button></div></div></div></div></div></section></div></div>"`;

