exports[`landing story snapshots > FocusSection > Dark 1`] = `"<div><div data-theme="dark" data-kro-idiom="desktop" data-slot="marketing-story-stage" style="width: 100%; max-width: 100%; background: var(--kro-color-back); color: var(--kro-color-fore); font-family: system-ui, sans-serif;"><section id="focus" data-tone="subtle" aria-labelledby="focus-title" class="kro-marketing-section"><div class="kro-marketing-container kro-marketing-container--wide"><header data-align="start" data-level="2" class="kro-section-header"><p class="kro-eyebrow">Focus</p><h2 id="focus-title" class="kro-display-2">Stay with one thing.</h2><p class="kro-lede">Start a Session from any endeavor: a countdown or a stopwatch, with breaks built in.</p></header><div class="grid grid-cols-1 items-center gap-kro-xx-large lg:grid-cols-2"><ul data-reveal="idle" class="kro-reveal m-0 grid grid-cols-1 list-none gap-kro-large p-0"><li class="flex gap-kro-medium"><span aria-hidden="true" class="mt-1 inline-flex size-11 shrink-0 items-center justify-center rounded-kro-field border border-kro-hairline text-kro-accent"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-timer" aria-hidden="true"><line x1="10" x2="14" y1="2" y2="2"></line><line x1="12" x2="15" y1="14" y2="11"></line><circle cx="12" cy="14" r="8"></circle></svg></span><div><h3 class="m-0 font-semibold text-kro-fore text-lg">Countdown or stopwatch</h3><p class="m-0 mt-1 text-kro-fore-secondary">Count down to a goal, or count up when the work decides how long it takes. Breaks are part of the rhythm, not an interruption of it.</p></div></li><li class="flex gap-kro-medium"><span aria-hidden="true" class="mt-1 inline-flex size-11 shrink-0 items-center justify-center rounded-kro-field border border-kro-hairline text-kro-accent"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-layers" aria-hidden="true"><path d="M12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83z"></path><path d="M2 12a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 12"></path><path d="M2 17a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 17"></path></svg></span><div><h3 class="m-0 font-semibold text-kro-fore text-lg">The Session Pill</h3><p class="m-0 mt-1 text-kro-fore-secondary">While a Session runs, a small pill follows you around the app, so you never lose your place or the time.</p></div></li><li class="flex gap-kro-medium"><span aria-hidden="true" class="mt-1 inline-flex size-11 shrink-0 items-center justify-center rounded-kro-field border border-kro-hairline text-kro-accent"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-smartphone" aria-hidden="true"><rect width="14" height="20" x="5" y="2" rx="2" ry="2"></rect><path d="M12 18h.01"></path></svg></span><div><h3 class="m-0 font-semibold text-kro-fore text-lg">On the Lock Screen</h3><p class="m-0 mt-1 text-kro-fore-secondary">On iPhone, a Live Activity keeps your running Session on the Lock Screen, with Pause and Finish within reach.</p></div></li><li class="flex gap-kro-medium"><span aria-hidden="true" class="mt-1 inline-flex size-11 shrink-0 items-center justify-center rounded-kro-field border border-kro-hairline text-kro-accent"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-watch" aria-hidden="true"><path d="M12 10v2.2l1.6 1"></path><path d="m16.13 7.66-.81-4.05a2 2 0 0 0-2-1.61h-2.68a2 2 0 0 0-2 1.61l-.78 4.05"></path><path d="m7.88 16.36.8 4a2 2 0 0 0 2 1.61h2.72a2 2 0 0 0 2-1.61l.81-4.05"></path><circle cx="12" cy="12" r="6"></circle></svg></span><div><h3 class="m-0 font-semibold text-kro-fore text-lg">On your wrist</h3><p class="m-0 mt-1 text-kro-fore-secondary">The wrist is a mirror, not a second opinion.</p></div></li></ul><div data-reveal="idle" class="kro-reveal grid grid-cols-1 justify-items-center gap-kro-x-large"><div class="flex items-end justify-center gap-kro-large"><div class="w-[min(60vw,260px)]"><div class="kro-device kro-device--phone" style="--kro-device-w: 800px;"><img width="780" height="1342" decoding="async" loading="lazy" alt="Kro's focus session sheet on a phone-sized window: a Pomodoro clock counting down from fifteen minutes for the task Prepare slides, with pause and stop buttons." src="/landing/web/web-session-mobile-dark.webp"></div></div><div class="w-[min(26vw,120px)]"><div class="kro-device kro-device--watch" style="--kro-device-w: 412px;"><img width="396" height="484" decoding="async" loading="lazy" alt="Kro on Apple Watch: a Now Hero card for the high-priority task Prepare presentation at 7:00 PM with a Start Focus 45m button." src="/landing/watchos/watch-featured.webp"></div></div></div><figure class="m-0 w-full max-w-[420px]"><img width="844" height="384" alt="Kro's lock screen Live Activity on iPhone: a purple card reading Focusing, Draft release notes and 15:00, with Pause and Finish buttons." loading="lazy" decoding="async" class="block h-auto w-full rounded-kro-surface border border-kro-hairline shadow-kro-card" src="/landing/ios/ios-live-activity-running.webp"></figure></div></div></div></section></div></div>"`;

