exports[`landing story snapshots > EarlyAccessSection > Idle 1`] = `"<div><div data-theme="light" data-kro-idiom="desktop" data-slot="marketing-story-stage" style="width: 100%; max-width: 100%; background: var(--kro-color-back); color: var(--kro-color-fore); font-family: system-ui, sans-serif;"><section id="early-access" data-tone="canvas" aria-labelledby="early-access-title" class="kro-marketing-section"><div class="kro-marketing-container kro-marketing-container--narrow"><div aria-hidden="true" class="pointer-events-none absolute inset-0"><span class="kro-glow-blob" style="top: 10%; left: -20%; opacity: 0.35;"></span><span class="kro-glow-blob kro-glow-blob--grape" style="bottom: -10%; right: -20%; opacity: 0.35;"></span></div><div class="relative"><header data-align="start" data-level="2" class="kro-section-header kro-section-header--on-glow"><p class="kro-eyebrow">Early access</p><h2 id="early-access-title" class="kro-display-2">Be first through the door.</h2><p class="kro-lede">Tell us where you want Kro, and we will write when it is ready for you.</p></header><div data-reveal="idle" class="kro-reveal"><div class="kro-glass p-6 text-kro-fore md:p-10" data-state="idle"><form novalidate="" aria-busy="false" class="grid gap-kro-large"><div role="group" data-slot="field" data-density="compact" data-orientation="vertical" data-validation="none" aria-labelledby="_r_p_-label" class="w-full text-kro-fore flex flex-col gap-kro-small"><span id="_r_p_-label" class="shrink-0"><label data-slot="label" data-density="compact" for="_r_o_-email" class="text-kro-fore font-medium text-[13px]">Email address<span aria-hidden="true">*</span><span class="sr-only"> required</span></label></span><div class="flex min-w-0 flex-1 flex-col gap-kro-tiny"><input data-slot="input" data-density="comfortable" class="flex w-full min-w-0 rounded-kro-field px-kro-small h-9 text-sm bg-kro-back-inner text-kro-fore border border-kro-hairline placeholder:text-kro-fore-secondary kro-motion-quick transi