k-0 transition-transform" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg><span class="min-w-0 flex-1 font-medium">Which platforms?</span></button><div id="_r_v_-platforms-panel" role="region" aria-labelledby="_r_v_-platforms-header" hidden="" data-slot="accordion-panel" class="px-kro-medium pb-kro-small text-kro-fore"><p class="m-0 text-kro-fore-secondary">The web is live. iPhone, iPad, Mac and Apple Watch are in early access on TestFlight, Android is in progress and Windows is coming. Vote for the one you want sooner.</p></div></div><div data-slot="accordion-item"><div aria-hidden="true" data-slot="accordion-divider" class="h-px bg-kro-hairline"></div><button type="button" id="_r_v_-todo-header" aria-expanded="false" aria-controls="_r_v_-todo-panel" class="flex w-full items-center gap-kro-small px-kro-medium min-h-9 text-sm text-left text-kro-fore outline-none focus-visible:shadow-[var(--kro-ring)]"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-right kro-motion-quick shrink-0 transition-transform" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg><span class="min-w-0 flex-1 font-medium">How is this different from a to-do list?</span></button><div id="_r_v_-todo-panel" role="region" aria-labelledby="_r_v_-todo-header" hidden="" data-slot="accordion-panel" class="px-kro-medium pb-kro-small text-kro-fore"><p class="m-0 text-kro-fore-secondary">A to-do list stores tasks. Kro runs the whole loop: Capture, Triage with Value and Effort, Plan, Do with focus Sessions, and Earn what you have worked for.</p></div></div></div></div></div></section></div></div>"`;

exports[`landing story snapshots > FederationSection > Dark 1`] = `"<div><div data-theme="dark" data-kro-idiom="desktop" data-slot="marketing-story-stage" style="width: 100%; max-width: 100%; background: var(--kro-color-back); color: var(--kro-color-fore); font-family: system-ui, sans-serif;"><section id="federation" data-tone="subtle" aria-labelledby="federation-title" class="kro-marketing-section"><div class="kro-marketing-container kro-marketing-container--wide"><header data-align="start" data-level="2" class="kro-section-header"><p class="kro-eyebrow">Federation</p><h2 id="federation-title" class="kro-display-2">Kro is a federation, not an island</h2><p class="kro-lede">Your plans meet the tools you already use, instead of asking you to leave them.</p></header><div data-reveal="idle" class="kro-reveal grid grid-cols-1 gap-kro-large sm:grid-cols-2 lg:grid-cols-4"><article class="kro-feature-card" style="--kro-card-accent: var(--kro-color-accent);"><span class="kro-feature-card__icon" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-cloud" aria-hidden="true"><path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z"></path></svg></span><h3 class="kro-feature-card__title">Kro Cloud</h3><p class="kro-feature-card__body">Sign in to Kro — sync your plans across devices.</p></article><article class="kro-feature-card" style="--kro-card-accent: var(--kro-color-accent);"><span class="kro-feature-card__icon" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-calendar-days" aria-hidden="true"><path d="M8 2v3"></path><path d="M16 2v3"></path><rect x="3" y="3" width="18" height="18" rx="2"></rect><path d="M3 9h18"></path><path d="M8 13h.