ria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-eye-off" aria-hidden="true"><path d="M10.733 5.076a10.744 10.744 0 0 1 11.205 6.575 1 1 0 0 1 0 .696 10.747 10.747 0 0 1-1.444 2.49"></path><path d="M14.084 14.158a3 3 0 0 1-4.242-4.242"></path><path d="M17.479 17.499a10.75 10.75 0 0 1-15.417-5.151 1 1 0 0 1 0-.696 10.75 10.75 0 0 1 4.446-5.143"></path><path d="m2 2 20 20"></path></svg></span><h3 class="kro-feature-card__title">We never send what you write</h3><p class="kro-feature-card__body">Counts, timings, the page you are on and your browser's size and language — never the words you write.</p></article><article class="kro-feature-card" style="--kro-card-accent: var(--kro-color-accent);"><span class="kro-feature-card__icon" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-fingerprint-pattern" aria-hidden="true"><path d="M12 10a2 2 0 0 0-2 2c0 1.02-.1 2.51-.26 4"></path><path d="M14 13.12c0 2.38 0 6.38-1 8.88"></path><path d="M17.29 21.02c.12-.6.43-2.3.5-3.02"></path><path d="M2 12a10 10 0 0 1 18-6"></path><path d="M2 16h.01"></path><path d="M21.8 16c.2-2 .131-5.354 0-6"></path><path d="M5 19.5C5.5 18 6 15 6 12a6 6 0 0 1 .34-2"></path><path d="M8.65 22c.21-.66.45-1.32.57-2"></path><path d="M9 6.8a6 6 0 0 1 9 5.2v2"></path></svg></span><h3 class="kro-feature-card__title">A visit is not a person</h3><p class="kro-feature-card__body">Cookieless analytics: a visit is an anonymous, rotating hash, never a name or an email.</p></article></div></div></div></div></section></div></div>"`;

exports[`landing story snapshots > PrivacySection > Phone 1`] = `"<div><div data-theme="light" data-kro-idiom="mobile" data-slot="marketing-story-stage" style="width: 390px; max-width: 100%; background: var(--kro-color-back); color: var(--kro-color-fore); font-family: system-ui, sans-serif;"><section id="privacy" data-tone="glass" aria-labelledby="privacy-title" class="kro-marketing-section"><div aria-hidden="true" data-testid="detail-backdrop" class="kro-detail-backdrop"></div><div class="kro-marketing-container kro-marketing-container--wide"><div class="kro-glass kro-marketing-section__panel"><div class="text-kro-fore" style="--kro-color-fore-secondary: var(--kro-color-fore-secondary-on-glass);"><header data-align="start" data-level="2" class="kro-section-header"><p class="kro-eyebrow">Privacy</p><h2 id="privacy-title" class="kro-display-2">Your day stays yours</h2><p class="kro-lede">Kro measures how the product is used, never what you write in it.</p></header><div data-reveal="idle" class="kro-reveal grid grid-cols-1 gap-kro-large md:grid-cols-3"><article class="kro-feature-card" style="--kro-card-accent: var(--kro-color-accent);"><span class="kro-feature-card__icon" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-shield-check" aria-hidden="true"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"></path><path d="m9 12 2 2 4-4"></path></svg></span><h3 class="kro-feature-card__title">Your day stays yours</h3><p class="kro-feature-card__body">Your plans live on your device first. Sign in only if you want them to follow you to another one.</p></article><article class="kro-feature-card" style="--kro-card-accent: var(--kro-color-accent);"><span class="kro-feature-card__icon" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-eye-off" aria-hidden="true"><path d="M10.733 5.076a10.744 10.744 0 0 1 11.205 6.575 1 1 0 0 1 0 .696 10.747 10.747 0 0 1-1.444 2.49"></path><path d="M14.084 14.158a3 3 0 0 1-4.242-4.242"></path><path d="M17.479 17.499a10.75 10.75 0 0 1-15.417-5.151 1 1 0 0 1 0-.696 10.75 10.75 0 0 1 4.446-5.143"></path><path d="m2 2 20 20"></path></svg></span><h3 class="kro-feature-card__title">We never send what you write</h3><p class="kro-feature-card__body">Counts, timings, the page you are on and your browser's size and language — never the words you write.</p></article><article class="kro-feature-card" style="--kro-card-accent: var(--kro-color-accent);"><span class="kro-feature-card__icon" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-fingerprint-pattern" aria-hidden="true"><path d="M12 10a2 2 0 0 0-2 2c0 1.02-.1 2.51-.26 4"></path><path d="M14 13.12c0 2.38 0 6.38-1 8.88"></path><path d="M17.29 21.02c.12-.6.43-2.3.5-3.02"></path><path d="M2 12a10 10 0 0 1 18-6"></path><path d="M2 16h.01"></path><path d="M21.8 16c.2-2 .131-5.354 0-6"></path><path d="M5 19.5C5.5 18 6 15 6 12a6 6 0 0 1 .34-2"></path><path d="M8.65 22c.21-.66.45-1.32.57-2"></path><path d="M9 6.8a6 6 0 0 1 9 5.2v2"></path></svg></span><h3 class="kro-feature-card__title">A visit is not a person</h3><p class="kro-feature-card__body">Cookieless analytics: a visit is an anonymous, rotating hash, never a name or an email.</p></article></div></div></div></div></section></div></div>"`;
