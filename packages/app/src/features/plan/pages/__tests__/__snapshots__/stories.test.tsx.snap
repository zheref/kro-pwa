exports[`story snapshots > PlanListFragment > PointerRows 1`] = `"<div data-theme="light" data-slot="story-stage" style="display: flex; flex-direction: column; gap: var(--kro-space-medium); align-items: flex-start; padding: var(--kro-space-large); min-height: 160px; width: 100%; background: var(--kro-color-back); font-family: system-ui, sans-serif;"><div style="height: 620px; display: flex; flex-direction: column;"><section data-testid="plan-list" data-grouping="none" data-sort="time" aria-label="Plan list" class="relative flex h-full min-h-0 flex-col"><div data-testid="plan-list-scroll" class="min-h-0 flex-1 overflow-y-auto px-kro-medium" style="padding-top: 16px; padding-bottom: 102px;"><div class="flex flex-col gap-kro-tiny pb-kro-small"><div role="group" aria-label="Group by" data-testid="plan-list-grouping" class="flex items-center gap-kro-small overflow-x-auto"><span class="shrink-0 font-semibold text-xs uppercase tracking-wide" style="color: var(--kro-color-fore-secondary);">Group by</span><button type="button" aria-pressed="true" data-option="none" class="inline-flex shrink-0 items-center px-kro-small py-1 border-none text-xs outline-none focus-visible:shadow-[var(--kro-ring)]" style="border-radius: var(--kro-radius-pill); background-color: var(--kro-color-accent); color: var(--kro-color-on-accent); min-height: var(--kro-size-min-touch-target);">None</button><button type="button" aria-pressed="false" data-option="project" class="inline-flex shrink-0 items-center px-kro-small py-1 border-none text-xs outline-none focus-visible:shadow-[var(--kro-ring)]" style="border-radius: var(--kro-radius-pill); background-color: var(--kro-color-back-inner); color: var(--kro-color-fore); min-height: var(--kro-size-min-touch-target);">Project</button><button type="button" aria-pressed="false" data-option="timeOfDay" class="inline-flex shrink-0 items-center px-kro-small py-1 border-none text-xs outline-none focus-visible:shadow-[var(--kro-ring)]" style="border-radius: var(--kro-radius-pill); background-color: var(--kro-color-back-inner); color: var(--kro-color-fore); min-height: var(--kro-size-min-touch-target);">Time of day</button></div><div role="group" aria-label="Sort by" data-testid="plan-list-sort" class="flex items-center gap-kro-small overflow-x-auto"><span class="shrink-0 font-semibold text-xs uppercase tracking-wide" style="color: var(--kro-color-fore-secondary);">Sort by</span><button type="button" aria-pressed="true" data-option="time" class="inline-flex shrink-0 items-center px-kro-small py-1 border-none text-xs outline-none focus-visible:shadow-[var(--kro-ring)]" style="border-radius: var(--kro-radius-pill); background-color: var(--kro-color-accent); color: var(--kro-color-on-accent); min-height: var(--kro-size-min-touch-target);">Time</button><button type="button" aria-pressed="false" data-option="priority" class="inline-flex shrink-0 items-center px-kro-small py-1 border-none text-xs outline-none focus-visible:shadow-[var(--kro-ring)]" style="border-radius: var(--kro-radius-pill); background-color: var(--kro-color-back-inner); color: var(--kro-color-fore); min-height: var(--kro-size-min-touch-target);">Priority</button><button type="button" aria-pressed="false" data-option="title" class="inline-flex shrink-0 items-center px-kro-small py-1 border-none text-xs outline-none focus-visible:shadow-[var(--kro-ring)]" style="border-radius: var(--kro-radius-pill); background-color: var(--kro-color-back-inner); color: var(--kro-color-fore); min-height: var(--kro-size-min-touch-target);">Title</button></div></div><section data-testid="plan-list-section" data-section="allDay" aria-label="All Day" class="flex flex-col gap-kro-small pb-kro-medium"><h3 data-testid="plan-list-section-header" class="sticky top-0 z-1 m-0 flex items-center gap-kro-tiny py-kro-small font-bold text-sm uppercase tracking-wide" style="color: var(--kro-color-fore); background-color: var(--kro-color-back);">All Day</h3><ul class="m-0 flex list-none flex-col gap