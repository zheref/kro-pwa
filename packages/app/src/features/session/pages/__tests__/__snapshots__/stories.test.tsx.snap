pe="button" data-kro-session-action="end-break" class="kro-glass kro-glass--tinted flex w-full items-center justify-center gap-2 rounded-kro-surface font-semibold outline-none focus-visible:shadow-[var(--kro-ring)]" style="height: 56px; color: var(--kro-color-absolute); border-radius: var(--kro-radius-surface); --kro-glass-tint: var(--kro-color-pastry-green);"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-rotate-cw size-5" aria-hidden="true"><path d="M21 12a9 9 0 1 1-9-9c2.52 0 4.93 1 6.74 2.74L21 8"></path><path d="M21 3v5h-5"></path></svg>Start Focus Session</button></div><p class="m-0 pb-6 text-xs" style="color: color-mix(in srgb, var(--kro-color-fore) 40%, transparent);">Tap to end break and continue working</p></div></div></div></div></div>"`;

