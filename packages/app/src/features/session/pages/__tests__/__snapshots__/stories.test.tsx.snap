enter justify-center gap-2 rounded-kro-surface font-semibold outline-none focus-visible:shadow-[var(--kro-ring)]" style="height: 56px; color: var(--kro-color-absolute); border-radius: var(--kro-radius-surface); --kro-glass-tint: var(--kro-color-complete-blue);"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-check-big size-5" aria-hidden="true"><path d="M21.801 10A10 10 0 1 1 17 3.335"></path><path d="m9 11 3 3L22 4"></path></svg>Complete Task</button><div class="flex w-full" style="gap: 12px;"><button type="button" data-kro-session-action="start-new" class="kro-glass kro-glass--tinted flex flex-1 items-center justify-center gap-2 rounded-kro-card font-medium text-sm outline-none focus-visible:shadow-[var(--kro-ring)]" style="height: 48px; color: var(--kro-color-absolute); border-radius: var(--kro-radius-card); --kro-glass-tint: var(--kro-color-focus-green);"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-rotate-cw size-4" aria-hidden="true"><path d="M21 12a9 9 0 1 1-9-9c2.52 0 4.93 1 6.74 2.74L21 8"></path><path d="M21 3v5h-5"></path></svg>Start New</button></div></div><p class="m-0 pb-6 text-xs" style="color: color-mix(in srgb, var(--kro-color-fore) 40%, transparent);">What would you like to do next?</p></div></div><div data-kro-session-deck="break" data-kro-session-deck-visible="false" inert="" aria-hidden="true" class="flex min-w-0 flex-col items-center" style="grid-area: 1 / 1; min-width: 0; opacity: 0; pointer-events: none; position: absolute; top: 0px; left: 0px; right: 0px;"><div class="flex w-full min-w-0 flex-col items-center" style="gap: 24px;"><p class="m-0 font-semibold text-xl">Break Time</p><p data-kro-session-break-remaining="" class="m-0 font-medium font-mono text-base tabular-nums" style="color: color-mix(in srgb, var(--kro-color-fore) 60%, transparent);">15:00 remaining</p><div class="flex w-full flex-col px-kro-medium" style="gap: 12px;"><button type="button" data-kro-session-action="end-break" class="kro-glass kro-glass--tinted flex w-full items-center justify-center gap-2 rounded-kro-surface font-semibold outline-none focus-visible:shadow-[var(--kro-ring)]" style="height: 56px; color: var(--kro-color-absolute); border-radius: var(--kro-radius-surface); --kro-glass-tint: var(--kro-color-pastry-green);"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-rotate-cw size-5" aria-hidden="true"><path d="M21 12a9 9 0 1 1-9-9c2.52 0 4.93 1 6.74 2.74L21 8"></path><path d="M21 3v5h-5"></path></svg>Start Focus Session</button></div><p class="m-0 pb-6 text-xs" style="color: color-mix(in srgb, var(--kro-color-fore) 40%, transparent);">Tap to end break and continue working</p></div></div></div></div></div>"`;

