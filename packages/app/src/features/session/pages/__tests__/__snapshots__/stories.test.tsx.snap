exports[`SessionPill > renders the Concluded story as recorded 1`] = `"<div style="display: grid; grid-template-columns: 1fr 1fr;"><div data-theme="light" style="position: relative; height: 190px; overflow: hidden; background: linear-gradient(120deg, #5856d6 0%, #663399 40%, #b7162f 70%, #c78c00 100%); font-family: system-ui, sans-serif;"><p style="position: absolute; inset: 16px; margin: 0px; font-size: 22px; font-weight: 700; line-height: 1.2; color: rgba(255, 255, 255, 0.45); pointer-events: none;">Plan · Do · Earn · Find. Plan · Do · Earn · Find.</p><p style="position: absolute; top: 6px; left: 10px; margin: 0px; font-size: 11px; font-weight: 700; letter-spacing: 1px; text-transform: uppercase; color: rgba(255, 255, 255, 0.85);">Concluded · light</p><div aria-hidden="true" style="position: absolute; right: 12px; bottom: 60px; width: 62px; height: 62px; border-radius: 50%; background: rgba(255, 255, 255, 0.22);"></div><div data-kro-session-pill-layer="" data-kro-session-pill-visible="true" style="position: absolute; left: 20px; right: 89px; bottom: 61px; display: flex; justify-content: flex-end; opacity: 1; pointer-events: none; transition-property: opacity; transition-duration: 220ms; transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);"><div class="kro-glass flex min-w-0 max-w-full items-center overflow-hidden rounded-kro-pill" data-kro-session-pill="chrome" style="height: 62px; pointer-events: auto;"><button type="button" data-kro-session-pill-body="" aria-label="📊 Prepare slides, 00:00" title="Opens the session sheet" class="flex min-w-0 items-center gap-2.5 self-stretch pr-1.5 pl-4 text-left outline-none focus-visible:shadow-[var(--kro-ring)]"><span aria-hidden="true" class="shrink-0 text-center" style="width: 26px; font-size: 20px; line-height: 1;">📊</span><span class="min-w-0 truncate font-semibold text-kro-fore text-sm">📊 Prepare slides</span><span data-kro-session-pill-clock="" class="shrink-0 font-medium font-mono text-kro-fore text-sm tabular-nums