"<div style="width: 640px; background: linear-gradient(150deg, #221b3d 0%, #2f2350 45%, #3a1f45 100%); font-family: system-ui, sans-serif; border-radius: 20px; overflow: hidden;"><p style="margin: 0px; padding: 8px 12px 0px; font-size: 11px; font-weight: 700; letter-spacing: 1px; text-transform: uppercase; color: rgba(255, 255, 255, 0.6);">Break · inline</p><div data-theme="dark" data-kro-session-sheet="break" data-kro-session-presentation="inline" class="flex w-full flex-col text-kro-fore"><div data-kro-session-slot="header" class="flex items-center justify-between px-kro-medium pt-kro-medium"><span aria-hidden="true" style="display: inline-block; width: 44px; height: 44px;"></span><div role="group" aria-label="Session mode" aria-disabled="true" data-kro-segmented="" data-kro-density="comfortable" class="inline-flex max-w-[260px]" style="border-radius: var(--kro-radius-pill); background: color-mix(in srgb, var(--kro-color-fore) 10%, transparent); opacity: 0.5; pointer-events: none;"><button type="button" aria-pressed="true" disabled="" data-kro-segment="selected" class="inline-flex items-center justify-center gap-1 font-medium outline-none focus-visible:shadow-[var(--kro-ring)] text-sm" style="padding: 8px 16px; min-height: var(--kro-size-min-pointer-target); border-radius: var(--kro-radius-pill); color: var(--kro-color-back); background: var(--kro-color-fore);"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-timer size-3" aria-hidden="true"><line x1="10" x2="14" y1="2" y2="2"></line><line x1="12" x2="15" y1="14" y2="11"></line><circle cx="12" cy="14" r="8"></circle></svg>Pomodoro</button><button type="button" aria-pressed="false" disabled="" data-kro-segment="available" class="inline-flex items-center justify-center gap-1 font-medium outline-none focus-visible:shadow-[var(--kro-ring)] text-sm" style="padding: 8px