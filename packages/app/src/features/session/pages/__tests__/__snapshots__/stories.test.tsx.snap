oup" aria-label="Stop session" inert="" aria-hidden="true" data-kro-session-stop-menu="closed" class="kro-glass absolute bottom-[64px] left-1/2 z-10 flex w-40 -translate-x-1/2 flex-col rounded-kro-card p-1" style="opacity: 0; pointer-events: none;"><button type="button" class="rounded-kro-small px-kro-small text-left text-sm outline-none focus-visible:shadow-[var(--kro-ring)]" style="min-height: var(--kro-size-min-pointer-target); color: var(--kro-color-fore);">Finish Early</button><button type="button" class="rounded-kro-small px-kro-small text-left text-sm outline-none focus-visible:shadow-[var(--kro-ring)]" style="min-height: var(--kro-size-min-pointer-target); color: var(--kro-color-kro-red);">Abort</button></div></div></div><p class="m-0 pb-6 text-sm" style="color: color-mix(in srgb, var(--kro-color-fore) 50%, transparent);">Session in progress</p></div></div><div data-kro-session-deck="concluded" data-kro-session-deck-visible="false" inert="" aria-hidden="true" class="flex min-w-0 flex-col items-center" style="grid-area: 1 / 1; min-width: 0; opacity: 0; pointer-events: none; position: absolute; top: 0px; left: 0px; right: 0px;"><div class="flex w-full min-w-0 flex-col items-center" style="gap: 24px;"><p class="m-0 font-semibold text-xl">Session Completed!</p><p data-kro-session-concluded-total="" class="m-0 font-medium font-mono text-base tabular-nums" style="color: color-mix(in srgb, var(--kro-color-fore) 60%, transparent);">10:00 focused</p><div class="flex w-full flex-col px-kro-medium" style="gap: 12px;" data-kro-session-conclusion-actions=""><button type="button" data-kro-session-action="complete" class="kro-glass kro-glass--tinted flex w-full items-center justify-center gap-2 rounded-kro-surface font-semibold outline-none focus-visible:shadow-[var(--kro-ring)]" style="height: 56px; color: var(--kro-color-absolute); border-radius: var(--kro-radius-surface); --kro-glass-tint: var(--kro-color-complete-blue);"><svg xmlns="http://www.w3.org/2000/svg" width="2