eft kro-motion-quick transition-[background-color,box-shadow] outline-none focus-visible:shadow-[var(--kro-ring)] items-start justify-start" style="border-radius: var(--kro-radius-card); background-color: color-mix(in srgb, var(--kro-color-badge-blue) 18%, transparent); box-shadow: inset 0 0 0 2px var(--kro-color-badge-blue); color: var(--kro-color-badge-blue);"><span class="flex w-full items-center"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-calendar" aria-hidden="true"><path d="M8 2v3"></path><path d="M16 2v3"></path><rect x="3" y="3" width="18" height="18" rx="2"></rect><path d="M3 9h18"></path></svg><span class="flex-1"></span><svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-check" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="m16 9-5.5 5.5L8 12"></path></svg></span><span class="font-semibold text-base">Schedule</span><span class="text-xs" style="color: var(--kro-color-fore-secondary);">Important · Not Urgent</span></button></div></div><div class="flex items-stretch gap-3"><span aria-hidden="true" class="flex w-[22px] shrink-0 items-center justify-center"><span class="whitespace-nowrap font-bold text-[11px] uppercase tracking-wide" style="color: var(--kro-color-fore-secondary); writing-mode: vertical-rl; transform: rotate(180deg);">Not important</span></span><div class="grid flex-1 grid-cols-2 gap-3"><button type="button" data-testid="triage-quadrant-delegate" aria-pressed="false" aria-label="Delegate — Urgent · Not Important" class="flex min-h-[110px] w-full flex-col gap-1.5 p-3.5 text-left kro-motion-quick transition-[background-color,box-shadow] outline-none focus-visible:shadow-[var(--kro-ring)] items-center justify-center"