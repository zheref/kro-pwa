quired, level 1" data-testid="triage-effort-step-1" class="inline-flex size-9 items-center justify-center rounded-kro-small kro-motion-quick transition-[opacity,transform] text-[22px] leading-none outline-none focus-visible:shadow-[var(--kro-ring)]" style="opacity: 1; transform: scale(1.12);"><span aria-hidden="true">🔥</span></button><button type="button" aria-pressed="false" aria-label="Effort required, level 2" data-testid="triage-effort-step-2" class="inline-flex size-9 items-center justify-center rounded-kro-small kro-motion-quick transition-[opacity,transform] text-[22px] leading-none outline-none focus-visible:shadow-[var(--kro-ring)]" style="opacity: 0.25;"><span aria-hidden="true">🔥</span></button><button type="button" aria-pressed="false" aria-label="Effort required, level 3" data-testid="triage-effort-step-3" class="inline-flex size-9 items-center justify-center rounded-kro-small kro-motion-quick transition-[opacity,transform] text-[22px] leading-none outline-none focus-visible:shadow-[var(--kro-ring)]" style="opacity: 0.25;"><span aria-hidden="true">🔥</span></button><button type="button" aria-pressed="false" aria-label="Effort required, level 4" data-testid="triage-effort-step-4" class="inline-flex size-9 items-center justify-center rounded-kro-small kro-motion-quick transition-[opacity,transform] text-[22px] leading-none outline-none focus-visible:shadow-[var(--kro-ring)]" style="opacity: 0.25;"><span aria-hidden="true">🔥</span></button><button type="button" aria-pressed="false" aria-label="Effort required, level 5" data-testid="triage-effort-step-5" class="inline-flex size-9 items-center justify-center rounded-kro-small kro-motion-quick transition-[opacity,transform] text-[22px] leading-none outline-none focus-visible:shadow-[var(--kro-ring)]" style="opacity: 0.25;"><span aria-hidden="true">🔥</span></button></div></div></section></div><div data-testid="triage-action-row" class="pointer-events-none absolute inset-x-0 bottom-0 flex flex-col gap-2 pb-3.5 p