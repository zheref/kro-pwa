exports[`story snapshots > TriageCarouselPage > OpenedOnUnscheduledTask 1`] = `"<div data-theme="light" style="min-height: 640px; background: var(--kro-color-back); font-family: system-ui, sans-serif;"><div style="position: relative; width: 390px; height: 720px; overflow: hidden; border: 1px solid var(--kro-color-hairline); border-radius: var(--kro-radius-surface); background: var(--kro-color-back);"><div data-testid="triage-carousel" data-kro-dragging="false" role="group" aria-label="Triage" class="absolute inset-0 z-10 flex flex-col overflow-hidden kro-motion-standard transition-transform" style="transform: translateX(0px); background-color: var(--kro-color-back);"><span aria-hidden="true" data-testid="triage-edge-strip" class="pointer-events-none absolute inset-y-0 left-0" style="width: 72px;"></span><div data-testid="triage-form" class="relative flex h-full min-h-0 w-full flex-col"><header class="flex shrink-0 items-center gap-3 pt-4 pb-3 px-5"><button type="button" aria-label="Back" data-testid="triage-back" class="inline-flex shrink-0 items-center justify-center rounded-kro-field outline-none focus-visible:shadow-[var(--kro-ring)]" style="width: var(--kro-size-min-touch-target); height: var(--kro-size-min-touch-target); color: var(--kro-color-fore);"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-left" aria-hidden="true"><path d="m15 18-6-6 6-6"></path></svg></button><span aria-hidden="true" class="shrink-0 text-[28px] leading-none">📋</span><div class="flex min-w-0 flex-col gap-1"><p class="m-0 font-semibold text-sm" style="color: var(--kro-color-fore-secondary);">Triage</p><h2 class="m-0 line-clamp-2 font-semibold text-lg" style="color: var(--kro-color-fore);">Draft Q3 product plan</h2></div><span class="flex-1"></span><div data-testid="triage-reward-badge" aria-label="Reward: 10 points" class="flex