exports[`story snapshots > TriageCarouselFragment > PresentedDark 1`] = `"<div data-theme="dark" style="min-height: 640px; background: var(--kro-color-back); font-family: system-ui, sans-serif;"><div style="position: relative; width: 390px; height: 720px; overflow: hidden; border: 1px solid var(--kro-color-hairline); border-radius: var(--kro-radius-surface);"><div style="display: flex; flex-direction: column; gap: 12px; padding: 20px; height: 100%; background: var(--kro-color-back);"><p style="margin: 0px; font-size: 20px; font-weight: 700;">Inbox</p><div style="padding: 12px; border-radius: var(--kro-radius-card); background: var(--kro-color-back-inner);">Draft Q3 product plan</div><div style="padding: 12px; border-radius: var(--kro-radius-card); background: var(--kro-color-back-inner);">Call the letting agent</div><div style="padding: 12px; border-radius: var(--kro-radius-card); background: var(--kro-color-back-inner);">Renew the domain</div></div><div data-testid="triage-carousel" data-kro-dragging="false" role="group" aria-label="Triage" class="absolute inset-0 z-10 flex flex-col overflow-hidden kro-motion-standard transition-transform" style="transform: translateX(0px); background-color: var(--kro-color-back);"><span aria-hidden="true" data-testid="triage-edge-strip" class="pointer-events-none absolute inset-y-0 left-0" style="width: 72px;"></span><div data-testid="triage-form" class="relative flex h-full min-h-0 w-full flex-col"><header class="flex shrink-0 items-center gap-3 pt-4 pb-3 px-5"><button type="button" aria-label="Back" data-testid="triage-back" class="inline-flex shrink-0 items-center justify-center rounded-kro-field outline-none focus-visible:shadow-[var(--kro-ring)]" style="width: var(--kro-size-min-touch-target); height: var(--kro-size-min-touch-target); color: var(--kro-color-fore);"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-left" aria-hidden="true"><path d="m15 18-6-6 6-6"></path></svg></button><span aria-hidden="true" class="shrink-0 text-[28px] leading-none">📌</span><div class="flex min-w-0 flex-col gap-1"><p class="m-0 font-semibold text-sm" style="color: var(--kro-color-fore-secondary);">Triage</p><h2 class="m-0 line-clamp-2 font-semibold text-lg" style="color: var(--kro-color-fore);">Draft Q3 product plan</h2></div><span class="flex-1"></span><div data-testid="triage-reward-badge" aria-label="Reward: 10 points" class="flex shrink-0 flex-col items-center gap-0.5"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-star" aria-hidden="true" style="color: var(--kro-color-reward-yellow);"><path d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z"></path></svg><span class="font-bold text-lg tabular-nums" style="color: var(--kro-color-fore);">10</span></div></header><div class="flex min-h-0 flex-1 flex-col gap-6 overflow-y-auto pt-4 pb-40"><div data-testid="triage-reward-stepper" class="flex items-center gap-4 px-5"><p class="m-0 font-semibold text-sm" style="color: var(--kro-color-fore-secondary);">Reward points</p><span class="flex-1"></span><div class="flex items-center" style="border-radius: var(--kro-radius-field); background-color: var(--kro-color-back-inner); box-shadow: inset 0 0 0 1px var(--kro-color-hairline);"><button type="button" aria-label="Decrease reward points" class="inline-flex items-center justify-center rounded-kro-field outline-none focus-visible:shadow-[var(--kr