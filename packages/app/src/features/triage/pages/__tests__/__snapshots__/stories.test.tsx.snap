h d="M5 12h14"></path><path d="M12 5v14"></path></svg></button></div><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-star" aria-hidden="true" style="color: var(--kro-color-reward-yellow);"><path d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z"></path></svg></div><section class="flex flex-col gap-2" aria-label="How long will it take?"><div class="px-5"><p class="m-0 font-semibold text-sm" style="color: var(--kro-color-fore-secondary);">How long will it take?</p></div><div data-testid="triage-duration-chips" role="group" aria-label="Duration" class="flex gap-2 overflow-x-auto px-5"><button type="button" aria-pressed="false" class="inline-flex shrink-0 items-center gap-1.5 rounded-kro-pill px-3.5 font-semibold text-sm kro-motion-quick transition-[background-color,color] outline-none focus-visible:shadow-[var(--kro-ring)]" style="min-height: var(--kro-size-min-touch-target); background-color: var(--kro-color-back-inner); color: var(--kro-color-fore); box-shadow: inset 0 0 0 1px var(--kro-color-hairline);">A minute</button><button type="button" aria-pressed="false" class="inline-flex shrink-0 items-center gap-1.5 rounded-kro-pill px-3.5 font-semibold text-sm kro-motion-quick transition-[background-color,color] outline-none focus-visible:shadow-[var(--kro-ring)]" style="min-height: var(--kro-size-min-touch-target); background-color: var(--kro-color-back-inner); color: var(--kro-color-fore); box-shadow: inset 0 0 0 1px var(--kro-color-hairline);">5 min</button><button type="button" aria-pressed="false" class