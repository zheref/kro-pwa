(--kro-color-back-inner); color: var(--kro-color-fore); box-shadow: inset 0 0 0 1px var(--kro-color-hairline);">90 min</button><button type="button" aria-pressed="false" class="inline-flex shrink-0 items-center gap-1.5 rounded-kro-pill px-3.5 font-semibold text-sm kro-motion-quick transition-[background-color,color] outline-none focus-visible:shadow-[var(--kro-ring)]" style="min-height: var(--kro-size-min-touch-target); background-color: var(--kro-color-back-inner); color: var(--kro-color-fore); box-shadow: inset 0 0 0 1px var(--kro-color-hairline);">2 hours</button><button type="button" aria-pressed="false" class="inline-flex shrink-0 items-center gap-1.5 rounded-kro-pill px-3.5 font-semibold text-sm kro-motion-quick transition-[background-color,color] outline-none focus-visible:shadow-[var(--kro-ring)]" style="min-height: var(--kro-size-min-touch-target); background-color: var(--kro-color-back-inner); color: var(--kro-color-fore); box-shadow: inset 0 0 0 1px var(--kro-color-hairline);">3 hours</button></div></section><section class="flex flex-col gap-2 px-5" aria-label="Where does it belong?"><p class="m-0 font-semibold text-sm" style="color: var(--kro-color-fore-secondary);">Where does it belong?</p><div aria-hidden="true" class="flex gap-3 pl-[22px]"><span class="flex-1 text-center font-bold text-[11px] uppercase tracking-wide" style="color: var(--kro-color-fore-secondary);">Urgent</span><span class="flex-1 text-center font-bold text-[11px] uppercase tracking-wide" style="color: var(--kro-color-fore-secondary);">Not urgent</span></div><div role="group" aria-label="Eisenhower matrix" data-testid="triage-matrix" class="flex flex-col gap-3"><div class="flex items-stretch gap-3"><span aria-hidden="true" class="flex w-[22px] shrink-0 items-center justify-center"><span class="whitespace-nowrap font-bold text-[11px] uppercase tracking-wide" style="color: var(--kro-color-fore-secondary); writing-mode: vertical-rl; transform: rotate(180deg);">Important</span></span><div 