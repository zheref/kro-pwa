 required, level 1" data-testid="triage-effort-step-1" class="inline-flex size-9 items-center justify-center rounded-kro-small kro-motion-quick transition-[opacity,transform] text-[22px] leading-none outline-none focus-visible:shadow-[var(--kro-ring)]" style="opacity: 1; transform: scale(1.12);"><span aria-hidden="true">🔥</span></button><button type="button" aria-pressed="false" aria-label="Effort required, level 2" data-testid="triage-effort-step-2" class="inline-flex size-9 items-center justify-center rounded-kro-small kro-motion-quick transition-[opacity,transform] text-[22px] leading-none outline-none focus-visible:shadow-[var(--kro-ring)]" style="opacity: 0.25;"><span aria-hidden="true">🔥</span></button><button type="button" aria-pressed="false" aria-label="Effort required, level 3" data-testid="triage-effort-step-3" class="inline-flex size-9 items-center justify-center rounded-kro-small kro-motion-quick transition-[opacity,transform] text-[22px] leading-none outline-none focus-visible:shadow-[var(--kro-ring)]" style="opacity: 0.25;"><span aria-hidden="true">🔥</span></button><button type="button" aria-pressed="false" aria-label="Effort required, level 4" data-testid="triage-effort-step-4" class="inline-flex size-9 items-center justify-center rounded-kro-small kro-motion-quick transition-[opacity,transform] text-[22px] leading-none outline-none focus-visible:shadow-[var(--kro-ring)]" style="opacity: 0.25;"><span aria-hidden="true">🔥</span></button><button type="button" aria-pressed="false" aria-label="Effort required, level 5" data-testid="triage-effort-step-5" class="inline-flex size-9 items-center justify-center rounded-kro-small kro-motion-quick transition-[opacity,transform] text-[22px] leading-none outline-none focus-visible:shadow-[var(--kro-ring)]" style="opacity: 0.25;"><span aria-hidden="true">🔥</span></button></div></div></section></div><div data-testid="triage-action-row" class="pointer-events-none absolute inset-x-0 bottom-0 flex flex-col gap-2 pb-3.5 px-5"><p id="triage-blocked-reason" data-testid="triage-blocked-reason" aria-live="polite" class="pointer-events-auto m-0 rounded-kro-small px-2 py-1 text-sm" style="color: var(--kro-color-fore); background-color: var(--kro-color-back-inner);">Pick a quadrant to complete this triage.</p><div class="pointer-events-auto flex items-center gap-3"><button type="button" data-testid="triage-confirm" disabled="" aria-label="Complete Triage, unavailable" aria-describedby="triage-blocked-reason" class="inline-flex flex-1 items-center justify-center gap-2 rounded-kro-field font-semibold text-base kro-motion-quick transition-[background-color,color] outline-none focus-visible:shadow-[var(--kro-ring)]" style="min-height: var(--kro-size-min-touch-target); background-color: var(--kro-color-back-inner); color: var(--kro-color-fore-secondary);">Complete Triage</button></div></div></div></div></div></div>"`;

exports[`story snapshots > TriageFormFragment > ArchivePicked 1`] = `"<div data-theme="light" style="min-height: 640px; background: var(--kro-color-back); font-family: system-ui, sans-serif;"><div style="height: 720px;"><div data-testid="triage-form" class="relative flex h-full min-h-0 w-full flex-col"><header class="flex shrink-0 items-center gap-3 pt-4 pb-3 px-5"><button type="button" aria-label="Back" data-testid="triage-back" class="inline-flex shrink-0 items-center justify-center rounded-kro-field outline-none focus-visible:shadow-[var(--kro-ring)]" style="width: var(--kro-size-min-touch-target); height: var(--kro-size-min-touch-target); color: var(--kro-color-fore);"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-left" aria-hidden="true"><path d="m15 18-6-6 6-6"></path></svg></button><span aria-hidden="true" class="shrink-0 text-[28px] leading-none">📌</span><div class="flex min-w-0 flex-col gap-1"><p class="m-0 font-semibold text-sm" style="color: var(--kro-color-fore-secondary);">Triage</p><h2 class="m-0 line-clamp-2 font-semibold text-lg" style="color: var(--kro-color-fore);">Draft Q3 product plan</h2></div><span class="flex-1"></span><div data-testid="triage-reward-badge" aria-label="Reward: 10 points" class="flex shrink-0 flex-col items-center gap-0.5"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-star" aria-hidden="true" style="color: var(--kro-color-reward-yellow);"><path d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z"></path></svg><span class="font-bold text-lg tabular-nums" style="color: var(--kro-color-fore);">10</span></div></header><div class="flex min-h-0 flex-1 flex-col gap-6 overflow-y-auto pt-4 pb-40"><div data-testid="triage-reward-stepper" class="flex items-center gap-4 px-5"><p class="m-0 font-semibold text-sm" style="color: var(--kro-color-fore-secondary);">Reward points</p><span class="flex-1"></span><div class="flex items-center" style="border-radius: var(--kro-radius-field); background-color: var(--kro-color-back-inner); box-shadow: inset 0 0 0 1px var(--kro-color-hairline);"><button type="button" aria-label="Decrease reward points" class="inline-flex items-center justify-center rounded-kro-field outline-none focus-visible:shadow-[var(--kro-ring)] disabled:opacity-[var(--kro-opacity-disabled)]" style="width: var(--kro-size-min-touch-target); height: var(--kro-size-min-touch-target); color: var(--kro-color-fore);"><svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-minus" aria-hidden="true"><path d="M5 12h14"></path></svg></button><span data-testid="triage-reward-value" aria-label="10 reward points" class="min-w-9 text-center font-semibold text-base tabular-nums" style="color: var(--kro-color-fore);">10</span><button type="button" aria-label="Increase reward points" class="inline-flex items-center justify-center rounded-kro-field outline-none focus-visible:shadow-[var(--kro-ring)]" style="width: var(--kro-size-min-touch-target); height: var(--kro-size-min-touch-target); color: var(--kro-color-fore);"><svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-plus" aria-hidden="true"><path d="M5 12h14"></path><path d="M12 5v14"></path></svg></button></div><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-star" aria-hidden="true" style="color: var(--kro-color-reward-yellow);"><path d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z"></path></svg></div><section class="flex flex-col gap-2" aria-label="How long will it take?"><div class="px-5"><p class="m-0 font-semibold text-sm" style="color: var(--kro-color-fore-secondary);">How long will it take?</p></div><div data-testid="triage-duration-chips" role="group" aria-label="Duration" class="flex gap-2 overflow-x-auto px-5"><button type="button" aria-pressed="false" class="inline-flex shrink-0 items-center gap-1.5 rounded-kro-pill px-3.5 font-semibold text-sm kro-motion-quick transition-[background-color,color] outline-none focus-visible:shadow-[var(--kro-ring)]" style="min-height: var(--kro-size-min-touch-target); background-color: var(--kro-color-back-inner); color: var(--kro-color-fore); box-shadow: inset 0 0 0 1px var(--kro-color-hairline);">A minute</button><button type="button" aria-pressed="false" class="inline-flex shrink-0 items-center gap-1.5 rounded-kro-pill px-3.5 font-semibold text-sm kro-motion-quick transition-[background-color,color] outline-none focus-visible:shadow-[var(--kro-ring)]" style="min-height: var(--kro-size-min-touch-target); background-color: var(--kro-color-back-inner); color: var(--kro-color-fore); box-shadow: inset 0 0 0 1px var(--kro-color-hairline);">5 min</button><button type="button" aria-pressed="false" class="inline-flex shrink-0 items-center gap-1.5 rounded-kro-pill px-3.5 font-semibold text-sm kro-motion-quick transition-[background-color,color] outline-none focus-visible:shadow-[var(--kro-ring)]" style="min-height: var(--kro-size-min-touch-target); background-color: var(--kro-color-back-inner); color: var(--kro-color-fore); box-shadow: inset 0 0 0 1px var(--kro-color-hairline);">15 min</button><button type="button" aria-pressed="false" class="inline-flex shrink-0 items-center gap-1.5 rounded-kro-pill px-3.5 font-semibold text-sm kro-motion-quick transition-[background-color,color] outline-none focus-visible:shadow-[var(--kro-ring)]" style="min-height: var(--kro-size-min-touch-target); background-color: var(--kro-color-back-inner); color: var(--kro-color-fore); box-shadow: inset 0 0 0 1px var(--kro-color-hairline);">25 min</button><button type="button" aria-pressed="false" class="inline-flex shrink-0 items-center gap-1.5 rounded-kro-pill px-3.5 font-semibold text-sm kro-motion-quick transition-[background-color,color] outline-none focus-visible:shadow-[var(--kro-ring)]" style="min-height: var(--kro-size-min-touch-target); background-color: var(--kro-color-back-inner); color: var(--kro-color-fore); box-shadow: inset 0 0 0 1px var(--kro-color-hairline);">45 min</button><button type="button" aria-pressed="false" class="inline-flex shrink-0 items-center gap-1.5 rounded-kro-pill px-3.5 font-semibold text-sm kro-motion-quick transition-[background-color,color] outline-none focus-visible:shadow-[var(--kro-ring)]" style="min-height: var(--kro-size-min-touch-target); background-color: var(--kro-color-back-inner); color: var(--kro-color-fore); box-shadow: inset 0 0 0 1px var(--kro-color-hairline);">60 min</button><button type="button" aria-pressed="false" class="inline-flex shrink-0 items-center gap-1.5 rounded-kro-pill px-3.5 font-semibold text-sm kro-motion-quick transition-[background-color,color] outline-none focus-visible:shadow-[var(--kro-ring)]" style="min-height: var(--kro-size-min-touch-target); background-color: var(--kro-color-back-inner); color: var(--kro-color-fore); box-shadow: inset 0 0 0 1px var(--kro-color-hairline);">90 min</button><button type="button" aria-pressed="false" class="inline-flex shrink-0 items-center gap-1.5 rounded-kro-pill px-3.5 font-semibold text-sm kro-motion-quick transition-[background-color,color] outline-none focus-visible:shadow-[var(--kro-ring)]" style="min-height: var(--kro-size-min-touch-target); background-color: var(--kro-color-back-inner); color: var(--kro-color-fore); box-shadow: inset 0 0 0 1px var(--kro-color-hairline);">2 hours</button><button type="button" aria-pressed="false" class="inline-flex shrink-0 items-center gap-1.5 rounded-kro-pill px-3.5 font-semibold text-sm kro-motion-quick transition-[background-color,color] outline-none focus-visible:shadow-[var(--kro-ring)]" style="min-height: var(--kro-size-min-touch-target); background-color: var(--kro-color-back-inner); color: var(--kro-color-fore); box-shadow: inset 0 0 0 1px var(--kro-color-hairline);">3 hours</button></div></section><section class="flex flex-col gap-2 px-5" aria-label="Where does it belong?"><p class="m-0 font-semibold text-sm" style="color: var(--kro-color-fore-secondary);">Where does it belong?</p><div aria-hidden="true" class="flex gap-3 pl-[22px]"><span class="flex-1 text-center font-bold text-[11px] uppercase tracking-wide" style="color: var(--kro-color-fore-secondary);">Urgent</span><span class="flex-1 text-center font-bold text-[11px] uppercase tracking-wide" style="color: var(--kro-color-fore-secondary);">Not urgent</span></div><div role="group" aria-label="Eisenhower matrix" data-testid="triage-matrix" class="flex flex-col gap-3"><div class="flex items-stretch gap-3"><span aria-hidden="true" class="flex w-[22px] shrink-0 items-center justify-center"><span class="whitespace-nowrap font-bold text-[11px] uppercase tracking-wide" style="color: var(--kro-color-fore-secondary); writing-mode: vertical-rl; tran